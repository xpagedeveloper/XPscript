<Project>
  <PropertyGroup>
    <!-- The vulnerability service is advisory metadata. Keep offline local
         restores usable; CI retains NuGet audit and reported vulnerabilities. -->
    <NuGetAudit Condition="'$(CI)' != 'true'">false</NuGetAudit>
    <WarningsNotAsErrors>NU1900;$(WarningsNotAsErrors)</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
