Option Declare

Sub Main()
    If Application.ArgCount < 4 Then Error 5, "Archive ZIP rejection probe requires path and limits"

    Dim path As String
    Dim maxEntries As Integer
    Dim maxSize As Long
    Dim maxRatio As Double
    path = Application.Args(0)
    maxEntries = CInt(Application.Args(1))
    maxSize = CLng(Application.Args(2))
    maxRatio = CDbl(Application.Args(3))

    Dim archive As New Archive(path)
    archive.MaxEntries = maxEntries
    archive.MaxExtractSize = maxSize
    archive.MaxCompressionRatio = maxRatio
    archive.Open()

    If Application.ArgCount >= 5 Then
        Dim operationName As String
        operationName = Application.Args(4)
        If operationName = "read" Then
            Dim payload As Variant
            payload = archive.ReadBytes("payload.bin")
        End If
    End If

    Print "ARCHIVE_SECURITY_REJECT_ZIP_UNEXPECTED_SUCCESS"
End Sub
