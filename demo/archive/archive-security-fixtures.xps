Option Declare

Sub Main()
    Call ExpectOpenFailure("../../out/archive-security-fixtures/traversal.zip", 10000, 2147483647, 1000, "path traversal")
    Call ExpectOpenFailure("../../out/archive-security-fixtures/absolute-unix.zip", 10000, 2147483647, 1000, "absolute Unix path")
    Call ExpectOpenFailure("../../out/archive-security-fixtures/absolute-windows.zip", 10000, 2147483647, 1000, "absolute Windows path")
    Call ExpectOpenFailure("../../out/archive-security-fixtures/unc.zip", 10000, 2147483647, 1000, "UNC path")
    Call ExpectOpenFailure("../../out/archive-security-fixtures/symlink-entry.zip", 10000, 2147483647, 1000, "symbolic link entry")
    Call ExpectOpenFailure("../../out/archive-security-fixtures/max-entries.zip", 2, 2147483647, 1000, "MaxEntries")
    Call ExpectOpenFailure("../../out/archive-security-fixtures/max-size.zip", 10000, 100, 1000, "MaxExtractSize")
    Call ExpectOpenFailure("../../out/archive-security-fixtures/compression-ratio.zip", 10000, 2147483647, 10, "MaxCompressionRatio")

    Call ExpectExtendedOpenFailure("../../out/archive-security-fixtures/traversal.tar", "extended TAR path traversal")
    Call ExpectExtendedOpenFailure("../../out/archive-security-fixtures/absolute.tar", "extended TAR absolute path")
    Call ExpectExtendedOpenFailure("../../out/archive-security-fixtures/symlink-entry.tar", "extended TAR symbolic link entry")

    Dim duplicateArchive As New Archive("../../out/archive-security-fixtures/duplicate-names.zip")
    Dim duplicateEntry As ArchiveEntry
    Dim duplicateCount As Integer
    Set duplicateEntry = duplicateArchive.GetFirstEntry()
    While duplicateEntry Is Not Nothing
        duplicateCount = duplicateCount + 1
        If duplicateCount > 2 Then Error 5, "Archive duplicate-name iterator did not terminate"
        Set duplicateEntry = duplicateArchive.GetNextEntry(duplicateEntry)
    Wend
    If duplicateCount <> 2 Then Error 5, "Archive duplicate-name iterator did not return both entries"

    Dim output As New Archive("../../out/archive-security-fixtures/symlink-source-test.zip")
    output.Create("zip")
    output.AddFolder("../../out/archive-security-fixtures/source", "source", True)
    If Not output.Contains("source/real.txt") Then Error 5, "Archive security fixture lost the real source file"
    If output.Contains("source/link.txt") Then Error 5, "Archive.AddFolder followed a symbolic link"

    If FileExists("../../out/archive-security-fixtures/extraction-symlink-ready.txt") Then
        Call ExpectExtractionSymlinkFailure()
    End If

    Print "ARCHIVE_SECURITY_FIXTURES=OK"
End Sub

Sub ExpectExtractionSymlinkFailure()
    Dim extraction As New Archive("../../out/archive-security-fixtures/extraction-symlink.zip")
    Dim extractErr As Integer
    Dim extractMessage As String

    On Error GoTo ExtractRejected
    extraction.ExtractAll("../../out/archive-security-fixtures/extract-root")
    On Error GoTo 0
    Error 5, "Archive extraction followed a destination symbolic link"
    Exit Sub

ExtractRejected:
    extractErr = Err
    extractMessage = Error()
    On Error GoTo 0
    If extractErr = 0 Then Error 5, "Archive extraction rejection returned no error code"
    If Len(extractMessage) = 0 Then Error 5, "Archive extraction rejection returned an empty diagnostic"
    If FileExists("../../out/archive-security-fixtures/outside/escape.txt") Then Error 5, "Archive extraction escaped through a destination symbolic link"
End Sub

Sub ExpectOpenFailure(ByVal path As String, ByVal maxEntries As Integer, ByVal maxSize As Long, ByVal maxRatio As Double, ByVal label As String)
    Dim archive As New Archive(path)
    archive.MaxEntries = maxEntries
    archive.MaxExtractSize = maxSize
    archive.MaxCompressionRatio = maxRatio

    Dim openErr As Integer
    Dim openMessage As String
    On Error GoTo OpenRejected
    archive.Open()
    On Error GoTo 0
    Error 5, "Archive security fixture unexpectedly opened: " & label
    Exit Sub

OpenRejected:
    openErr = Err
    openMessage = Error()
    On Error GoTo 0
    If openErr = 0 Then Error 5, "Archive security fixture rejection returned no error code: " & label
    If Len(openMessage) = 0 Then Error 5, "Archive security fixture returned an empty diagnostic: " & label
End Sub

Sub ExpectExtendedOpenFailure(ByVal path As String, ByVal label As String)
    Dim archive As New Archive(path, True)

    Dim openErr As Integer
    Dim openMessage As String
    On Error GoTo ExtendedOpenRejected
    archive.Open()
    On Error GoTo 0
    Error 5, "Extended Archive security fixture unexpectedly opened: " & label
    Exit Sub

ExtendedOpenRejected:
    openErr = Err
    openMessage = Error()
    On Error GoTo 0
    If openErr = 0 Then Error 5, "Extended Archive security fixture rejection returned no error code: " & label
    If Len(openMessage) = 0 Then Error 5, "Extended Archive security fixture returned an empty diagnostic: " & label
End Sub
