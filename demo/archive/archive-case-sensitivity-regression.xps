Option Declare

Sub Main()
    Dim archive As New Archive()
    archive.Create("zip")

    archive.AddText("Case/File.txt", "upper")
    archive.AddText("case/file.txt", "lower")

    If archive.FileCount <> 2 Then Error 5, "Archive entry names must preserve case-distinct ZIP entries"
    If archive.ReadText("Case/File.txt") <> "upper" Then Error 5, "Archive case-sensitive lookup failed for upper-case entry"
    If archive.ReadText("case/file.txt") <> "lower" Then Error 5, "Archive case-sensitive lookup failed for lower-case entry"

    Print "ARCHIVE_CASE_SENSITIVITY=OK"
End Sub
