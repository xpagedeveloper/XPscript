Option Declare

Sub Main()
    If Application.ArgCount < 1 Then Error 5, "Archive filesystem case regression requires a target directory"

    Dim root As String
    root = Application.Args(0)

    Dim archive As New Archive()
    archive.Create("zip")
    archive.AddText("CaseName.txt", "upper")
    archive.AddText("casename.txt", "lower")

    If archive.FileCount <> 2 Then Error 5, "Archive entry names must remain case-sensitive"
    If archive.ReadText("CaseName.txt") <> "upper" Then Error 5, "Upper-case Archive entry lookup failed"
    If archive.ReadText("casename.txt") <> "lower" Then Error 5, "Lower-case Archive entry lookup failed"

    archive.ExtractAll(root)
    Print "ARCHIVE_FILESYSTEM_CASE=OK"
End Sub
