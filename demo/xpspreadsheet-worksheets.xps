Option Declare

Sub Main()
    Dim book As New XPSpreadsheet()
    Dim sales As XPWorksheet
    Dim summary As XPWorksheet
    Dim temp As XPWorksheet

    ' Add worksheets
    Set sales = book.AddWorksheet("Sales")
    Set summary = book.AddWorksheet("Summary")
    Set temp = book.AddWorksheet("Temporary")

    ' Access worksheet by name
    book.Worksheet("Sales").Cell("A1").Value = "Amount"
    book.Worksheet("Sales").Cell("A2").Value = 100
    book.Worksheet("Sales").Cell("A3").Value = 200
    book.Worksheet("Sales").Cell("A4").Value = 300

    ' Formulas are stored in the XLSX and calculated by Excel/LibreOffice
    book.Worksheet("Sales").Cell("A5").Formula = "=A2+A3"
    book.Worksheet("Sales").Cell("A6").Formula = "=SUM(A2:A4)"

    ' Access worksheet by 1-based index
    If book.Worksheet(1).Name <> "Sales" Then Error 5, "Worksheet index lookup failed"
    If book.Worksheet(2).Name <> "Summary" Then Error 5, "Worksheet index lookup failed"

    ' Remove worksheet by name
    book.RemoveWorksheet("Temporary")
    If book.WorksheetCount <> 2 Then Error 5, "Worksheet remove failed"

    summary.Cell("A1").Value = "Worksheet count"
    summary.Cell("B1").Value = book.WorksheetCount

    book.SaveAs("xpspreadsheet-worksheets.xlsx")

    ' Reopen and verify name/index access
    Dim verify As New XPSpreadsheet("xpspreadsheet-worksheets.xlsx")
    If verify.WorksheetCount <> 2 Then Error 5, "Worksheet count round-trip failed"
    If verify.Worksheet("Sales").Cell("A2").Text <> "100" Then Error 5, "Worksheet name lookup round-trip failed"
    If verify.Worksheet(1).Name <> "Sales" Then Error 5, "Worksheet index round-trip failed"

    Print "XPSPREADSHEET-WORKSHEETS=OK"
End Sub
