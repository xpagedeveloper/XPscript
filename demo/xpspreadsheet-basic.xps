Option Declare

Sub Main()
    Dim book As New XPSpreadsheet()
    Dim sales As XPWorksheet
    Dim notes As XPWorksheet
    Dim cell As XPCell

    Set sales = book.AddWorksheet("Sales")
    Set notes = book.AddWorksheet("Notes")

    sales.Cell("A1").Value = "Customer"
    sales.Cell("B1").Value = "Amount"
    sales.Cell("A2").Value = "ACME AB"
    sales.Cell("B2").Value = 12500.5
    notes.Cell("A1").Value = "Created by XPSpreadsheet"

    book.SaveAs("xpspreadsheet-basic.xlsx")

    Dim reopened As New XPSpreadsheet("xpspreadsheet-basic.xlsx")
    Dim reopenedSales As XPWorksheet
    Set reopenedSales = reopened.Worksheet("Sales")

    If reopened.WorksheetCount <> 2 Then Error 5, "XPSpreadsheet worksheet count mismatch"
    If reopenedSales.Cell("A2").Text <> "ACME AB" Then Error 5, "XPSpreadsheet text round-trip failed"

    reopenedSales.Cell("B2").Value = 15000
    reopened.RenameWorksheet("Notes", "Comments")
    reopened.Save()

    Dim verify As New XPSpreadsheet("xpspreadsheet-basic.xlsx")
    If verify.Worksheet("Comments").Cell("A1").Text <> "Created by XPSpreadsheet" Then Error 5, "XPSpreadsheet tab round-trip failed"
    Set cell = verify.Worksheet("Sales").Cell("B2")
    If CDbl(cell.Value) <> 15000 Then Error 5, "XPSpreadsheet update failed"

    Dim bytes As Variant
    bytes = verify.ToBytes()

    Dim memoryBook As New XPSpreadsheet()
    memoryBook.FromBytes(bytes)
    If memoryBook.Path <> "" Then Error 5, "XPSpreadsheet FromBytes unexpectedly assigned a file path"
    If Not memoryBook.CreatedByXPScript Then Error 5, "XPSpreadsheet FromBytes lost XPScript workbook marker"
    If memoryBook.Worksheet("Sales").Cell("A2").Text <> "ACME AB" Then Error 5, "XPSpreadsheet byte round-trip failed"

    Print "XPSPREADSHEET-BASIC=OK"
End Sub
