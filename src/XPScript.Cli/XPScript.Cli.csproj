<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>xpscript</AssemblyName>
    <RootNamespace>XPScript.Cli</RootNamespace>
    <AssemblyTitle>XPScript</AssemblyTitle>
    <Product>XPScript</Product>
    <Version>0.9.1-beta</Version>
    <Copyright>(c) XPageDeveloper.com 2026</Copyright>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <UnifiedPublishDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../publish/xpscript'))</UnifiedPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="XPScriptBuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../XPScript.Compiler/XPScript.Compiler.csproj" />
    <ProjectReference Include="../XPScript.UI.Desktop/XPScript.UI.Desktop.csproj" />
    <ProjectReference Include="../XPScript.Web.Runtime/XPScript.Web.Runtime.csproj" />
    <ProjectReference Include="../XPScript.Web.Compiler/XPScript.Web.Compiler.csproj" />
    <ProjectReference Include="../XPScript.Web.Kestrel/XPScript.Web.Kestrel.csproj" />
    <ProjectReference Include="../XPScript.Web.FastCgi/XPScript.Web.FastCgi.csproj" />
  </ItemGroup>

  <Target Name="PublishUnifiedToolchainAfterBuild"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipUnifiedPublish)' != 'true'">
    <Message Importance="high" Text="Publishing unified XPscript toolchain to $(UnifiedPublishDirectory)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c &quot;$(Configuration)&quot; --no-build -p:SkipUnifiedPublish=true -o &quot;$(UnifiedPublishDirectory)&quot; --nologo" />
  </Target>
</Project>
