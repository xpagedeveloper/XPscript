<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>xpscript</AssemblyName>
    <RootNamespace>XPScript.Cli</RootNamespace>
    <AssemblyTitle>XPScript</AssemblyTitle>
    <Product>XPScript</Product>
    <Copyright>(c) xpagedeveloper.com 2026</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../XPScript.Web.Runtime/XPScript.Web.Runtime.csproj" />
    <ProjectReference Include="../XPScript.Web.Compiler/XPScript.Web.Compiler.csproj" />
    <ProjectReference Include="../XPScript.Web.Kestrel/XPScript.Web.Kestrel.csproj" />
    <ProjectReference Include="../XPScript.Web.FastCgi/XPScript.Web.FastCgi.csproj" />
  </ItemGroup>
</Project>
