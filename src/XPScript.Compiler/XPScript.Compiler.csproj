<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>xpscriptc</AssemblyName>
    <RootNamespace>XPScript.Compiler</RootNamespace>
    <AssemblyTitle>XPScript Compiler</AssemblyTitle>
    <Product>XPScript</Product>
    <!-- The compiler has transitive UI/runtime project references. Serial project
         resolution avoids an MSBuild SDK 10 parallel graph failure that otherwise
         reports no diagnostic and aborts before compilation. -->
    <BuildInParallel>false</BuildInParallel>
    <Version>0.9.3-beta</Version>
    <Copyright>(c) XPageDeveloper.com 2026</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="XPScriptBuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <Compile Include="Program.cs" />
    <ProjectReference Include="../XPScript.Compiler.Core/XPScript.Compiler.Core.csproj" />
  </ItemGroup>
</Project>
