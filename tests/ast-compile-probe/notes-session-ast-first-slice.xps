Option Declare

Sub Main()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim view As NotesView
    Dim doc As NotesDocument
    Dim docs As NotesDocumentCollection
    Dim agentResult As NotesAgentResult
    Dim noteCollection As NotesNoteCollection
    Dim access As NotesDatabaseAccess
    Dim created As NotesDateTime
    Dim modified As NotesDocumentCollection
    Dim item As NotesItem
    Set session = New NotesSession("runtime")
    Print session.UserName
    Print session.Platform
    Set db = session.OpenDatabase("", "apps\customers.nsf")
    Print db.Server
    Print db.FilePath
    Print db.FileName
    Print db.IsOpen
    Print db.ReplicaID
    Print db.Title
    Set view = db.OpenView("Customers")
    Set doc = db.GetDocumentByNoteId(1)
    Set doc = db.GetDocumentByUNID("0123456789ABCDEF0123456789ABCDEF")
    Set docs = db.Search("Form = \"Customer\"")
    Set docs = db.FullTextSearch("customer")
    Set agentResult = db.RunAgent("RefreshCustomers", doc)
    Set doc = db.CreateDocument()
    Set noteCollection = db.CreateNoteCollection(True)
    Set docs = db.AllDocuments
    Set doc = db.GetProfileDocument("Profile")
    Set created = db.Created
    Set created = db.LastModified
    Print db.FileFormat
    Set access = db.QueryAccess()
    Set modified = db.GetModifiedDocuments()
    Set docs = db.CreateDocumentCollection()
    Call db.RemoveFTIndex()
    Print doc.NoteID
    Print doc.UniversalID
    Print doc.IsNewNote
    Print doc.IsResponse
    Print doc.IsDeleted
    Print doc.IsValid
    Print doc.HasItem("Form")
    Print doc.GetValue("Form")
    Print doc.GetString("Form")
    Print doc.GetNumber("Amount")
    Set item = doc.GetFirstItem("Form")
    Set item = doc.ReplaceItemValue("Status", "Open")
    Call doc.SetString("Status", "Closed")
    Call doc.SetNumber("Amount", 10)
    Call doc.RemoveItem("Status")
End Sub
