Function CountCalls(ByVal values List As Long) As Long
    Static visits As Long
    visits = visits + 1
    CountCalls = visits
End Function

Function CountCalls(ByVal values List As String) As Long
    Static visits As Long
    visits = visits + 10
    CountCalls = visits
End Function

Sub Main()
    Dim numbers List As Long
    Dim words List As String
    Print CountCalls(numbers)
    Print CountCalls(words)
    Print CountCalls(numbers)
    Print CountCalls(words)
End Sub
