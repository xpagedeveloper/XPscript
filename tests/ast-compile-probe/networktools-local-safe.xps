Option Declare

Sub Main()
    Dim net As New NetworkTools
    Dim host As NetworkHostResult
    Dim subnet As NetworkSubnetInfo
    Set host = net.ResolveHost("localhost")
    If host.Error <> "" Then Error 1201, "ResolveHost localhost failed: " & host.Error
    If Not net.IsPrivateAddress("10.1.2.3") Then Error 1202, "Private address check failed"
    If net.IsPrivateAddress("8.8.8.8") Then Error 1203, "Public address classified as private"
    If Not net.IsLoopbackAddress("127.0.0.1") Then Error 1204, "Loopback check failed"
    If Not net.IsInSubnet("10.20.30.40", "10.20.0.0/16") Then Error 1205, "Subnet check failed"
    If net.GetAddressFamily("127.0.0.1") <> "IPv4" Then Error 1206, "IPv4 family check failed"
    If Not net.IsLinkLocalAddress("169.254.10.20") Then Error 1207, "Link-local check failed"
    If Not net.IsMulticastAddress("239.1.1.1") Then Error 1208, "Multicast check failed"
    Set subnet = net.ParseSubnet("192.168.10.42/24")
    If subnet.NetworkAddress <> "192.168.10.0" Then Error 1209, "Subnet network address mismatch"
    If Not subnet.Contains("192.168.10.200") Then Error 1210, "Subnet containment check failed"
    Print "NETWORKTOOLS_AST_SAFE_OK"
End Sub
