Public mode As Long
Public trace As String
Public seedImage As Variant
Public defaultImage As Variant
Public rootImage As Variant
Public childImage As Variant
Public escaped As Variant
Public deletes As Long
Class Root
    Public Picture As XPImage
    Public Sub New(Optional ByRef value As Long = Seed(), Optional ByVal selected As Long = DefaultValue(value))
        trace = trace & "R"
        value = value + 1
        escaped = Me
        Dim local As New XPImage(4, 3)
        Set Picture = local
        rootImage = Picture
        If selected = 1 Then Error 3941, "root failed"
    End Sub
    Public Sub Delete()
        deletes = deletes + 1
    End Sub
End Class
Class Child Extend Root
    Public Other As XPImage
    Public Sub New(Optional ByRef value As Long = Seed(), Optional ByVal selected As Long = DefaultValue(value))
        Call Parent.New(value)
        trace = trace & "C"
        value = value + 100
        Dim local As New XPImage(5, 3)
        Set Other = local
        childImage = Other
        If selected = 2 Then Error 3942, "child failed"
    End Sub
    Public Sub Delete()
        deletes = deletes + 1
    End Sub
End Class
Function Seed() As Long
    Dim local As New XPImage(2, 2)
    seedImage = local
    Seed = 1
End Function
Function DefaultValue(ByRef value As Long) As Long
    trace = trace & "D"
    value = value + 10
    Dim local As New XPImage(3, 2)
    defaultImage = local
    If mode = 3 Then Error 3943, "child default failed"
    If mode = 4 And value > 11 Then Error 3944, "base default failed"
    DefaultValue = mode
End Function
Sub AssertExpired(ByVal value As Variant)
    If value Is Nothing Then
        Exit Sub
    End If
    Dim image As XPImage = value
    Dim width As Long = -1
    Dim failure As Long
    On Error Resume Next
    width = image.Width
    failure = Err
    On Error GoTo 0
    If width <> -1 Or failure = 0 Then Error 6, "Optional ByRef image leaked"
End Sub
Sub Main()
    Dim item As New Child()
    Dim original As Child = item
    If trace <> "DDRC" Or item.Picture.Width <> 4 Or item.Other.Width <> 5 Then Error 6, "omitted image constructor failed"
    Call AssertExpired(seedImage)
    Call AssertExpired(defaultImage)
    Dim value As Long
    For mode = 1 To 4
        trace = ""
        escaped = Nothing
        rootImage = Nothing
        childImage = Nothing
        value = 1
        Dim failure As Long
        On Error Resume Next
        Set item = New Child(value)
        failure = Err
        On Error GoTo 0
        If failure <> 3940 + mode Or Not (item Is original) Or deletes <> 0 Then Error 6, "Optional ByRef error target/Delete failed"
        If mode = 1 And (value <> 22 Or trace <> "DDR") Then Error 6, "base failure lost alias"
        If mode = 2 And (value <> 122 Or trace <> "DDRC") Then Error 6, "child failure lost alias"
        If mode = 3 And (value <> 11 Or trace <> "D") Then Error 6, "child default lost alias"
        If mode = 4 And (value <> 21 Or trace <> "DD") Then Error 6, "base default lost alias"
        If mode >= 3 Then
            If Not (escaped Is Nothing) Then Error 6, "default failure entered body"
        Else
            Dim failed As Child = escaped
            If Not (failed.Picture Is Nothing) Or Not (failed.Other Is Nothing) Then Error 6, "Optional ByRef fields not cleared"
        End If
        Call AssertExpired(defaultImage)
        Call AssertExpired(rootImage)
        Call AssertExpired(childImage)
    Next
    mode = 0
    trace = ""
    Dim fresh As New Child()
    If trace <> "DDRC" Then Error 6, "failed default contaminated next call"
    Delete fresh
    Delete item
    If deletes <> 4 Then Error 6, "Optional ByRef Delete chain failed"
    Print "IMAGE_OPTIONAL_BYREF_CONSTRUCTORS_OK"
End Sub
