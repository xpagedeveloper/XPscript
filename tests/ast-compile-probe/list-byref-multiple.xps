Sub TouchPair(ByRef first As Long, ByRef second As Long)
    first = first + 10
    second = second + 20
End Sub

Sub Main()
    Dim values List As Long
    values("first") = 1
    values("second") = 2
    Call TouchPair(values("first"), values("second"))
    Print values("first")
    Print values("second")
End Sub
