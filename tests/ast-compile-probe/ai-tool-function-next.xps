Sub WeatherCallback(ByVal toolCall As Variant, ByVal tenant As Variant)
End Sub

Sub Main()
    Dim tool As New XPAITool("weather")
    Call tool.AddFunction("get_weather", "Returns weather", "WeatherCallback", "tenant-42")
    Call tool.AddParameter("get_weather", "city", "string", "City name", True)
    If tool.FunctionCount() <> 1 Then Error 5, "XPAITool function count mismatch"
    If Not tool.HasFunction("get_weather") Then Error 5, "XPAITool function lookup mismatch"
    Print "AI_TOOL_FUNCTION_OK"
End Sub
