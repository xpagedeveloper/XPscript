Sub WeatherCallback(ByVal toolCall As Variant, ByVal tenant As Variant)
End Sub

Sub Main()
    Dim tool As New AITool("weather")
    Dim fn As AIToolFunction
    Set fn = tool.AddFunction("get_weather", "Returns weather", "WeatherCallback", "tenant-42")
    If fn.Name <> "get_weather" Or fn.CallbackName <> "WeatherCallback" Then Error 5, "AITool function metadata failed"
    Call fn.AddParameter("city", "string", "City name", True)
    If Not fn.HasParameter("city") Or fn.ParameterCount() <> 1 Then Error 5, "AITool parameter registration failed"
    If Not fn.RemoveParameter("city") Or fn.ParameterCount() <> 0 Then Error 5, "AITool parameter removal failed"
    If Not tool.HasFunction("get_weather") Then Error 5, "AITool function lookup failed"
    If tool.FunctionCount() <> 1 Then Error 5, "AITool function registration failed"
    If Not tool.RemoveFunction("get_weather") Then Error 5, "AITool function removal failed"
    If tool.FunctionCount() <> 0 Then Error 5, "AITool function remained after removal"

    Dim ai As New XPAi("https://example.invalid", "key")
    Call ai.AddTool(tool)
    If Not ai.HasTool("weather") Then Error 5, "XPAi tool lookup failed"
    If ai.ToolCount() <> 1 Then Error 5, "XPAi tool registration failed"
    If Not ai.RemoveTool("weather") Then Error 5, "XPAi tool removal failed"
    If ai.ToolCount() <> 0 Then Error 5, "XPAi tool remained after removal"
    Print "AI_TOOL_LIFECYCLE_OK"
End Sub
