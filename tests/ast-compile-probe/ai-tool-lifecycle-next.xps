Sub WeatherCallback(ByVal toolCall As XPAIToolCall, ByVal tenant As Variant)
End Sub

Sub Main()
    Dim tool As New XPAITool("weather")
    Dim fn As XPAIToolFunction
    Set fn = tool.AddFunction("get_weather", "Returns weather", "WeatherCallback", "tenant-42")
    If fn.Name <> "get_weather" Or fn.CallbackName <> "WeatherCallback" Then Error 5, "XPAITool function metadata failed"
    Call fn.AddParameter("city", "string", "City name", True)
    If Not fn.HasParameter("city") Or fn.ParameterCount() <> 1 Then Error 5, "XPAITool parameter registration failed"
    If Not fn.RemoveParameter("city") Or fn.ParameterCount() <> 0 Then Error 5, "XPAITool parameter removal failed"
    If tool.GetFunction("get_weather").Name <> "get_weather" Then Error 5, "XPAITool function getter failed"
    Call tool.SetRequestProperty("tenant", "tenant-42")
    If tool.GetRequestContext().Get("tenant") <> "tenant-42" Then Error 5, "XPAITool request context failed"
    Call tool.RemoveRequestProperty("tenant")
    Call tool.ClearRequestProperties()
    If InStr(tool.ToJson(), "get_weather") = 0 Then Error 5, "XPAITool JSON metadata failed"
    If Not tool.HasFunction("get_weather") Then Error 5, "XPAITool function lookup failed"
    If tool.FunctionCount() <> 1 Then Error 5, "XPAITool function registration failed"
    If Not tool.RemoveFunction("get_weather") Then Error 5, "XPAITool function removal failed"
    If tool.FunctionCount() <> 0 Then Error 5, "XPAITool function remained after removal"

    Dim ai As New XPAi("https://example.invalid", "key")
    Call ai.NewRequest()
    Call ai.AddTool(tool)
    If Not ai.HasTool("weather") Then Error 5, "XPAi tool lookup failed"
    If ai.ToolCount() <> 1 Then Error 5, "XPAi tool registration failed"
    If Not ai.RemoveTool("weather") Then Error 5, "XPAi tool removal failed"
    If ai.ToolCount() <> 0 Then Error 5, "XPAi tool remained after removal"
    Print "AI_TOOL_LIFECYCLE_OK"
End Sub
