Option Declare

Sub Main()
    Dim form As New UIForm("All UIForm controls")
    Dim field As UIFormField
    Dim grid As Variant

    Set field = form.AddTextField("text", "Text")
    Call form.AddTextArea("area", "Area")
    Call form.AddNumberField("number", "Number")
    Call form.AddRangeField("range", "Range")
    Call form.AddSlider("slider", "Slider")
    Call form.AddCheckBox("check", "Check")
    Call form.AddSwitch("switch", "Switch")
    Call form.AddIcon("icon", "star", "Icon")
    Call form.AddCard("card", "Card")
    Call form.AddPanel("panel", "Panel")
    Call form.AddScrollView("scroll", "Scroll")
    Call form.AddDateField("date", "Date")
    Call form.AddTimeField("time", "Time")
    Call form.AddDateTimeField("datetime", "DateTime")
    Call form.AddMonthField("month", "Month")
    Call form.AddColorField("color", "Color")
    Call form.AddEmailField("email", "Email")
    Call form.AddUrlField("url", "URL")
    Call form.AddPasswordField("password", "Password")
    Call form.AddSelect("select", "Select")
    Call form.AddListBox("list", "List")
    Call form.AddListView("listview", "ListView")
    Call form.AddMultiListBox("multi", "Multi")
    Call form.AddRadioGroup("radio", "Radio")
    Call form.AddHiddenField("hidden")
    Call form.AddWebView("web", "Web")
    Call form.AddVideo("video", "Video")
    Call form.AddAudio("audio", "Audio")
    Call form.AddCarousel("carousel", "assets/one.png", "assets/two.png")
    Call form.AddProgressBar("progress", "Progress")
    Call form.AddActivityIndicator("activity", "Activity")
    Call form.AddCameraPreview("camera", "Camera")
    Call form.AddSeparator("separator")
    Call form.AddSpacer("spacer")
    Call form.AddFileField("file", "File")
    Call form.AddMultiSelect("multiselect", "MultiSelect")
    Call form.AddCheckBoxGroup("group", "Group")
    Call form.AddTelField("tel", "Tel")
    Call form.AddWeekField("week", "Week")
    Call form.AddDecimalField("decimal", "Decimal")
    Call form.AddCurrencyField("currency", "Currency", "SEK")
    Call form.AddRichTextField("rich", "Rich")

    Call form.AddOption("select", "one")
    Call form.SetRequired("text", True)
    Call form.SetLength("text", 1, 100)
    Call form.SetNumberRange("number", 0, 100)
    Call form.SetSliderStep("slider", 0.25)
    Call form.SetFieldPlaceholder("text", "Enter text")
    Call form.SetFieldTooltip("text", "Text help")
    Call form.SetDateRange("date", "2020-01-01", "2030-12-31")
    Call form.SetTimeRange("time", "08:00", "18:00")
    Call form.SetDateTimeRange("datetime", "2026-01-01T08:00", "2026-12-31T18:00")
    Call form.SetMonthRange("month", "2026-01", "2026-12")
    Call form.SetFileOptions("file", "image/*", 1000000, False)
    Set grid = form.AddGridColumns(12)
    Call grid.SetFieldPosition("text", 6)
    Call grid.AddNewRow()
    Call form.AddButton("save", "Save", "SaveForm")
    Call form.AddButtonCallback("callback", "Callback", "CallbackForm")
    Print "AST_UIFORM_CONTROLS_OK"
End Sub

Sub SaveForm()
End Sub

Sub CallbackForm()
End Sub
