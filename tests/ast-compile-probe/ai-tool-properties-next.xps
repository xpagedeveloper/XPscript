Sub Main()
    Dim tool As New XPAITool("weather")
    tool.Description = "Weather information"
    tool.Timeout = 12
    If tool.Name <> "weather" Then Error 5, "XPAITool name mismatch"
    If tool.Description <> "Weather information" Then Error 5, "XPAITool description mismatch"
    If tool.Timeout <> 12 Then Error 5, "XPAITool timeout mismatch"
    Print "AI_TOOL_PROPERTIES_OK"
End Sub
