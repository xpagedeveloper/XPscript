Class Base
    Public Function Value(Optional ByVal amount As Long = 2) As Long
        Value = amount + 1
    End Function
End Class

Class Child Extend Base
    Public Function Value(Optional ByVal amount As Long = 2) As Long
        Value = amount + 10
    End Function
End Class

Class Caller
    Public Function Read(ByVal item As Base) As Long
        Read = item.Value()
    End Function
End Class

Sub Main()
    Dim item As New Child
    Dim caller As New Caller
    If caller.Read(item) <> 12 Then Error 6, "derived optional method dispatch failed"
    Print "CLASS_OPTIONAL_METHOD_VIRTUAL_DISPATCH_OK"
End Sub
