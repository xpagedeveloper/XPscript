Option Declare

Class NotesDatabaseMethods
    Public Function Accept(ByVal session As NotesSession, ByVal database As NotesDatabase) As Boolean
        Accept = (session Is Nothing) And (database Is Nothing)
    End Function
End Class

Sub Main()
    Dim methods As New NotesDatabaseMethods
    If Not methods.Accept(Nothing, Nothing) Then Error 4266
    Print "AST_NOTES_DATABASE_CLASS_METHOD_OK"
End Sub
