Class Base
    Public Property Get Value As Long
        Value = 0
    End Property

    Public Property Let Value(ByVal incoming As Long)
    End Property
End Class

Class Child Extend Base
    Public stored As Long

    Public Property Get Value As Long
        Value = stored
    End Property

    Public Property Let Value(ByVal incoming As Long)
        stored = incoming + 3
    End Property
End Class

Class Caller
    Public Sub SetValue(ByVal item As Base)
        item.Value = 10
    End Sub
End Class

Sub Main()
    Dim item As New Child
    Dim caller As New Caller
    Call caller.SetValue(item)
    If item.stored <> 13 Or item.Value <> 13 Then Error 6, "derived scalar property setter dispatch failed"
    Print "CLASS_PROPERTY_SETTER_DISPATCH_OK"
End Sub
