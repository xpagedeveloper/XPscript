Sub Main()
    Dim ai As New XPAi(Environ("XPSCRIPT_AI_TEST_AI"), "XPAI_SECRET_MARKER")
    Dim response As XPAiResponse
    Set response = ai.Complete()
    If response.StatusCode <> 200 Then Error 5, "XPAi response status mismatch"
    If Not response.IsSuccess Then Error 5, "XPAi response marked unsuccessful"
    If response.Text <> "hello from provider" Then Error 5, "XPAi response text mismatch"
    Print "XPAI_REQUEST_SUCCESS_OK"
End Sub
