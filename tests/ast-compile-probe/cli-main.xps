Sub Main()
    Dim result As Long
    result = AddOne(41)
    Call Increase(result)
    Print result
    Call AstPrint()
    Dim message As String
    message = "AST_XPS_PRINT_OK"
    Print message
    If message = "AST_XPS_PRINT_OK" Then
        Print "AST_XPS_IF_OK"
    End If
    Dim i As Long
    For i = 1 To 2
        Print i
    Next
    While i < 4
        i = i + 1
        Print i
    Wend
    Do
        i = i + 1
    Loop While i < 6
    Select Case i
        Case 6
            Print "AST_XPS_SELECT_OK"
        Case Else
            Print "AST_XPS_SELECT_FAIL"
    End Select
    Dim item As Variant
    ForAll item In Array(7, 8)
        Print item
    End ForAll
    Exit Sub
End Sub

Function AddOne(ByVal value As Long) As Long
    Dim message As Long
    message = value + 1
    AddOne = message
End Function

Sub Increase(ByRef value As Long)
    value = value + 1
End Sub
