Sub Main()
    Dim message As String
    message = "AST_XPS_PRINT_OK"
    Print message
    If message = "AST_XPS_PRINT_OK" Then
        Print "AST_XPS_IF_OK"
    End If
    Dim i As Long
    For i = 1 To 2
        Print i
    Next
    While i < 4
        i = i + 1
        Print i
    Wend
    Do
        i = i + 1
    Loop While i < 6
    Select Case i
        Case 6
            Print "AST_XPS_SELECT_OK"
        Case Else
            Print "AST_XPS_SELECT_FAIL"
    End Select
    Exit Sub
End Sub
