Sub Main()
    If Accumulate(3) = 7 And DefaultNumber() = 0 And Factorial(4) = 24 Then
        Print "AST_FUNCTION_RESULT_OK"
    End If
    Dim result As Long
    result = AddOne(41)
    Call Increase(result)
    Print result
    Call AstPrint()
    Dim message As String
    message = "AST_XPS_PRINT_OK"
    Print message
    If message = "AST_XPS_PRINT_OK" Then
        Print "AST_XPS_IF_OK"
    End If
    Dim i As Long
    For i = 1 To 2
        Print i
    Next
    While i < 4
        i = i + 1
        Print i
    Wend
    Do
        i = i + 1
    Loop While i < 6
    Select Case i
        Case 6
            Print "AST_XPS_SELECT_OK"
        Case Else
            Print "AST_XPS_SELECT_FAIL"
    End Select
    Dim item As Variant
    ForAll item In Array(7, 8)
        Print item
    End ForAll
    Exit Sub
End Sub

Function Accumulate(ByVal count As Long) As Long
    Dim __xpsFunctionResult As Long
    __xpsFunctionResult = 1
    Accumulate = __xpsFunctionResult
    Dim i As Long
    For i = 1 To count
        Accumulate = Accumulate + i
    Next
    Exit Function
End Function

Function DefaultNumber() As Long
End Function

Function Factorial(ByVal value As Long) As Long
    If value <= 1 Then
        Factorial = 1
    Else
        Factorial = value * Factorial(value - 1)
    End If
End Function

Function AddOne(ByVal value As Long) As Long
    Dim message As Long
    message = value + 1
    AddOne = message
End Function

Sub Increase(ByRef value As Long)
    value = value + 1
End Sub
