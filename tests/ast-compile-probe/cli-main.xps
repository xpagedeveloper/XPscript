Sub Main()
    Dim optionalValue As Long
    optionalValue = 10
    Call OptionalIncrease(optionalValue)
    Dim explicitDefault As Long
    explicitDefault = 8
    Dim fullSum As Long
    fullSum = OptionalSum(4, explicitDefault)
    If OptionalSum() = 5 And OptionalSum(4) = 7 And OptionalSum() = 5 And optionalValue = 12 And fullSum = 12 And explicitDefault = 12 And OptionalText() = "Hello" And OptionalZero() = 0 And OptionalCollision(4) = 7 Then
        Print "AST_OPTIONAL_CALL_OK"
    End If
    If Accumulate(3) = 7 And DefaultNumber() = 0 And Factorial(4) = 24 Then
        Print "AST_FUNCTION_RESULT_OK"
    End If
    Dim result As Long
    result = AddOne(41)
    Call Increase(result)
    Print result
    Call AstPrint()
    Dim message As String
    message = "AST_XPS_PRINT_OK"
    Print message
    If message = "AST_XPS_PRINT_OK" Then
        Print "AST_XPS_IF_OK"
    End If
    Dim i As Long
    For i = 1 To 2
        Print i
    Next
    While i < 4
        i = i + 1
        Print i
    Wend
    Do
        i = i + 1
    Loop While i < 6
    Select Case i
        Case 6
            Print "AST_XPS_SELECT_OK"
        Case Else
            Print "AST_XPS_SELECT_FAIL"
    End Select
    Dim item As Variant
    ForAll item In Array(7, 8)
        Print item
    End ForAll
    Exit Sub
End Sub

Function OptionalText(Optional ByVal text As String = "Hello") As String
    OptionalText = text
End Function

Function OptionalZero(Optional ByRef value As Long) As Long
    OptionalZero = value
End Function

Function OptionalCollision(ByVal firstValue As Long, Optional ByRef other As Long = 3) As Long
    OptionalCollision = firstValue + other
End Function

Function OptionalSum(Optional ByVal first As Long = 2, Optional ByRef second As Long = 3) As Long
    second = second + first
    OptionalSum = second
End Function

Sub OptionalIncrease(ByRef value As Long, Optional ByRef increment As Long = 2)
    value = value + increment
End Sub

Function Accumulate(ByVal count As Long) As Long
    Dim functionResult As Long
    functionResult = 1
    Accumulate = functionResult
    Dim i As Long
    For i = 1 To count
        Accumulate = Accumulate + i
    Next
    Exit Function
End Function

Function DefaultNumber() As Long
End Function

Function Factorial(ByVal value As Long) As Long
    If value <= 1 Then
        Factorial = 1
    Else
        Factorial = value * Factorial(value - 1)
    End If
End Function

Function AddOne(ByVal value As Long) As Long
    Dim message As Long
    message = value + 1
    AddOne = message
End Function

Sub Increase(ByRef value As Long)
    value = value + 1
End Sub
