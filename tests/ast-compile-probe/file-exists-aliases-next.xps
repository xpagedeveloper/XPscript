Option Explicit

Sub Main()
    If Not FileExists("tests/ast-compile-probe/file-exists-aliases-next.xps") Then Error 9860, "FileExists alias failed"
    If Not DirExists("tests/ast-compile-probe") Then Error 9861, "DirExists alias failed"
    If Not IsDir("C:") Then Error 9862, "IsDir drive designator failed"
    If Not DirExists("C:") Then Error 9863, "DirExists drive designator failed"
    Print "FILE_EXISTS_ALIASES_AST_OK"
End Sub
