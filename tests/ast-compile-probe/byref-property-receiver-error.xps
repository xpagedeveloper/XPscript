Class Box
    Public Property Get Value As Long
        Value = 1
    End Property

    Public Property Let Value(ByVal incoming As Long)
    End Property
End Class

Function GetBox() As Box
    Set GetBox = New Box
End Function

Sub Increment(ByRef value As Long)
    value = value + 1
End Sub

Sub Main()
    Call Increment(GetBox().Value)
End Sub
