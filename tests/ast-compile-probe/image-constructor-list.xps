Public escaped As Variant
Public destructorCalls As Long
Class ListOwner
    Private picture As XPImage
    Public Stored As Variant
    Public Borrowed As Variant
    Public Sub New(ByRef values List As XPImage, Optional ByVal fail As Boolean = False)
        escaped = Me
        Borrowed = values("source")
        Set picture = values("source")
        Stored = picture
        Dim replacement List As XPImage
        Set replacement("source") = values("source")
        Set values = replacement
        If fail Then Error 4320, "List image constructor failed"
    End Sub
    Public Sub Delete()
        destructorCalls = destructorCalls + 1
    End Sub
End Class
Class Child Extend ListOwner
    Public Sub New(ByVal values List As XPImage, Optional ByVal fail As Boolean = False)
        Parent.New(values, fail)
    End Sub
End Class
Sub AssertExpired(ByVal value As Variant)
    Dim picture As XPImage = value
    If picture Is Nothing Then Error 4327, "missing cleanup observation"
    Dim width As Long = -1
    Dim failure As Long
    On Error Resume Next
    width = picture.Width
    failure = Err
    On Error GoTo 0
    If width <> -1 Or failure = 0 Then Error 4321
End Sub
Sub Main()
    Dim source As New XPImage(4, 3)
    Dim values List As XPImage
    Set values("source") = source
    Dim original List As XPImage = values
    Dim item As New ListOwner(values)
    If values Is original Or Not (item.Borrowed Is source) Or source.Width <> 4 Then Error 4322
    Dim old As ListOwner = item
    Dim previous List As XPImage = values
    Dim failure As Long
    On Error Resume Next
    Set item = New ListOwner(values, True)
    failure = Err
    On Error GoTo 0
    If failure <> 4320 Or Not (item Is old) Or values Is previous Then Error 4323
    Dim failed As ListOwner = escaped
    Call AssertExpired(failed.Stored)
    If source.Width <> 4 Or Not (failed.Borrowed Is source) Or destructorCalls <> 0 Then Error 4324
    Dim childOriginal List As XPImage = values
    Dim child As New Child(values)
    If Not (values Is childOriginal) Or Not (child.Borrowed Is source) Then Error 4325
    Dim stored As Variant = item.Stored
    Delete item
    Call AssertExpired(stored)
    Delete child
    If source.Width <> 4 Or destructorCalls <> 2 Then Error 4326
    Print "IMAGE_LIST_CONSTRUCTORS_OK"
End Sub
