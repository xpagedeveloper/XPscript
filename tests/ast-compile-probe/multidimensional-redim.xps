Sub Main()
    Dim values() As Long
    ReDim values(1 To 2, 3 To 4)
    values(1, 3) = 11
    values(2, 4) = 22
    Print LBound(values, 1)
    Print UBound(values, 2)
    ReDim Preserve values(1 To 2, 3 To 5)
    Print values(1, 3)
    Print values(2, 4)
    Print LBound(values, 1)
    Print UBound(values, 2)
End Sub
