Public trace As String

Class Root
    Public Sub New()
        trace = trace & "R"
    End Sub

    Public Sub Delete()
        trace = trace & "D"
    End Sub
End Class

Class Child Extend Root
    Public Sub New()
        Call Parent.New()
        trace = trace & "C"
        Error 4711, "child constructor failed"
    End Sub
End Class

Sub Main()
    Dim target As New Root
    trace = ""
    Dim failure As Long
    On Error Resume Next
    Set target = New Child
    failure = Err
    On Error GoTo 0
    If failure <> 4711 Then Error 4712, "constructor error was lost"
    If trace <> "RC" Then Error 4713, "failed construction invoked user Delete"
    If target Is Nothing Then Error 4714, "failed construction replaced caller target"
    Print "CLASS_DERIVED_CONSTRUCTOR_FAILURE_OK"
End Sub
