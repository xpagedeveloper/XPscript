Sub Main()
    Dim drive As String
    drive = Left(CurDir(), 1) & ":"
    If Not IsDir(drive) Then Error 6341, "IsDir did not recognize the current Windows drive designator"
    If Not DirExists(drive) Then Error 6342, "DirExists did not recognize the current Windows drive designator"
    Print "ISDIR_DRIVE_OK"
End Sub
