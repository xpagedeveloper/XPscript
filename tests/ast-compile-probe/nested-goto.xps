Sub Main()
    Dim n As Integer
    n = 0
    While n < 2
        GoTo increment
        Print "wrong"
increment:
        n = n + 1
    Wend
    Do
        GoTo decrement
        Print "wrong"
decrement:
        n = n - 1
    Loop Until n = 0
    Select Case n
    Case 0
        GoTo selected
    Case Else
        Print "wrong"
    End Select
selected:
    Print n
    Print "NESTED_GOTO_OK"
End Sub
