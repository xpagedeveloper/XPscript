Sub Main()
    Dim matrix(1, 1) As Long
    matrix(0, 0) = 7
    matrix(1, 1) = matrix(0, 0) + 5
    Print matrix(1, 1)
    Print LBound(matrix, 2)
    Print UBound(matrix, 2)
    Erase matrix
    Print matrix(1, 1)
    Dim offset(1 To 2, 3 To 4) As Long
    offset(1, 3) = 9
    Print offset(1, 3)
    Print LBound(offset, 1)
    Print UBound(offset, 1)
    Print LBound(offset, 2)
    Print UBound(offset, 2)
    Erase offset
    Print offset(1, 3)
    Dim texts(1, 1) As String
    texts(1, 1) = "TEXT_OK"
    Print texts(1, 1)
    Dim doubles(1, 1) As Double
    doubles(0, 1) = 2.5
    Print doubles(0, 1)
    Dim flags(1, 1) As Boolean
    flags(1, 0) = True
    Print flags(1, 0)
    Erase texts
    Print texts(1, 1)
End Sub
