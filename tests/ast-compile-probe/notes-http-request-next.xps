Option Declare

Sub Main()
    Dim http As New NotesHTTPRequest
    http.PreferStrings = True
    Dim result As Variant
    Dim blocked As New NotesHTTPRequest
    Dim failure As Long
    On Error Resume Next
    Set result = blocked.Get(Environ("XPSCRIPT_NOTES_HTTP_TEST_URL"))
    failure = Err
    On Error GoTo 0
    If failure <> 5 Then Error 4264
    http.AllowPrivateNetwork = True
    Set result = http.Get(Environ("XPSCRIPT_NOTES_HTTP_TEST_URL"))
    If http.ResponseCode <> 200 Then Error 4265
    If CStr(result) <> "notes-http-ok" Then Error 4266
    Set result = http.Post(Environ("XPSCRIPT_NOTES_HTTP_TEST_URL"), "notes-http-request")
    If http.ResponseCode <> 200 Then Error 4267
    If CStr(result) <> "notes-http-ok" Then Error 4268
    Dim responseHeaders As Variant
    responseHeaders = http.GetResponseHeaders()
    If UBound(responseHeaders) < 0 Then Error 4270
    http.PreferStrings = True
    http.MaxRedirects = 0
    Set result = http.Get(Environ("XPSCRIPT_NOTES_REDIRECT_TEST_URL"))
    If http.ResponseCode <> 302 Then Error 4271
    http.MaxRedirects = 1
    Set result = http.Get(Environ("XPSCRIPT_NOTES_REDIRECT_TEST_URL"))
    If http.ResponseCode <> 200 Or CStr(result) <> "GET|" Then Error 4272, CStr(result)
    http.MaxRedirects = 0
    Set result = http.Put(Environ("XPSCRIPT_HTTP_TEST_HTTP") & "/methods", "put-body")
    If http.ResponseCode <> 200 Or CStr(result) <> "PUT||put-body" Then Error 4273
    Set result = http.Patch(Environ("XPSCRIPT_HTTP_TEST_HTTP") & "/methods", "patch-body")
    If http.ResponseCode <> 200 Or CStr(result) <> "PATCH||patch-body" Then Error 4274
    Set result = http.DeleteResource(Environ("XPSCRIPT_HTTP_TEST_HTTP") & "/methods")
    If http.ResponseCode <> 200 Or CStr(result) <> "DELETE|" Then Error 4275
    Print "NOTES_HTTP_REQUEST_OK"
End Sub
