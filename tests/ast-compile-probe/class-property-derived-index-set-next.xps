Class Base
    Public value As Long
End Class

Class Child Extend Base
    Public Property Get Item(ByVal index As Long) As Long
        Item = value + index
    End Property

    Public Property Let Item(ByVal index As Long, ByVal incoming As Long)
        value = incoming + index
    End Property
End Class

Sub Main()
    Dim item As New Child
    item.value = 4
    item.Item(3) = 10
    Print CStr(item.Item(0))
End Sub
