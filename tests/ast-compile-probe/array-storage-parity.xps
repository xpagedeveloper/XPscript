Sub Main()
    Dim values(-3 To -1) As Long
    values(-3) = 7
    Dim shared As Variant
    shared = values
    If LBound(shared) <> -3 Then
        Error 5, "Unexpected lower bound"
    End If
    If UBound(shared) <> -1 Then
        Error 5, "Unexpected upper bound"
    End If
    Print "-3"
    Print "-1"
    Print shared(-3)
    Dim text(2 To 3) As String
    text(2) = "changed"
    Erase text
    If text(2) <> "" Then
        Error 5, "Erase did not clear String storage"
    End If
    Print "ARRAY_STORAGE_PARITY_OK"
End Sub
