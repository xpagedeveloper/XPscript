Option Declare

Sub Main()
    Dim utf8(0 To 8) As Byte
    Dim utf16(0 To 17) As Byte
    Dim doc As XPXmlDocument

    utf8(0) = 60
    utf8(1) = 114
    utf8(2) = 62
    utf8(3) = 195
    utf8(4) = 165
    utf8(5) = 60
    utf8(6) = 47
    utf8(7) = 114
    utf8(8) = 62
    Set doc = XmlParse(utf8)
    If doc.Root.Name <> "r" Or doc.Root.Value <> "å" Then Error 9973, "UTF-8 XML bytes failed"

    utf16(0) = 255
    utf16(1) = 254
    utf16(2) = 60
    utf16(3) = 0
    utf16(4) = 114
    utf16(5) = 0
    utf16(6) = 62
    utf16(7) = 0
    utf16(8) = 229
    utf16(9) = 0
    utf16(10) = 60
    utf16(11) = 0
    utf16(12) = 47
    utf16(13) = 0
    utf16(14) = 114
    utf16(15) = 0
    utf16(16) = 62
    utf16(17) = 0
    Set doc = XmlParse(utf16)
    If doc.Root.Name <> "r" Or doc.Root.Value <> "å" Then Error 9974, "UTF-16 XML bytes failed"
    Print "XML_CHARSET_AST_OK"
End Sub
