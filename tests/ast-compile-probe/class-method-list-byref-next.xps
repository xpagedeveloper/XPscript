Class Writer
    Public Sub Update(ByRef values List As Long)
        values("updated") = values("value") + 6
        Dim replacement List As Long
        replacement("replacement") = 21
        values = replacement
    End Sub
End Class

Sub Main()
    Dim values List As Long
    values("value") = 4
    Dim writer As New Writer
    Call writer.Update(values)
    Print CStr(values("replacement"))
End Sub
