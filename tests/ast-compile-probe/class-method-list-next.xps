Class Reader
    Public Function Read(ByVal values List As Long) As Long
        values("updated") = values("value") + 5
        Read = values("updated")
    End Function
End Class

Sub Main()
    Dim values List As Long
    values("value") = 3
    Dim reader As New Reader
    Print CStr(reader.Read(values))
    Print CStr(values("updated"))
End Sub
