' Windows bootstrap for XPScript Android development.
' Uses ShellExecute so command completion, stdout, stderr and exit codes are explicit.

Sub Main()
    If Platform() <> "Windows" Then
        Print "This setup utility currently supports Windows only."
        Exit Sub
    End If

    Dim verifyOnly As Boolean
    If Command() = "--verify" Or Command() = "verify" Then
        verifyOnly = True
    Else
        verifyOnly = False
    End If

    Print "XPScript Android Development Setup"
    Print "=================================="

    If verifyOnly Then
        Print "Verification mode: no software will be installed."
        If RunCommand("dotnet", Array("--version"))=false Then
            Print "[ERROR] .NET SDK was not found."
            Exit Sub
        End If
    Else
        Print "[CHECK] Checking whether .NET 10 SDK is already installed..."
        If RunCommand("dotnet", Array("--version"))=true Then
            Print "[OK] A .NET SDK is already installed. Skipping .NET SDK winget installation."
        Else
            Print "[INFO] .NET SDK was not found. It will be installed."
        End If

        If RunCommand("where.exe", Array("winget"))=false Then
            Print "[ERROR] winget was not found. Install App Installer before continuing."
            Exit Sub
        End If

        If RunCommand("dotnet", Array("--version"))=false Then
            Print ""
            Print "[INSTALL] Installing .NET 10 SDK with winget."
            Print "[INSTALL] winget may download packages and can take several minutes."
            Print "[INSTALL] Waiting for winget to finish..."
            If RunWinget(Array("install", "--id", "Microsoft.DotNet.SDK.10", "--exact", "--accept-package-agreements", "--accept-source-agreements"))=false Then
                Print "[ERROR] .NET 10 SDK installation failed."
                Exit Sub
            End If
            Print "[OK] .NET 10 SDK winget command completed."
        End If
        Print ""
        Print "[CHECK] Checking whether Android Studio is already installed..."
        If WingetPackageInstalled("Google.AndroidStudio")=true Then
            Print "[OK] Android Studio is already installed. Skipping installation."
        Else
            Print "[INSTALL] Android Studio was not found. Installing with winget."
            Print "[INSTALL] This is a large package and may take several minutes."
            Print "[INSTALL] Waiting for winget to finish..."
            If RunWinget(Array("install", "--id", "Google.AndroidStudio", "--exact", "--accept-package-agreements", "--accept-source-agreements"))=false Then
                Print "[ERROR] Android Studio installation failed."
                Exit Sub
            End If
            Print "[OK] Android Studio winget command completed."
        End If
        Print ""
        Print "[CHECK] Checking whether the .NET Android workload is already installed..."
        If AndroidWorkloadInstalled()=true Then
            Print "[OK] .NET Android workload is already installed. Skipping installation."
        Else
            Print "[INSTALL] Android workload was not found. Installing it now."
            Print "[INSTALL] This may download Android/.NET components and can take several minutes."
            If RunCommand("dotnet", Array("workload", "install", "android"))=false Then
                Print "[ERROR] .NET Android workload installation failed."
                Exit Sub
            End If
            Print "[OK] .NET Android workload installation completed."
        End If
    End If

    Print "[OK] Installation commands completed."
    Print ""
    Print "[VERIFY] Checking installed .NET workloads..."
    If RunCommand("dotnet", Array("workload", "list"))=false Then
        Print "[ERROR] Could not verify installed .NET workloads."
        Exit Sub
    End If

    Dim sdk As String
    sdk = Environ("ANDROID_HOME")
    If sdk = "" Then sdk = Environ("ANDROID_SDK_ROOT")
    If sdk = "" Then sdk = Environ("LOCALAPPDATA") & "\Android\Sdk"

    Print "[VERIFY] Android SDK candidate: " & sdk
    If IsDir(sdk)=false Then
        Print "[WARN] Android SDK directory was not found: " & sdk
        Print "Open Android Studio SDK Manager and install an Android SDK."
        Exit Sub
    End If
    Print "[OK] Android SDK directory found."

    Dim adb As String
    adb = sdk & "\platform-tools\adb.exe"

    If IsFile(adb)=false Then
        Print "[WARN] adb.exe was not found: " & adb
        Print "Open Android Studio SDK Manager and install Android SDK Platform-Tools."
        Exit Sub
    End If

    Print "[OK] adb found."
    Print "[VERIFY] Checking attached Android devices and device properties..."

    If RunCommand(adb, Array("devices"))=false Then Exit Sub
    If RunCommand(adb, Array("shell", "getprop", "ro.product.model"))=false Then Exit Sub
    If RunCommand(adb, Array("shell", "getprop", "ro.build.version.release"))=false Then Exit Sub
    If RunCommand(adb, Array("shell", "getprop", "ro.build.version.sdk"))=false Then Exit Sub
    If RunCommand(adb, Array("shell", "getprop", "ro.product.cpu.abi"))=false Then Exit Sub

    Print "[OK] Android device checks completed."
    Print "If the device is unauthorized, unlock it and approve USB debugging."
End Sub

Function RunCommand(executable As String, arguments As Variant) As Boolean
    Dim commandResult As Variant

    Print ""
    Print "> " & executable
    Print "[RUN] Starting command and waiting for it to complete..."

    On Error Resume Next
    commandResult = ShellExecute(executable, arguments)
    If Err <> 0 Then
        Print "[ERROR] Could not start " & executable & ". Runtime error " & CStr(Err) & "."
        RunCommand = False
        Exit Function
    End If

    If commandResult.Output <> "" Then Print commandResult.Output
    If commandResult.Error <> "" Then Print commandResult.Error

    If commandResult.TimedOut Then
        Print "[ERROR] Command timed out."
        RunCommand = False
        Exit Function
    End If

    If commandResult.ExitCode <> 0 Then
        Print "[ERROR] Command failed with exit code " & CStr(commandResult.ExitCode) & "."
        RunCommand = False
        Exit Function
    End If

    Print "[OK] Command completed with exit code 0."
    RunCommand = True
End Function


Function WingetPackageInstalled(packageId As String) As Boolean
    Dim checkResult As Variant
    Dim wingetArgs As Variant
    wingetArgs = Array("/d", "/s", "/c", "winget", "list", "--id", packageId, "--exact", "--accept-source-agreements")

    On Error Resume Next
    checkResult = ShellExecute("cmd.exe", wingetArgs)
    If Err <> 0 Then
        WingetPackageInstalled = False
        Exit Function
    End If

    If checkResult.ExitCode = 0 And InStr(checkResult.Output, packageId) > 0 Then
        WingetPackageInstalled = True
    Else
        WingetPackageInstalled = False
    End If
End Function

Function RunWinget(arguments As Variant) As Boolean
    Dim commandArgs As Variant
    Dim index As Integer

    Print "[INFO] winget is an App Execution Alias on some Windows installations."
    Print "[INFO] Running winget through cmd.exe so the Windows alias is resolved correctly."

    commandArgs = Array("/d", "/s", "/c", "winget")
    For index = 0 To UBound(arguments)
        Dim Preserve commandArgs(UBound(commandArgs) + 1)
        commandArgs(UBound(commandArgs)) = arguments(index)
    Next index

    If RunCommand("cmd.exe", commandArgs)=true Then
        RunWinget = True
    Else
        RunWinget = False
    End If
End Function

Function AndroidWorkloadInstalled() As Boolean
    Dim checkResult As Variant
    On Error Resume Next
    checkResult = ShellExecute("dotnet", Array("workload", "list"))
    If Err <> 0 Then
        AndroidWorkloadInstalled = False
        Exit Function
    End If
    If checkResult.ExitCode = 0 And InStr(checkResult.Output, "android") > 0 Then
        AndroidWorkloadInstalled = True
    Else
        AndroidWorkloadInstalled = False
    End If
End Function
