Option Declare

Class TestObject
End Class

Sub Main()
    Dim a As String, b As String, c As Integer, d As Long, rate As Double, enabled As Boolean, obj As TestObject, doc As NotesDocument
    Dim emptyValue As Variant, normalizedNothing As Variant

    a = "alpha"
    b = "beta"
    c = 42
    d = 2147483648
    rate = 12.5
    enabled = True

    If a <> "alpha" Then
        Error 5, "String a type/value mismatch"
    End If
    If b <> "beta" Then
        Error 5, "String b type/value mismatch"
    End If
    If c <> 42 Then
        Error 5, "Integer type/value mismatch"
    End If
    If d <> 2147483648 Then
        Error 5, "Long type/value mismatch"
    End If
    If rate <> 12.5 Then
        Error 5, "Double type/value mismatch"
    End If
    If Not enabled Then
        Error 5, "Boolean type/value mismatch"
    End If

    If IsNull(emptyValue) Then
        Error 5, "Empty Variant must not be Null"
    End If
    Print "EMPTY_ISNULL=FALSE"

    If obj Is Nothing Then
        Print "CLASS_NOTHING=OK"
    Else
        Error 5, "New object reference should initially be Nothing"
    End If

    Print obj
    Print obj; Spc(1); "FORMATTED_NOTHING=OK"

    If CStr(obj) <> "" Then
        Error 5, "Object Nothing must behave as an empty string in string operations"
    End If
    Print "CLASS_NOTHING_STRING=EMPTY"

    If IsArray(obj) Then
        Error 5, "Object Nothing must not be reported as an array"
    End If
    Print "CLASS_NOTHING_ISARRAY=FALSE"

    If LBound(obj) <> 0 Or UBound(obj) <> 0 Then
        Error 5, "Array bounds must treat Nothing as one empty entry"
    End If

    normalizedNothing = ArrayUnique(obj)
    If LBound(normalizedNothing) <> 0 Or UBound(normalizedNothing) <> 0 Then
        Error 5, "Array operations must normalize Nothing to one array entry"
    End If
    If normalizedNothing(0) <> "" Then
        Error 5, "The array entry normalized from Nothing must be empty"
    End If
    Print "CLASS_NOTHING_ARRAY_ENTRY=EMPTY"

    If IsNull(obj) Then
        Print "CLASS_NOTHING_ISNULL=OK"
    Else
        Error 5, "IsNull must return True for object Nothing"
    End If

    Set obj = New TestObject()

    If obj Is Not Nothing Then
        Print "CLASS_IS_NOT_NOTHING=OK"
    Else
        Error 5, "Object reference should not be Nothing after New"
    End If

    If IsNull(obj) Then
        Error 5, "Bound object must not be Null"
    End If

    If Not obj Is Nothing Then
        Print "CLASS_NOT_IS_NOTHING=OK"
    Else
        Error 5, "Not obj Is Nothing should be true"
    End If

    If doc Is Nothing Then
        Print "EXTERNAL_NOTHING=OK"
    Else
        Error 5, "External object reference should initially be Nothing"
    End If

    Print doc

    If IsNull(doc) Then
        Print "NOTES_NOTHING_ISNULL=OK"
    Else
        Error 5, "IsNull must return True for Notes object Nothing"
    End If

    If doc Is Not Nothing Then
        Error 5, "External object unexpectedly non-Nothing"
    End If

    If Not doc Is Nothing Then
        Error 5, "Not doc Is Nothing unexpectedly true"
    End If

    Print "GENERAL_DIM_IS_NOTHING=OK"
End Sub
