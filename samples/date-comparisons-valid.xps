Sub Main()
    Dim startDate As Date
    Dim endDate As Date
    Dim serial As Double
    Dim textDate As String
    Dim flexible As Variant

    startDate = DateNumber(2026, 1, 1)
    endDate = DateNumber(2026, 1, 2)
    serial = CDbl(endDate)
    textDate = "2026-01-03"
    flexible = endDate

    If endDate > startDate Then Print "date-date ok"
    If endDate >= serial Then Print "date-numeric ok"
    If endDate < textDate Then Print "date-string ok"
    If startDate <= flexible Then Print "date-variant ok"
End Sub
