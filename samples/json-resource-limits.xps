Option Declare

' JSON resource-limit and rollback regression sample.

Sub Main()
    Dim huge As String
    Dim document As XPJsonDocument
    Dim obj As XPJsonObject
    Dim arr As XPJsonArray
    Dim nonFinite As Double
    Dim parsedValue As Variant
    Dim errCode As Integer
    Dim errText As String

    ' Parser input > 8 MiB UTF-8 must fail with bounded error 5.
    huge = "{""data"":""" & String(8388609, "A") & """}"
    On Error Resume Next
    Set document = XPJsonDocument.Parse(huge)
    errCode = Err
    On Error GoTo 0
    Print "PARSE_SIZE_ERR=" & CStr(errCode)

    ' More than 64 nested containers must fail.
    huge = String(65, "[") & "0" & String(65, "]")
    On Error Resume Next
    Set document = XPJsonDocument.Parse(huge)
    errCode = Err
    On Error GoTo 0
    Print "DEPTH_ERR=" & CStr(errCode)

    ' More than 100000 graph nodes must fail.
    huge = Replace(String(100001, "x"), "x", "0,")
    huge = "[" & Left(huge, Len(huge) - 1) & "]"
    On Error Resume Next
    Set document = XPJsonDocument.Parse(huge)
    errCode = Err
    On Error GoTo 0
    Print "NODE_COUNT_ERR=" & CStr(errCode)

    ' XPJsonObject.Set must reject an over-budget value and restore the old value.
    Set obj = New XPJsonObject
    Call obj.Set("payload", "safe")
    huge = String(16777217, "B")
    On Error Resume Next
    Call obj.Set("payload", huge)
    errCode = Err
    On Error GoTo 0
    Print "OBJECT_PAYLOAD_ERR=" & CStr(errCode)
    Print "OBJECT_ROLLBACK=" & CStr(obj.Get("payload"))

    ' XPJsonArray.Add must roll back a rejected over-budget append.
    Set arr = New XPJsonArray
    Call arr.Add("safe")
    On Error Resume Next
    Call arr.Add(huge)
    errCode = Err
    On Error GoTo 0
    Print "ARRAY_ADD_PAYLOAD_ERR=" & CStr(errCode)
    Print "ARRAY_ADD_COUNT=" & CStr(arr.Count)

    ' XPJsonArray.Set must restore the previous element after a rejected mutation.
    On Error Resume Next
    Call arr.Set(0, huge)
    errCode = Err
    On Error GoTo 0
    Print "ARRAY_SET_PAYLOAD_ERR=" & CStr(errCode)
    Print "ARRAY_SET_VALUE=" & CStr(arr.Get(0))

    ' Estimated payload can remain within 16 MiB while JSON syntax pushes the
    ' serialized UTF-8 output over 16 MiB. Stringify must still reject it.
    Set obj = New XPJsonObject
    huge = String(16777210, "C")
    Call obj.Set("x", huge)
    On Error Resume Next
    huge = obj.Stringify()
    errCode = Err
    On Error GoTo 0
    Print "STRINGIFY_SIZE_ERR=" & CStr(errCode)

    ' Non-finite floating point values are not valid JSON numbers.
    nonFinite = CDbl("NaN")
    Set obj = New XPJsonObject
    On Error Resume Next
    Call obj.Set("number", nonFinite)
    errCode = Err
    On Error GoTo 0
    Print "NONFINITE_ERR=" & CStr(errCode)

    ' A syntactically valid JSON exponent that overflows Double must also be
    ' rejected when the parsed numeric value is materialized.
    Set document = XPJsonDocument.Parse("{""number"":1e400}")
    Set obj = document.Root.AsObject()
    On Error Resume Next
    parsedValue = obj.Get("number")
    errCode = Err
    On Error GoTo 0
    Print "PARSED_NONFINITE_ERR=" & CStr(errCode)

    ' Malformed JSON diagnostics must remain bounded and must not echo payload.
    On Error Resume Next
    Set document = XPJsonDocument.Parse("{""secret"":""DO_NOT_ECHO""")
    errCode = Err
    errText = Error$
    On Error GoTo 0
    Print "MALFORMED_ERR=" & CStr(errCode)
    Print "MALFORMED_TEXT=" & errText

    Print "JSON_RESOURCE_LIMITS=OK"
End Sub
