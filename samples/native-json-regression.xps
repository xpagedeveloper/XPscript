Option Declare

Class JsonAliasPayload
    [JsonName("api-key")]
    Public ApiKey As String
    [JsonName("end")]
    Public End_2 As String
End Class

Class JsonBoundaryPerson
    Public Id As Integer
    Private mName As String
    Private mPassword As String

    Public Property Get Name As String
        Name = "USER-" & mName
    End Property

    Public Property Let Name As String
        mName = UCase(Trim(Name))
    End Property

    Public Property Let Password As String
        mPassword = Password
    End Property
End Class

Sub Main()
    Dim document As XPJsonDocument
    Dim parsed As XPJsonDocument
    Dim decoded As XPJsonDocument
    Dim obj As XPJsonObject
    Dim arr As XPJsonArray
    Dim element As XPJsonElement
    Dim emptyValue As Variant
    Dim nullValue As Variant
    Dim missingPerson As JsonBoundaryPerson
    Dim person As JsonBoundaryPerson
    Dim aliasPayload As JsonAliasPayload
    Dim aliasRoundTrip As JsonAliasPayload
    Dim aliasDocument As XPJsonDocument

    Set document = XPJsonDocument.Parse("{""name"":""Alice"",""active"":true}")
    Print "DOCUMENT=" & document.Stringify()

    Set obj = New XPJsonObject
    Call obj.Set("name", "Fredrik")
    Call obj.Set("enabled", True)
    Print "OBJCOUNT=" & CStr(obj.Count)
    Print "OBJNAME=" & CStr(obj.Get("name"))
    Print "OBJHAS=" & CStr(obj.Contains("enabled"))
    Call obj.Remove("enabled")
    Print "OBJCOUNT2=" & CStr(obj.Count)

    Set arr = New XPJsonArray
    Call arr.Add("one")
    Call arr.Add("two")
    Call arr.Set(1, "TWO")
    Print "ARRAYCOUNT=" & CStr(arr.Count)
    Print "ARRAYVALUE=" & CStr(arr.Get(1))
    Call arr.RemoveAt(0)
    Print "ARRAYCOUNT2=" & CStr(arr.Count)
    Print "ARRAYFIRST=" & CStr(arr.Get(0))

    Set parsed = JsonParse("123")
    Set element = parsed.Root
    Print "ELEMENTTYPE=" & element.Type
    Print "ELEMENTVALUE=" & CStr(element.Value)

    Print "STRINGIFY=" & JsonStringify(obj)
    Print "ENCODE=" & JsonEncode(arr)

    Set person = New JsonBoundaryPerson
    person.Id = 7
    person.Name = " anna "
    person.Password = "do-not-serialize"
    Print "CLASSJSON=" & JsonStringify(person)

    Set aliasPayload = New JsonAliasPayload
    aliasPayload.ApiKey = "secret"
    aliasPayload.End_2 = "done"
    Print "ALIASJSON=" & JsonStringify(aliasPayload)
    Set aliasDocument = JsonParse("{""api-key"":""incoming"",""end"":""finished""}")
    Set aliasRoundTrip = New JsonAliasPayload
    Set aliasRoundTrip = aliasDocument.ToObject(aliasRoundTrip)
    Print "ALIASREAD=" & aliasRoundTrip.ApiKey & "|" & aliasRoundTrip.End_2
    Print "ALIASROUNDTRIP=" & JsonStringify(aliasRoundTrip)

    Set decoded = JsonDecode("{""ok"":true}")
    Print "DECODE=" & decoded.Stringify()

    nullValue = Null
    Set missingPerson = Nothing
    Print "EMPTYJSON=" & JsonStringify(emptyValue)
    Print "NULLJSON=" & JsonStringify(nullValue)
    Print "NOTHINGJSON=" & JsonStringify(missingPerson)
End Sub
