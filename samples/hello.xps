Option Declare

Sub Main()
    Dim name As String
    Dim i As Long
    Dim total As Long

    name = InputBox("What is your name? ")
    Print "Hello " & UCase(name)
    Print "Your name has " & CStr(Len(name)) & " characters."

    total = 0
    For i = 1 To 5
        total = total + i
    Next i

    If total = 15 Then
        Print "For loop works. Total = " & CStr(total)
    Else
        Print "Unexpected total."
    End If

    Print "Today: " & CStr(Date())
    Print "Left(name, 3): " & Left(name, 3)
End Sub
