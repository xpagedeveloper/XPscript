' (c) xpagedeveloper.com 2026

Sub Main()
    Dim rows As New JsonArray
    Dim row1 As New JsonObject
    Dim row2 As New JsonObject
    Dim row3 As New JsonObject
    Dim list As New UIListView("Customers")
    Dim result As String

    Call row1.Set("id", "1001")
    Call row1.Set("name", "Kalle")
    Call row1.Set("country", "Sweden")
    Call row1.Set("amount", 125.5)
    Call rows.Add(row1)

    Call row2.Set("id", "1002")
    Call row2.Set("name", "Anna")
    Call row2.Set("country", "Norway")
    Call row2.Set("amount", 42)
    Call rows.Add(row2)

    Call row3.Set("id", "1003")
    Call row3.Set("name", "Sven")
    Call row3.Set("country", "Sweden")
    Call row3.Set("amount", 310)
    Call rows.Add(row3)

    Call list.BindData(rows)
    Call list.AddColumn("name", "Name")
    Call list.AddColumn("country", "Country")
    Call list.AddColumn("amount", "Amount")
    Call list.SetColumnWidth("name", 220)
    Call list.SetColumnWidth("country", 160)
    Call list.SetColumnWidth("amount", 120)
    Call list.SetKeyField("id")
    Call list.SetSortable(True)
    Call list.SetFilterEnabled(True)
    Call list.SetRowAction("customer-form.xps", "id", "customerId")

    result = list.ShowDialog()
    Print "RESULT=" & result
End Sub
