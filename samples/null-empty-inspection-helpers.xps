Sub Main()
    Dim emptyValue As Variant
    Dim nullValue As Variant
    Dim emptyCopy As Variant
    Dim nullCopy As Variant
    Dim fixedValues(1) As String
    Dim managedValues As Variant

    nullValue = Null
    emptyCopy = CVar(emptyValue)
    nullCopy = CVar(nullValue)
    fixedValues(0) = "A"
    fixedValues(1) = "B"
    managedValues = Split("A,B", ",")

    Print "EMPTY_ISNUMERIC=" & CStr(IsNumeric(emptyValue))
    Print "EMPTY_ISSCALAR=" & CStr(IsScalar(emptyValue))
    Print "EMPTY_ISOBJECT=" & CStr(IsObject(emptyValue))
    Print "EMPTY_ISDATE=" & CStr(IsDate(emptyValue))
    Print "EMPTY_ISARRAY=" & CStr(IsArray(emptyValue))
    Print "EMPTY_CVAR_TYPE=" & TypeName(emptyCopy)
    Print "EMPTY_CVAR_ISEMPTY=" & CStr(IsEmpty(emptyCopy))
    Print "EMPTY_CVAR_ISNULL=" & CStr(IsNull(emptyCopy))
    Print "EMPTY_CSTR_LEN=" & CStr(Len(CStr(emptyValue)))

    Print "NULL_ISNUMERIC=" & CStr(IsNumeric(nullValue))
    Print "NULL_ISSCALAR=" & CStr(IsScalar(nullValue))
    Print "NULL_ISOBJECT=" & CStr(IsObject(nullValue))
    Print "NULL_ISDATE=" & CStr(IsDate(nullValue))
    Print "NULL_ISARRAY=" & CStr(IsArray(nullValue))
    Print "NULL_CVAR_TYPE=" & TypeName(nullCopy)
    Print "NULL_CVAR_ISEMPTY=" & CStr(IsEmpty(nullCopy))
    Print "NULL_CVAR_ISNULL=" & CStr(IsNull(nullCopy))
    Print "NULL_CSTR_LEN=" & CStr(Len(CStr(nullValue)))

    Print "LSARRAY_ISARRAY=" & CStr(IsArray(fixedValues))
    Print "LSARRAY_ISOBJECT=" & CStr(IsObject(fixedValues))
    Print "LSARRAY_TYPE=" & TypeName(fixedValues)
    Print "LSARRAY_DATATYPE=" & CStr(DataType(fixedValues))
    Print "LSARRAY_BOUNDS=" & CStr(LBound(fixedValues)) & ":" & CStr(UBound(fixedValues))
    Print "LSARRAY_FIRST=" & CStr(fixedValues(0))

    Print "MANAGED_ISARRAY=" & CStr(IsArray(managedValues))
    Print "MANAGED_ISOBJECT=" & CStr(IsObject(managedValues))
    Print "MANAGED_TYPE=" & TypeName(managedValues)
    Print "MANAGED_DATATYPE=" & CStr(DataType(managedValues))
    Print "MANAGED_BOUNDS=" & CStr(LBound(managedValues)) & ":" & CStr(UBound(managedValues))
    Print "MANAGED_FIRST=" & CStr(managedValues(0))
End Sub
