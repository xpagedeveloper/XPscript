' (c) xpagedeveloper.com 2026
' Regression coverage for postfix increment/decrement and compound assignment.

Sub Main()
    Dim counter As Integer
    Dim byteValue As Byte
    Dim longValue As Long
    Dim singleValue As Single
    Dim doubleValue As Double
    Dim currencyValue As Currency
    Dim variantValue As Variant
    Dim text As String
    Dim zero As Integer
    Dim badText As String
    Dim capturedErr As Integer

    counter = 10
    counter++
    If counter <> 11 Then Error 9901, "Integer ++ failed"
    counter--
    If counter <> 10 Then Error 9902, "Integer -- failed"

    byteValue = 10
    byteValue++
    If byteValue <> 11 Then Error 9903, "Byte ++ failed"

    longValue = 100
    longValue--
    If longValue <> 99 Then Error 9904, "Long -- failed"

    singleValue = 1.5
    singleValue++
    If singleValue <> 2.5 Then Error 9905, "Single ++ failed"

    doubleValue = 2.5
    doubleValue--
    If doubleValue <> 1.5 Then Error 9906, "Double -- failed"

    currencyValue = 10
    currencyValue++
    If currencyValue <> 11 Then Error 9907, "Currency ++ failed"

    variantValue = 20
    variantValue++
    If CInt(variantValue) <> 21 Then Error 9908, "numeric Variant ++ failed"
    variantValue--
    If CInt(variantValue) <> 20 Then Error 9909, "numeric Variant -- failed"

    counter = 10
    counter += 5
    If counter <> 15 Then Error 9910, "+= failed"
    counter -= 3
    If counter <> 12 Then Error 9911, "-= failed"
    counter *= 2
    If counter <> 24 Then Error 9912, "*= failed"
    counter /= 4
    If counter <> 6 Then Error 9913, "/= failed"
    counter \= 4
    If counter <> 1 Then Error 9914, "\= failed"

    text = "Hello"
    text &= " world"
    If text <> "Hello world" Then Error 9915, "&= failed"

    text = "value="
    text += 42
    If text <> "value=42" Then Error 9916, "String += forgiving coercion failed"

    byteValue = 255
    On Error Resume Next
    byteValue++
    capturedErr = Err
    On Error GoTo 0
    If capturedErr <> 6 Then Error 9917, "Byte ++ overflow must use error 6"

    badText = "not numeric"
    On Error Resume Next
    badText++
    capturedErr = Err
    On Error GoTo 0
    If capturedErr <> 13 Then Error 9918, "String ++ must use type mismatch error 13"

    counter = 10
    zero = 0
    On Error Resume Next
    counter /= zero
    capturedErr = Err
    On Error GoTo 0
    If capturedErr <> 11 Then Error 9919, "/= division by zero must use error 11"

    counter = 10
    On Error Resume Next
    counter \= zero
    capturedErr = Err
    On Error GoTo 0
    If capturedErr <> 11 Then Error 9920, "\= division by zero must use error 11"

    Print "INCREMENT-COMPOUND-OPERATORS=OK"
End Sub
