' Focused native Notes/Domino connectivity probe for server1/names.nsf.
Option Declare

Sub Main()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim view As NotesView
    Dim openErr As Integer

    Set session = New NotesSession()
    If session Is Nothing Then
        Print "NOTES_SERVER1_XPSCRIPT=FAIL session"
        Exit Sub
    End If

    On Error Resume Next
    Set db = session.OpenDatabase("server1", "names.nsf")
    openErr = Err
    On Error GoTo 0
    If db Is Nothing Or Not db.IsOpen Then
        Print "NOTES_SERVER1_XPSCRIPT=FAIL database err=" & CStr(openErr)
        Call session.Recycle()
        Exit Sub
    End If

    Print "NOTES_SERVER1_XPSCRIPT=OPEN"
    Print "SERVER=" & db.Server
    Print "FILEPATH=" & db.FilePath
    Print "REPLICAID=" & db.ReplicaID
    Print "ACCESSLEVEL=" & CStr(db.CurrentAccessLevel)
    Set view = db.GetView("vimpeople")
    If view Is Nothing Then
        Print "VIEW=vimpeople MISSING"
    Else
        Print "VIEW=vimpeople OK"
        Print "VIEWCOLUMNS=" & CStr(view.ColumnCount)
    End If

    Call db.Recycle()
    Call session.Recycle()
    Print "NOTES_SERVER1_XPSCRIPT=PASS"
End Sub
