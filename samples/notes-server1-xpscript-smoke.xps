' Focused native Notes/Domino connectivity probe for server1/names.nsf.
Option Declare

Sub Main()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim view As NotesView
    Dim views As Variant
    Dim firstDoc As NotesDocument
    Dim items As Variant
    Dim viewCount As Integer
    Dim itemCount As Integer
    Dim i As Integer
    Dim openErr As Integer

    Set session = New NotesSession()
    If session Is Nothing Then
        Print "NOTES_SERVER1_XPSCRIPT=FAIL session"
        Exit Sub
    End If

    On Error Resume Next
    Set db = session.OpenDatabase("server1", "names.nsf")
    openErr = Err
    On Error GoTo 0
    If db Is Nothing Or Not db.IsOpen Then
        Print "NOTES_SERVER1_XPSCRIPT=FAIL database err=" & CStr(openErr)
        Call session.Recycle()
        Exit Sub
    End If

    Print "NOTES_SERVER1_XPSCRIPT=OPEN"
    Print "SERVER=" & db.Server
    Print "FILEPATH=" & db.FilePath
    Print "REPLICAID=" & db.ReplicaID
    Print "ACCESSLEVEL=" & CStr(db.CurrentAccessLevel)
    views = db.Views
    ForAll candidate In views
        viewCount = viewCount + 1
        If view Is Nothing Then Set view = db.OpenView(candidate.Name)
        If viewCount <= 10 Then Print "AVAILABLE-VIEW=" & candidate.Name
        Call candidate.Recycle()
    End ForAll
    Print "VIEWCOUNT=" & CStr(viewCount)
    If view Is Nothing Then
        Print "VIEW=NONE"
    Else
        Print "VIEW=" & view.Name & " OK"
        Set firstDoc = view.GetFirstDocument()
        If firstDoc Is Nothing Then
            Print "VIEW-FIRST-DOCUMENT=NONE"
        Else
            items = firstDoc.Items
            For i = LBound(items) To UBound(items)
                itemCount = itemCount + 1
                If itemCount <= 10 Then Print "VIEW-FIRST-ITEM=" & items(i).Name
            Next
            Print "VIEW-FIRST-ITEM-COUNT=" & CStr(itemCount)
            Call firstDoc.Recycle()
        End If
        Call view.Recycle()
    End If

    Call db.Recycle()
    Call session.Recycle()
    Print "NOTES_SERVER1_XPSCRIPT=PASS"
End Sub
