Function BuildNested(depth As Integer) As Variant
    If depth <= 0 Then
        BuildNested = "leaf"
    Else
        BuildNested = Array(BuildNested(depth - 1))
    End If
End Function

Sub Main()
    Dim accepted As Variant
    Dim rejected As Variant
    Dim result As Variant

    ' 64 nested arrays place the scalar leaf at snapshot depth 64, which is allowed.
    accepted = BuildNested(64)
    result = Evaluate("Return 1", accepted)
    If result <> 1 Then Error 9401, "Expected depth-64 Evaluate snapshot to succeed"

    ' One additional nesting level places the leaf at depth 65 and must be rejected.
    rejected = BuildNested(65)
    On Error GoTo ExpectedDepthError
    result = Evaluate("Return 1", rejected)
    Error 9402, "Expected depth-65 Evaluate snapshot rejection"

ExpectedDepthError:
    If Err <> 5 Then Error 9403, "Expected XPScript error 5 but got " & CStr(Err)
    Print "SNAPSHOT-DEPTH-BOUNDARY=OK"
End Sub
