' Compile-time smoke for the LotusScript-compatible NotesDocument surface.
Option Declare

Sub ExerciseDocument(doc As NotesDocument, other As NotesDocument, db As NotesDatabase, item As NotesItem)
    Dim n As Long
    Dim s As String
    Dim b As Boolean
    Dim dt As NotesDateTime
    Dim responses As NotesDocumentCollection
    Dim copied As NotesDocument
    Dim copiedItem As NotesItem
    Dim allItems As Variant

    n = doc.Size
    Set responses = doc.Responses
    s = doc.UniversalID
    doc.UniversalID = s
    s = doc.NoteID
    s = doc.ParentDocumentUNID
    Set dt = doc.LastModified
    allItems = doc.Items
    b = doc.IsNewNote
    b = doc.IsResponse
    b = doc.IsDeleted
    Set dt = doc.Created

    Call doc.RemoveItem("TemporaryField")
    Call doc.RemoveFromFolder("XPscript Test")
    Call doc.MarkRead()
    Call doc.MarkUnread()
    Call doc.MakeResponse(other)
    Set copied = doc.CopyToDatabase(db)
    Call doc.CopyAllItems(other)
    Call doc.CopyAllItems(other, True)
    Set copiedItem = doc.CopyItem(item, "CopiedItem")
End Sub
