' Real Domino runtime validation for NotesDocument.ComputeWithForm.
'
' Target database: xpscript.nsf
' Requires a local HCL Notes/Domino runtime and two forms in xpscript.nsf.
'
' Required form 1: XPScriptCWFValid
'   Add an editable text field named CWFDefault.
'   Default value formula: "DEFAULT-VALUE"
'   No failing validation formulas.
'
' Required form 2: XPScriptCWFErrors
'   Add an editable text field named CWFErrorOne.
'   Input validation formula:
'       @If(CWFErrorOne = "OK"; @Success; @Failure("CWFErrorOne failed"))
'   Add an editable text field named CWFErrorTwo.
'   Input validation formula:
'       @If(CWFErrorTwo = "OK"; @Success; @Failure("CWFErrorTwo failed"))
'
' The error form deliberately leaves both fields missing. Domino should therefore
' report at least CWFErrorOne and CWFErrorTwo through CWF_ERROR_PROC.
'
' The test does not save its documents.

Option Declare

Sub Main()
    Dim NOTES_RUNTIME As String
    NOTES_RUNTIME = "C:\Program Files\HCL\Notes"

    Dim NOTES_INI As String
    NOTES_INI = ""

    Dim DATABASE_PATH As String
    DATABASE_PATH = "xpscript.nsf"

    Dim VALID_FORM As String
    VALID_FORM = "XPScriptCWFValid"

    Dim ERROR_FORM As String
    ERROR_FORM = "XPScriptCWFErrors"

    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim failures As Integer

    failures = 0

    If NOTES_INI = "" Then
        Set session = New NotesSession(NOTES_RUNTIME)
    Else
        Set session = New NotesSession(NOTES_RUNTIME, NOTES_INI)
    End If

    Set db = session.OpenDatabase("", DATABASE_PATH)
    If db Is Nothing Then
        Print "FAIL database returned Nothing: " & DATABASE_PATH
        Exit Sub
    End If
    If Not db.IsOpen Then
        Print "FAIL database is not open: " & DATABASE_PATH
        Exit Sub
    End If

    Print "COMPUTEWITHFORM-RUNTIME-BEGIN"
    Print "DATABASE=" & db.FilePath
    Print "NOTES_VERSION=" & session.NotesVersion

    failures = failures + TestRaiseErrorFalse(db, ERROR_FORM)
    failures = failures + TestNoErrorsRaiseErrorTrue(db, VALID_FORM)
    failures = failures + TestMultipleErrorsAndDedup(db, ERROR_FORM)
    failures = failures + TestArrayAssignedBeforeRaise(db, ERROR_FORM)
    failures = failures + TestDoDataTypesIgnored(db, VALID_FORM)

    If failures = 0 Then
        Print "COMPUTEWITHFORM-RUNTIME=PASS"
    Else
        Print "COMPUTEWITHFORM-RUNTIME=FAIL COUNT=" & CStr(failures)
    End If

    Call db.Recycle()
    Call session.Recycle()
End Sub

Function TestRaiseErrorFalse(ByVal db As Variant, ByVal formName As String) As Integer
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim ok As Boolean
    Dim failures As Integer

    failures = 0
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", formName)

    failedFields = "SENTINEL"
    ok = doc.ComputeWithForm(False, False, failedFields)

    If ok Then
        failures = failures + 1
        Print "FAIL raiseError=False expected validation failure"
    ElseIf failedFields Is Nothing Then
        Print "PASS raiseError=False leaves failedFields Nothing"
    Else
        failures = failures + 1
        Print "FAIL raiseError=False did not leave failedFields Nothing"
    End If

    Call doc.Recycle()
    TestRaiseErrorFalse = failures
End Function

Function TestNoErrorsRaiseErrorTrue(ByVal db As Variant, ByVal formName As String) As Integer
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim ok As Boolean
    Dim failures As Integer
    Dim errCode As Integer

    failures = 0
    errCode = 0
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", formName)

    failedFields = "SENTINEL"
    On Error Resume Next
    ok = doc.ComputeWithForm(False, True, failedFields)
    errCode = Err
    On Error GoTo 0

    If errCode <> 0 Then
        failures = failures + 1
        Print "FAIL valid form raised error " & CStr(errCode)
    ElseIf Not ok Then
        failures = failures + 1
        Print "FAIL valid form returned False"
    ElseIf failedFields Is Nothing Then
        Print "PASS raiseError=True with no errors leaves failedFields Nothing"
    Else
        failures = failures + 1
        Print "FAIL valid form did not leave failedFields Nothing"
    End If

    Call doc.Recycle()
    TestNoErrorsRaiseErrorTrue = failures
End Function

Function TestMultipleErrorsAndDedup(ByVal db As Variant, ByVal formName As String) As Integer
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim errCode As Integer
    Dim i As Integer
    Dim count As Integer
    Dim countOne As Integer
    Dim countTwo As Integer
    Dim failures As Integer

    failures = 0
    errCode = 0
    count = 0
    countOne = 0
    countTwo = 0

    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", formName)
    failedFields = "SENTINEL"

    On Error Resume Next
    Call doc.ComputeWithForm(False, True, failedFields)
    errCode = Err
    On Error GoTo 0

    If errCode = 0 Then
        failures = failures + 1
        Print "FAIL raiseError=True did not raise for invalid form"
    End If

    If failedFields Is Nothing Then
        failures = failures + 1
        Print "FAIL failedFields is Nothing after validation error"
    Else
        count = UBound(failedFields) - LBound(failedFields) + 1
        For i = LBound(failedFields) To UBound(failedFields)
            Print "FAILED-FIELD=" & CStr(failedFields(i))
            If CStr(failedFields(i)) = "CWFErrorOne" Then countOne = countOne + 1
            If CStr(failedFields(i)) = "CWFErrorTwo" Then countTwo = countTwo + 1
        Next

        If count < 2 Then
            failures = failures + 1
            Print "FAIL expected at least two failed field names"
        End If
        If countOne = 0 Then
            failures = failures + 1
            Print "FAIL CWFErrorOne missing from failedFields"
        End If
        If countTwo = 0 Then
            failures = failures + 1
            Print "FAIL CWFErrorTwo missing from failedFields"
        End If
        If countOne > 1 Or countTwo > 1 Then
            failures = failures + 1
            Print "FAIL failedFields contains duplicate field names"
        Else
            Print "PASS failedFields contains unique field names"
        End If
        If countOne = 1 And countTwo = 1 And count >= 2 Then
            Print "PASS raiseError=True returns multiple failed fields"
        End If
    End If

    Call doc.Recycle()
    TestMultipleErrorsAndDedup = failures
End Function

Function TestArrayAssignedBeforeRaise(ByVal db As Variant, ByVal formName As String) As Integer
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim errCode As Integer
    Dim failures As Integer

    failures = 0
    errCode = 0
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", formName)
    failedFields = "SENTINEL"

    On Error Resume Next
    Call doc.ComputeWithForm(False, True, failedFields)
    errCode = Err
    On Error GoTo 0

    If errCode = 0 Then
        failures = failures + 1
        Print "FAIL pre-raise test did not raise"
    ElseIf failedFields Is Nothing Then
        failures = failures + 1
        Print "FAIL failedFields was Nothing after raised validation error"
    ElseIf UBound(failedFields) >= LBound(failedFields) Then
        Print "PASS failedFields assigned before raised validation error"
    Else
        failures = failures + 1
        Print "FAIL failedFields array is empty after raised validation error"
    End If

    Call doc.Recycle()
    TestArrayAssignedBeforeRaise = failures
End Function

Function TestDoDataTypesIgnored(ByVal db As Variant, ByVal formName As String) As Integer
    Dim docFalse As NotesDocument
    Dim docTrue As NotesDocument
    Dim okFalse As Boolean
    Dim okTrue As Boolean
    Dim valueFalse As String
    Dim valueTrue As String
    Dim failures As Integer

    failures = 0

    Set docFalse = db.CreateDocument()
    Call docFalse.ReplaceItemValue("Form", formName)
    okFalse = docFalse.ComputeWithForm(False, False)
    valueFalse = docFalse.GetString("CWFDefault")

    Set docTrue = db.CreateDocument()
    Call docTrue.ReplaceItemValue("Form", formName)
    okTrue = docTrue.ComputeWithForm(True, False)
    valueTrue = docTrue.GetString("CWFDefault")

    If okFalse <> okTrue Then
        failures = failures + 1
        Print "FAIL doDataTypes changed ComputeWithForm return value"
    ElseIf valueFalse <> valueTrue Then
        failures = failures + 1
        Print "FAIL doDataTypes changed default-formula result"
    ElseIf valueFalse <> "DEFAULT-VALUE" Then
        failures = failures + 1
        Print "FAIL valid form default formula did not execute"
    Else
        Print "PASS doDataTypes=True and False have identical behavior"
    End If

    Call docTrue.Recycle()
    Call docFalse.Recycle()
    TestDoDataTypesIgnored = failures
End Function
