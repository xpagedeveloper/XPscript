' Full HCL Notes/Domino runtime validation suite for XPscript Notes objects.
'
' Target database: xpscript.nsf
' Import samples/xpscript-notes-runtime-fixture.dxl into xpscript.nsf before running.
' The fixture creates the forms, view, agent and deterministic documents used below.
'
' The suite exercises every currently exposed Notes object family in XPscript:
' NotesSession, NotesDatabase, NotesView, NotesDocumentCollection, NotesDocument,
' NotesItem, NotesRichTextItem, NotesName, NotesDateTime and NotesAgentResult.
'
' Tests create temporary notes and remove them before completion where supported.
' Database metadata writes are restored immediately. RemoveFTIndex is exercised last.

Option Declare

Sub Main()
    Const NOTES_RUNTIME = "C:\Program Files\HCL\Notes"
    Const NOTES_INI = ""
    Const DATABASE_PATH = "xpscript.nsf"
    Const TEST_VIEW = "XPScriptTestView"
    Const TEST_AGENT = "XPScriptTestAgent"
    Const VALID_FORM = "XPScriptCWFValid"
    Const ERROR_FORM = "XPScriptCWFErrors"

    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim failures As Integer

    failures = 0

    If NOTES_INI = "" Then
        Set session = New NotesSession(NOTES_RUNTIME)
    Else
        Set session = New NotesSession(NOTES_RUNTIME, NOTES_INI)
    End If

    Set db = session.OpenDatabase("", DATABASE_PATH)
    If db Is Nothing Then
        Print "FAIL database returned Nothing: " & DATABASE_PATH
        Call session.Recycle()
        Exit Sub
    End If
    If Not db.IsOpen Then
        Print "FAIL database is not open: " & DATABASE_PATH
        Call db.Recycle()
        Call session.Recycle()
        Exit Sub
    End If

    Print "NOTES-FULL-RUNTIME-BEGIN"
    Print "DATABASE=" & db.FilePath
    Print "NOTES_VERSION=" & session.NotesVersion

    failures = failures + TestSessionSurface(session, db)
    failures = failures + TestNameSurface(session)
    failures = failures + TestDateTimeSurface(session)
    failures = failures + TestDatabaseSurface(session, db, TEST_VIEW, TEST_AGENT)
    failures = failures + TestViewSurface(db, TEST_VIEW)
    failures = failures + TestCollectionSurface(db)
    failures = failures + TestDocumentSurface(db)
    failures = failures + TestItemSurface(session, db)
    failures = failures + TestAgentSurface(db, TEST_AGENT)

    failures = failures + TestRaiseErrorFalse(db, ERROR_FORM)
    failures = failures + TestNoErrorsRaiseErrorTrue(db, VALID_FORM)
    failures = failures + TestMultipleErrorsAndDedup(db, ERROR_FORM)
    failures = failures + TestArrayAssignedBeforeRaise(db, ERROR_FORM)
    failures = failures + TestDoDataTypesIgnored(db, VALID_FORM)

    failures = failures + TestRemoveFTIndex(db)

    If failures = 0 Then
        Print "NOTES-FULL-RUNTIME=PASS"
    Else
        Print "NOTES-FULL-RUNTIME=FAIL COUNT=" & CStr(failures)
    End If

    Call db.Recycle()
    Call session.Recycle()
    Print "NOTES-FULL-RUNTIME-END"
End Sub

Function TestSessionSurface(ByVal session As Variant, ByVal db As Variant) As Integer
    Dim failures As Integer
    Dim replicaDb As NotesDatabase
    Dim nameValue As NotesName
    Dim dtValue As NotesDateTime

    failures = 0
    Print "SECTION=NotesSession"
    Print "Username=" & session.Username
    Print "UserName=" & session.UserName
    Print "CommonUsername=" & session.CommonUsername
    Print "CommonUserName=" & session.CommonUserName
    Print "NotesVersion=" & session.NotesVersion
    Print "NotesBuildVersion=" & CStr(session.NotesBuildVersion)
    Print "Platform=" & session.Platform
    Print "RuntimeDirectory=" & session.RuntimeDirectory
    Print "NotesIni=" & session.NotesIni

    Set replicaDb = session.OpenByReplicaID("", db.ReplicaID)
    If replicaDb Is Nothing Or Not replicaDb.IsOpen Then
        failures = failures + 1
        Print "FAIL NotesSession.OpenByReplicaID"
    Else
        Print "PASS NotesSession.OpenByReplicaID"
        Call replicaDb.Recycle()
    End If

    Set nameValue = session.CreateName("CN=Ada Lovelace/OU=Engineering/O=Example/C=SE")
    If nameValue Is Nothing Then failures = failures + 1 Else Print "PASS NotesSession.CreateName"
    If nameValue Is Not Nothing Then Call nameValue.Recycle()

    Set dtValue = session.CreateDateTime("2026-08-29 08:00:00")
    If dtValue Is Nothing Then failures = failures + 1 Else Print "PASS NotesSession.CreateDateTime"
    If dtValue Is Not Nothing Then Call dtValue.Recycle()

    Set dtValue = session.CreateDateTimeNow()
    If dtValue Is Nothing Then failures = failures + 1 Else Print "PASS NotesSession.CreateDateTimeNow"
    If dtValue Is Not Nothing Then Call dtValue.Recycle()

    TestSessionSurface = failures
End Function

Function TestNameSurface(ByVal session As Variant) As Integer
    Dim failures As Integer
    Dim n As NotesName
    Dim internetName As NotesName

    failures = 0
    Print "SECTION=NotesName"
    Set n = session.CreateName("CN=Ada Lovelace/OU=Engineering/OU=Platform/O=Example/C=SE")
    Print "Parent.Username=" & n.Parent.Username
    Print "Source=" & n.Source
    Print "Canonical=" & n.Canonical
    Print "Abbreviated=" & n.Abbreviated
    Print "IsHierarchical=" & CStr(n.IsHierarchical)
    Print "Common=" & n.Common
    Print "Country=" & n.Country
    Print "Organization=" & n.Organization
    Print "OrgUnit1=" & n.OrgUnit1
    Print "OrgUnit2=" & n.OrgUnit2
    Print "OrgUnit3=" & n.OrgUnit3
    Print "OrgUnit4=" & n.OrgUnit4
    Print "ADMD=" & n.ADMD
    Print "PRMD=" & n.PRMD
    Call n.Recycle()

    Set internetName = session.CreateName("Ada Lovelace <ada@example.com>")
    Print "Addr821=" & internetName.Addr821
    Print "Addr822LocalPart=" & internetName.Addr822LocalPart
    Print "Addr822Phrase=" & internetName.Addr822Phrase
    Call internetName.Recycle()

    TestNameSurface = failures
End Function

Function TestDateTimeSurface(ByVal session As Variant) As Integer
    Dim failures As Integer
    Dim dt As NotesDateTime

    failures = 0
    Print "SECTION=NotesDateTime"
    Set dt = session.CreateDateTime("2026-08-29 08:00:00")
    Print "Parent.Username=" & dt.Parent.Username
    Print "IsValidDate=" & CStr(dt.IsValidDate)
    Print "IsDST=" & CStr(dt.IsDST)
    Print "TimeZone=" & CStr(dt.TimeZone)
    Print "LocalTime=" & dt.LocalTime
    Print "GMTTime=" & dt.GMTTime
    Print "ZoneTime=" & dt.ZoneTime
    Print "DateOnly=" & dt.DateOnly
    Print "TimeOnly=" & dt.TimeOnly
    Call dt.AdjustSecond(1)
    Call dt.AdjustMinute(1)
    Call dt.AdjustHour(1)
    Call dt.AdjustDay(1)
    Call dt.AdjustMonth(1)
    Call dt.AdjustYear(1)
    Print "Adjusted=" & dt.LocalTime
    Call dt.Recycle()

    TestDateTimeSurface = failures
End Function

Function TestDatabaseSurface(ByVal session As Variant, ByVal db As Variant, ByVal viewName As String, ByVal agentName As String) As Integer
    Dim failures As Integer
    Dim parentSession As NotesSession
    Dim created As NotesDateTime
    Dim modified As NotesDateTime
    Dim view As NotesView
    Dim docs As NotesDocumentCollection
    Dim profile As NotesDocument
    Dim temp As NotesDocument
    Dim byId As NotesDocument
    Dim byUnid As NotesDocument
    Dim agentResult As NotesAgentResult
    Dim oldTitle As String
    Dim oldCategories As String
    Dim oldTemplate As String
    Dim oldDesignTemplate As String
    Dim noteId As String
    Dim unid As String
    Dim errCode As Integer

    failures = 0
    Print "SECTION=NotesDatabase"
    Set parentSession = db.Parent
    Print "Parent.Username=" & parentSession.Username
    Print "Server=" & db.Server
    Print "FilePath=" & db.FilePath
    Print "FileName=" & db.FileName
    Print "IsOpen=" & CStr(db.IsOpen)
    Print "Title=" & db.Title
    Print "Categories=" & db.Categories
    Print "TemplateName=" & db.TemplateName
    Print "DesignTemplateName=" & db.DesignTemplateName
    Print "ReplicaID=" & db.ReplicaID
    Print "Size=" & CStr(db.Size)
    Print "PercentUsed=" & CStr(db.PercentUsed)
    Print "CurrentAccessLevel=" & CStr(db.CurrentAccessLevel)
    Print "FileFormat=" & CStr(db.FileFormat)
    Set created = db.Created
    Set modified = db.LastModified
    Print "Created=" & created.LocalTime
    Print "LastModified=" & modified.LocalTime
    Call created.Recycle()
    Call modified.Recycle()

    oldTitle = db.Title
    oldCategories = db.Categories
    oldTemplate = db.TemplateName
    oldDesignTemplate = db.DesignTemplateName
    db.Title = oldTitle & " [XPscript-test]"
    db.Categories = "XPscriptRuntimeTest"
    db.TemplateName = "XPscriptRuntimeTemplate"
    db.DesignTemplateName = "XPscriptRuntimeDesignTemplate"
    db.Title = oldTitle
    db.Categories = oldCategories
    db.TemplateName = oldTemplate
    db.DesignTemplateName = oldDesignTemplate
    Print "PASS writable NotesDatabase metadata restored"

    Set temp = db.CreateDocument()
    Call temp.ReplaceItemValue("Form", "XPScriptTest")
    Call temp.ReplaceItemValue("Subject", "Runtime DB surface")
    Call temp.ReplaceItemValue("XPScriptMarker", "database-surface")
    Call temp.Save()
    noteId = temp.NoteID
    unid = temp.UniversalID

    Set byId = db.GetDocumentByID(noteId)
    If byId Is Nothing Then failures = failures + 1 Else Call byId.Recycle()
    Set byId = db.GetDocumentByNoteId(noteId)
    If byId Is Nothing Then failures = failures + 1 Else Call byId.Recycle()
    Set byId = db.OpenDocumentByNoteId(noteId)
    If byId Is Nothing Then failures = failures + 1 Else Call byId.Recycle()
    Set byUnid = db.GetDocumentByUNID(unid)
    If byUnid Is Nothing Then failures = failures + 1 Else Call byUnid.Recycle()
    Set byUnid = db.OpenDocumentByUNID(unid)
    If byUnid Is Nothing Then failures = failures + 1 Else Call byUnid.Recycle()

    Set docs = db.CreateDocumentCollection()
    Print "CreateDocumentCollection.Count=" & CStr(docs.Count)
    Call docs.Recycle()
    Set docs = db.AllDocuments
    Print "AllDocuments.Count=" & CStr(docs.Count)
    Call docs.Recycle()
    Set docs = db.Search("Form=\"XPScriptTest\"")
    Print "Search.Count=" & CStr(docs.Count)
    Call docs.Recycle()
    Set docs = db.Search("Form=\"XPScriptTest\"", 1)
    Print "Search(max).Count=" & CStr(docs.Count)
    Call docs.Recycle()

    On Error Resume Next
    Set docs = db.FTSearch("XPscript", 10)
    errCode = Err
    On Error GoTo 0
    If errCode = 0 And docs Is Not Nothing Then
        Print "PASS NotesDatabase.FTSearch Count=" & CStr(docs.Count)
        Call docs.Recycle()
    Else
        Print "INFO NotesDatabase.FTSearch requires an FT index, Err=" & CStr(errCode)
    End If

    Set view = db.GetView(viewName)
    If view Is Nothing Then failures = failures + 1 Else Call view.Recycle()
    Set view = db.OpenView(viewName)
    If view Is Nothing Then failures = failures + 1 Else Call view.Recycle()

    Set profile = db.GetProfileDocument("XPScriptTestProfile", "Runtime")
    Call profile.ReplaceItemValue("XPScriptProfileMarker", "profile-ok")
    Call profile.Save()
    If profile.GetString("XPScriptProfileMarker") <> "profile-ok" Then failures = failures + 1
    Call profile.Recycle()

    Set agentResult = db.RunAgent(agentName)
    If agentResult Is Nothing Then failures = failures + 1 Else Call agentResult.Recycle()
    Set agentResult = db.RunAgent(agentName, temp)
    If agentResult Is Nothing Then failures = failures + 1 Else Call agentResult.Recycle()

    Call temp.Remove(True)
    Call temp.Recycle()
    TestDatabaseSurface = failures
End Function

Function TestViewSurface(ByVal db As Variant, ByVal viewName As String) As Integer
    Dim failures As Integer
    Dim view As NotesView
    Dim doc As NotesDocument
    Dim nextDoc As NotesDocument
    Dim docs As NotesDocumentCollection
    Dim errCode As Integer

    failures = 0
    Print "SECTION=NotesView"
    Set view = db.GetView(viewName)
    If view Is Nothing Then
        Print "FAIL NotesView fixture missing"
        TestViewSurface = 1
        Exit Function
    End If

    Print "Name=" & view.Name
    view.AutoUpdate = False
    Print "AutoUpdate=False => " & CStr(view.AutoUpdate)
    view.AutoUpdate = True
    Print "AutoUpdate=True => " & CStr(view.AutoUpdate)

    Set doc = view.GetFirstDocument()
    If doc Is Nothing Then
        failures = failures + 1
        Print "FAIL GetFirstDocument"
    Else
        Set nextDoc = view.GetNextDocument(doc)
        If nextDoc Is Not Nothing Then Call nextDoc.Recycle()
        Call doc.Recycle()
    End If

    Set doc = view.GetFirstDocumentByKey("Alpha", True)
    If doc Is Nothing Then failures = failures + 1 Else Call doc.Recycle()
    Set doc = view.GetFirstDocumentByKey("Al", False)
    If doc Is Nothing Then failures = failures + 1 Else Call doc.Recycle()

    Set docs = view.GetAllDocumentsByKey("Alpha", True)
    If docs.Count < 1 Then failures = failures + 1
    Call docs.Recycle()
    Set docs = view.GetAllDocumentsByKey("Al", False)
    If docs.Count < 1 Then failures = failures + 1
    Call docs.Recycle()

    On Error Resume Next
    Set docs = view.FTSearch("Alpha", 10)
    errCode = Err
    On Error GoTo 0
    If errCode = 0 And docs Is Not Nothing Then Call docs.Recycle() Else Print "INFO NotesView.FTSearch requires FT index, Err=" & CStr(errCode)

    Call view.Refresh()
    Call view.Recycle()
    TestViewSurface = failures
End Function

Function TestCollectionSurface(ByVal db As Variant) As Integer
    Dim failures As Integer
    Dim docs As NotesDocumentCollection
    Dim more As NotesDocumentCollection
    Dim doc As NotesDocument
    Dim nextDoc As NotesDocument
    Dim parentDb As NotesDatabase
    Dim noteId As String

    failures = 0
    Print "SECTION=NotesDocumentCollection"
    Set docs = db.Search("Form=\"XPScriptTest\"")
    Set parentDb = docs.Parent
    Print "Parent.FilePath=" & parentDb.FilePath
    Print "Count=" & CStr(docs.Count)

    If docs.Count > 0 Then
        noteId = docs(0)
        Print "Indexer=" & noteId
        Set doc = docs.GetFirstDocument()
        If doc Is Nothing Then failures = failures + 1 Else
            Set nextDoc = docs.GetNextDocument(doc)
            If nextDoc Is Not Nothing Then Call nextDoc.Recycle()
            Set nextDoc = docs.GetDocument(doc)
            If nextDoc Is Nothing Then failures = failures + 1 Else Call nextDoc.Recycle()
            Set nextDoc = docs.GetDocument(noteId)
            If nextDoc Is Nothing Then failures = failures + 1 Else Call nextDoc.Recycle()
        End If
    End If

    Set more = db.CreateDocumentCollection()
    If doc Is Not Nothing Then Call more.AddDocument(doc)
    Call more.AddDocument(docs)
    Print "After AddDocument Count=" & CStr(more.Count)
    If doc Is Not Nothing Then Call more.RemoveDocument(doc)
    Call more.RemoveDocument(docs)
    Print "After RemoveDocument Count=" & CStr(more.Count)

    If doc Is Not Nothing Then Call doc.Recycle()
    Call more.Recycle()
    Call docs.Recycle()
    TestCollectionSurface = failures
End Function

Function TestDocumentSurface(ByVal db As Variant) As Integer
    Dim failures As Integer
    Dim doc As NotesDocument
    Dim child As NotesDocument
    Dim other As NotesDocument
    Dim copied As NotesDocument
    Dim item As NotesItem
    Dim copiedItem As NotesItem
    Dim responses As NotesDocumentCollection
    Dim dt As NotesDateTime
    Dim values As Variant
    Dim items As Variant
    Dim originalUnid As String
    Dim ok As Boolean

    failures = 0
    Print "SECTION=NotesDocument"
    Set doc = db.CreateDocument()
    Print "IsNewNote=" & CStr(doc.IsNewNote)
    Call doc.ReplaceItemValue("Form", "XPScriptTest")
    Call doc.ReplaceItemValue("Subject", "Document Surface")
    Call doc.ReplaceItemValue("TextValue", "hello")
    Call doc.SetString("SetStringValue", "world")
    Call doc.SetNumber("NumberValue", 42.5)
    Set dt = db.Parent.CreateDateTime("2026-08-29 09:10:11")
    Call doc.SetDateTime("DateValue", dt)
    Call doc.SetValue("GenericValue", "generic")
    Call doc.Save()

    Print "NoteID=" & doc.NoteID
    Print "NoteIdHex=" & doc.NoteIdHex
    originalUnid = doc.UniversalID
    doc.UniversalID = originalUnid
    Print "UniversalID=" & doc.UniversalID
    Print "Size=" & CStr(doc.Size)
    Print "ParentDocumentUNID=" & doc.ParentDocumentUNID
    Set dt = doc.Created
    Print "Created=" & dt.LocalTime
    Call dt.Recycle()
    Set dt = doc.LastModified
    Print "LastModified=" & dt.LocalTime
    Call dt.Recycle()
    Print "IsResponse=" & CStr(doc.IsResponse)
    Print "IsDeleted=" & CStr(doc.IsDeleted)

    Print "HasItem=" & CStr(doc.HasItem("TextValue"))
    Print "GetString=" & doc.GetString("TextValue")
    Print "GetNumber=" & CStr(doc.GetNumber("NumberValue"))
    Print "GetValue=" & CStr(doc.GetValue("GenericValue"))
    Set dt = doc.GetDateTime("DateValue")
    Print "GetDateTime=" & dt.LocalTime
    Call dt.Recycle()

    values = doc.GetItemValue("TextValue")
    Print "GetItemValue(0)=" & CStr(values(0))
    items = doc.Items
    Print "Items.LBound=" & CStr(LBound(items)) & " UBound=" & CStr(UBound(items))

    Set item = doc.GetFirstItem("TextValue")
    Set copiedItem = doc.CopyItem(item, "CopiedTextValue")
    Call copiedItem.Recycle()
    Call item.Recycle()

    Set other = db.CreateDocument()
    Call doc.CopyAllItems(other)
    Call doc.CopyAllItems(other, True)
    If other.GetString("TextValue") <> "hello" Then failures = failures + 1

    Set copied = doc.CopyToDatabase(db)
    If copied Is Nothing Then failures = failures + 1 Else
        Call copied.Remove(True)
        Call copied.Recycle()
    End If

    Set child = db.CreateDocument()
    Call child.ReplaceItemValue("Form", "XPScriptTest")
    Call child.MakeResponse(doc)
    Call child.Save()
    If Not child.IsResponse Then failures = failures + 1
    If child.ParentDocumentUNID <> doc.UniversalID Then failures = failures + 1
    Set responses = doc.Responses
    If responses.Count < 1 Then failures = failures + 1
    Call responses.Recycle()

    Call doc.PutInFolder("XPScript Runtime Folder", True)
    Call doc.RemoveFromFolder("XPScript Runtime Folder")
    Call doc.MarkUnread()
    Call doc.MarkRead()
    Call doc.MarkUnread(db.Parent.Username)
    Call doc.MarkRead(db.Parent.Username)

    ok = doc.SaveAttachment("missing-runtime-attachment.bin", "missing-runtime-attachment.out")
    Print "SaveAttachment(missing)=" & CStr(ok)

    Call doc.RemoveItem("GenericValue")
    If doc.HasItem("GenericValue") Then failures = failures + 1

    Call child.Remove(True)
    Call child.Recycle()
    Call other.Recycle()
    Call doc.Remove(True)
    Call doc.Recycle()
    TestDocumentSurface = failures
End Function

Function TestItemSurface(ByVal session As Variant, ByVal db As Variant) As Integer
    Dim failures As Integer
    Dim doc As NotesDocument
    Dim other As NotesDocument
    Dim item As NotesItem
    Dim copied As NotesItem
    Dim rich As NotesRichTextItem
    Dim dt As NotesDateTime
    Dim values As Variant
    Dim ok As Boolean

    failures = 0
    Print "SECTION=NotesItem"
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptTest")
    Set item = doc.ReplaceItemValue("ItemSurface", "one")
    Print "Parent.NoteID=" & item.Parent.NoteID
    Print "Name=" & item.Name
    Print "Text=" & item.Text
    Print "Type=" & CStr(item.Type)
    Print "ValueLength=" & CStr(item.ValueLength)
    Print "LastModified=" & item.LastModified.LocalTime

    item.IsAuthors = True
    Print "IsAuthors=" & CStr(item.IsAuthors)
    item.IsAuthors = False
    item.IsNames = True
    Print "IsNames=" & CStr(item.IsNames)
    item.IsReaders = True
    Print "IsReaders=" & CStr(item.IsReaders)
    item.IsReaders = False
    item.IsEncrypted = True
    Print "IsEncrypted=" & CStr(item.IsEncrypted)
    item.IsEncrypted = False
    item.IsProtected = True
    Print "IsProtected=" & CStr(item.IsProtected)
    item.IsProtected = False
    item.IsSigned = True
    Print "IsSigned=" & CStr(item.IsSigned)
    item.IsSigned = False
    item.IsSummary = True
    Print "IsSummary=" & CStr(item.IsSummary)

    values = item.Values
    Print "Values(0)=" & CStr(values(0))
    item.Values = Array("one", "two")
    values = item.Values
    Print "Values list UBound=" & CStr(UBound(values))

    Set other = db.CreateDocument()
    Set copied = item.CopyToDocument(other)
    Call copied.Recycle()
    Set copied = item.CopyToDocument(other, "RenamedItemSurface")
    Call copied.Recycle()

    Set dt = session.CreateDateTime("2026-08-29 10:11:12")
    Call doc.SetDateTime("DateItem", dt)
    Set item = doc.GetFirstItem("DateItem")
    Set dt = item.DateTimeValue
    If dt Is Nothing Then failures = failures + 1 Else
        item.DateTimeValue = dt
        Call dt.Recycle()
    End If
    Call item.Recycle()

    Set item = doc.CreateNotesItem("EmptyItem")
    Call item.Remove()
    Call item.Recycle()

    ' Exercise NotesRichTextItem using the fixture document. SaveAttachment with a
    ' deliberately missing attachment verifies the native traversal/error-free path.
    Set doc = db.GetView("XPScriptTestView").GetFirstDocument()
    If doc Is Not Nothing Then
        Set item = doc.GetFirstItem("Body")
        If item Is Not Nothing And item.Type = 1 Then
            Set rich = item
            Print "RichText.Text=" & rich.Text
            ok = rich.SaveAttachment("missing-runtime-attachment.bin", "missing-runtime-attachment.out")
            Print "RichText.SaveAttachment(missing)=" & CStr(ok)
            Call rich.Recycle()
        ElseIf item Is Not Nothing Then
            Call item.Recycle()
        End If
        Call doc.Recycle()
    End If

    Call other.Recycle()
    TestItemSurface = failures
End Function

Function TestAgentSurface(ByVal db As Variant, ByVal agentName As String) As Integer
    Dim failures As Integer
    Dim result As NotesAgentResult
    Dim doc As NotesDocument

    failures = 0
    Print "SECTION=NotesAgentResult"
    Set result = db.RunAgent(agentName)
    If result Is Nothing Then
        failures = failures + 1
    Else
        Print "Success=" & CStr(result.Success)
        Print "Status=" & CStr(result.Status)
        Print "Output=" & result.Output
        Call result.Recycle()
    End If

    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptTest")
    Set result = db.RunAgent(agentName, doc)
    If result Is Nothing Then failures = failures + 1 Else
        Print "DocumentContext.Output=" & result.Output
        Call result.Recycle()
    End If
    Call doc.Recycle()
    TestAgentSurface = failures
End Function

Function TestRemoveFTIndex(ByVal db As Variant) As Integer
    Dim errCode As Integer
    Print "SECTION=NotesDatabase.RemoveFTIndex"
    errCode = 0
    On Error Resume Next
    Call db.RemoveFTIndex()
    errCode = Err
    On Error GoTo 0
    If errCode = 0 Then
        Print "PASS RemoveFTIndex"
        TestRemoveFTIndex = 0
    Else
        Print "FAIL RemoveFTIndex Err=" & CStr(errCode)
        TestRemoveFTIndex = 1
    End If
End Function

Function TestRaiseErrorFalse(ByVal db As Variant, ByVal formName As String) As Integer
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim ok As Boolean
    Dim failures As Integer

    failures = 0
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", formName)
    failedFields = "SENTINEL"
    ok = doc.ComputeWithForm(False, False, failedFields)

    If ok Then
        failures = failures + 1
        Print "FAIL raiseError=False expected validation failure"
    ElseIf failedFields Is Nothing Then
        Print "PASS raiseError=False leaves failedFields Nothing"
    Else
        failures = failures + 1
        Print "FAIL raiseError=False did not leave failedFields Nothing"
    End If
    Call doc.Recycle()
    TestRaiseErrorFalse = failures
End Function

Function TestNoErrorsRaiseErrorTrue(ByVal db As Variant, ByVal formName As String) As Integer
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim ok As Boolean
    Dim failures As Integer
    Dim errCode As Integer

    failures = 0
    errCode = 0
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", formName)
    failedFields = "SENTINEL"
    On Error Resume Next
    ok = doc.ComputeWithForm(False, True, failedFields)
    errCode = Err
    On Error GoTo 0

    If errCode <> 0 Then
        failures = failures + 1
        Print "FAIL valid form raised error " & CStr(errCode)
    ElseIf Not ok Then
        failures = failures + 1
        Print "FAIL valid form returned False"
    ElseIf failedFields Is Nothing Then
        Print "PASS raiseError=True with no errors leaves failedFields Nothing"
    Else
        failures = failures + 1
        Print "FAIL valid form did not leave failedFields Nothing"
    End If
    Call doc.Recycle()
    TestNoErrorsRaiseErrorTrue = failures
End Function

Function TestMultipleErrorsAndDedup(ByVal db As Variant, ByVal formName As String) As Integer
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim errCode As Integer
    Dim i As Integer
    Dim count As Integer
    Dim countOne As Integer
    Dim countTwo As Integer
    Dim failures As Integer

    failures = 0
    errCode = 0
    count = 0
    countOne = 0
    countTwo = 0
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", formName)
    failedFields = "SENTINEL"

    On Error Resume Next
    Call doc.ComputeWithForm(False, True, failedFields)
    errCode = Err
    On Error GoTo 0

    If errCode = 0 Then failures = failures + 1
    If failedFields Is Nothing Then
        failures = failures + 1
    Else
        count = UBound(failedFields) - LBound(failedFields) + 1
        For i = LBound(failedFields) To UBound(failedFields)
            Print "FAILED-FIELD=" & CStr(failedFields(i))
            If CStr(failedFields(i)) = "CWFErrorOne" Then countOne = countOne + 1
            If CStr(failedFields(i)) = "CWFErrorTwo" Then countTwo = countTwo + 1
        Next
        If count < 2 Then failures = failures + 1
        If countOne <> 1 Then failures = failures + 1
        If countTwo <> 1 Then failures = failures + 1
    End If
    Call doc.Recycle()
    TestMultipleErrorsAndDedup = failures
End Function

Function TestArrayAssignedBeforeRaise(ByVal db As Variant, ByVal formName As String) As Integer
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim errCode As Integer
    Dim failures As Integer

    failures = 0
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", formName)
    failedFields = "SENTINEL"
    On Error Resume Next
    Call doc.ComputeWithForm(False, True, failedFields)
    errCode = Err
    On Error GoTo 0

    If errCode = 0 Then failures = failures + 1
    If failedFields Is Nothing Then failures = failures + 1 ElseIf UBound(failedFields) < LBound(failedFields) Then failures = failures + 1
    Call doc.Recycle()
    TestArrayAssignedBeforeRaise = failures
End Function

Function TestDoDataTypesIgnored(ByVal db As Variant, ByVal formName As String) As Integer
    Dim docFalse As NotesDocument
    Dim docTrue As NotesDocument
    Dim okFalse As Boolean
    Dim okTrue As Boolean
    Dim valueFalse As String
    Dim valueTrue As String
    Dim failures As Integer

    failures = 0
    Set docFalse = db.CreateDocument()
    Call docFalse.ReplaceItemValue("Form", formName)
    okFalse = docFalse.ComputeWithForm(False, False)
    valueFalse = docFalse.GetString("CWFDefault")

    Set docTrue = db.CreateDocument()
    Call docTrue.ReplaceItemValue("Form", formName)
    okTrue = docTrue.ComputeWithForm(True, False)
    valueTrue = docTrue.GetString("CWFDefault")

    If okFalse <> okTrue Then failures = failures + 1
    If valueFalse <> valueTrue Then failures = failures + 1
    If valueFalse <> "DEFAULT-VALUE" Then failures = failures + 1
    Call docTrue.Recycle()
    Call docFalse.Recycle()
    TestDoDataTypesIgnored = failures
End Function
