' Focused NotesDatabase full runtime regression for checklist point 3.
' Requires a local HCL Notes/Domino runtime and xpscript.nsf.
Option Declare

Sub Main()
    Const DATABASE_PATH = "xpscript.nsf"
    Const COPY_PATH = "xpscript-database-fulltest-copy.nsf"

    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim copyDb As NotesDatabase
    Dim docs As NotesDocumentCollection
    Dim since As NotesDateTime
    Dim lastIndexed As NotesDateTime
    Dim failures As Integer
    Dim errCode As Integer

    failures = 0
    Set session = New NotesSession()
    Set db = session.OpenDatabase("", DATABASE_PATH)

    If db Is Nothing Then
        Print "NOTES-DATABASE-FULL=FAIL database returned Nothing"
        Call session.Recycle()
        Exit Sub
    End If
    If Not db.IsOpen Then
        Print "NOTES-DATABASE-FULL=FAIL database not open"
        Call db.Recycle()
        Call session.Recycle()
        Exit Sub
    End If

    Print "OpenError=" & CStr(db.OpenError)
    If db.OpenError <> 0 Then
        Print "FAIL OpenError expected 0 for open database"
        failures = failures + 1
    End If

    Print "IsFTIndexed=" & CStr(db.IsFTIndexed)
    Set lastIndexed = db.LastFTIndexed
    If db.IsFTIndexed Then
        If lastIndexed Is Nothing Then
            Print "FAIL LastFTIndexed expected value for FT-indexed database"
            failures = failures + 1
        Else
            Print "LastFTIndexed=" & lastIndexed.LocalTime
        End If
    Else
        If lastIndexed Is Nothing Then
            Print "LastFTIndexed=Nothing"
        Else
            Print "LastFTIndexed=" & lastIndexed.LocalTime
        End If
    End If
    If Not lastIndexed Is Nothing Then Call lastIndexed.Recycle()

    Set since = session.CreateDateTimeNow()
    Call since.AdjustDay(-1)
    Set docs = db.GetModifiedDocuments(since, 0)
    If docs Is Nothing Then
        Print "FAIL GetModifiedDocuments returned Nothing"
        failures = failures + 1
    Else
        Print "GetModifiedDocuments.Count=" & CStr(docs.Count)
        Call docs.Recycle()
    End If
    Call since.Recycle()

    errCode = 0
    On Error Resume Next
    Set copyDb = db.CreateCopy("", COPY_PATH)
    errCode = Err
    On Error GoTo 0
    If errCode <> 0 Then
        Print "FAIL CreateCopy Err=" & CStr(errCode)
        failures = failures + 1
    ElseIf copyDb Is Nothing Then
        Print "FAIL CreateCopy returned Nothing"
        failures = failures + 1
    ElseIf Not copyDb.IsOpen Then
        Print "FAIL CreateCopy returned closed database"
        failures = failures + 1
        Call copyDb.Recycle()
    Else
        Print "CreateCopy=" & copyDb.FilePath

        ' Sign and RemoveFTIndex are mutating operations. Exercise them on the temporary
        ' copy so the source runtime fixture is not modified by this focused regression.
        errCode = 0
        On Error Resume Next
        Call copyDb.Sign()
        errCode = Err
        On Error GoTo 0
        If errCode <> 0 Then
            Print "FAIL Sign Err=" & CStr(errCode)
            failures = failures + 1
        Else
            Print "Sign=PASS"
        End If

        errCode = 0
        On Error Resume Next
        Call copyDb.RemoveFTIndex()
        errCode = Err
        On Error GoTo 0
        If errCode <> 0 Then
            Print "FAIL RemoveFTIndex Err=" & CStr(errCode)
            failures = failures + 1
        ElseIf copyDb.IsFTIndexed Then
            Print "FAIL RemoveFTIndex left IsFTIndexed=True"
            failures = failures + 1
        Else
            Print "RemoveFTIndex=PASS"
        End If

        errCode = 0
        On Error Resume Next
        Call copyDb.Remove()
        errCode = Err
        On Error GoTo 0
        If errCode <> 0 Then
            Print "FAIL temporary copy cleanup Err=" & CStr(errCode)
            failures = failures + 1
        End If
        Call copyDb.Recycle()
    End If

    Call db.Recycle()
    Call session.Recycle()

    If failures = 0 Then
        Print "NOTES-DATABASE-FULL=PASS"
    Else
        Print "NOTES-DATABASE-FULL=FAIL COUNT=" & CStr(failures)
    End If
End Sub
