Option Declare
Sub Main()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim view As NotesView
    Dim doc As NotesDocument
    Dim found As NotesDocument
    Set session = New NotesSession()
    Set db = session.OpenDatabase("", "xpscript.nsf")
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptTest")
    Call doc.ReplaceItemValue("Subject", "AST-key-regression-unique")
    Call doc.Save()
    Set view = db.GetView("XPScriptTestView")
    Call view.Refresh()
    Set found = view.GetDocumentByKey("AST-key-regression-unique", True)
    If found Is Nothing Then Error 5, "Exact key lookup returned Nothing"
    If found.NoteID <> doc.NoteID Then Error 5, "Exact key lookup returned wrong note"
    Call found.Recycle()
    Set found = view.GetDocumentByKey("AST-key-regression-")
    If found Is Nothing Then Error 5, "Partial key lookup returned Nothing"
    Call found.Recycle()
    Set found = view.GetDocumentByKey("AST-key-regression-never-present", True)
    If Not found Is Nothing Then Error 5, "Missing key must return Nothing"
    Call doc.Remove(True)
    Call doc.Recycle()
    Call view.Recycle()
    Call db.Recycle()
    Call session.Recycle()
    Print "NOTES-VIEW-KEY=PASS"
End Sub
