Option Declare

Sub Main()
    Dim f As Integer
    Dim payload As String
    Dim binaryRead As String
    Dim randomRead As String

    payload = "ÅÄÖ"

    f = FreeFile
    Open "xps-binary-latin1.bin" For Binary As #f
    Put #f, 1, payload
    Close #f

    binaryRead = "   "
    f = FreeFile
    Open "xps-binary-latin1.bin" For Binary As #f
    Get #f, 1, binaryRead
    Close #f

    If binaryRead <> payload Then Error 5

    f = FreeFile
    Open "xps-random-latin1.bin" For Random As #f Len = 16
    Put #f, 1, payload
    Close #f

    randomRead = ""
    f = FreeFile
    Open "xps-random-latin1.bin" For Random As #f Len = 16
    Get #f, 1, randomRead
    Close #f

    If randomRead <> payload Then Error 5

    Print "BINARY_RANDOM_LATIN1=OK"
End Sub
