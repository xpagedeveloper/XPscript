' (c) xpagedeveloper.com 2026

Sub OnListSelect(evt As Variant, context As String)
    Dim eventJson As String
    eventJson = evt.ToJson()
    Print "LIST-EVENT=" & evt.EventType
    Print "LIST-ROW=" & CStr(evt.RowIndex)
    Print "LIST-KEY=" & evt.Key
    Print "LIST-CONTEXT=" & context
End Sub

Sub OnListDoubleClick(evt As Variant, context As String, mode As Integer)
    Dim eventJson As String
    eventJson = evt.ToJson()
    Print "LIST-DOUBLE=" & evt.EventType
    Print "LIST-DOUBLE-CONTEXT=" & context & ":" & CStr(mode)
End Sub

Sub Main()
    Dim rows As New XPJsonArray
    Dim first As New XPJsonObject
    Dim second As New XPJsonObject
    Dim list As New UIListView("Customers")

    Call first.Set("id", "1001")
    Call first.Set("name", "Kalle")
    Call first.Set("city", "Stockholm")
    Call rows.Add(first)

    Call second.Set("id", "1002")
    Call second.Set("name", "Anna")
    Call second.Set("city", "Gothenburg")
    Call rows.Add(second)

    Call list.BindData(rows)
    Call list.AddColumn("name", "Name")
    Call list.AddColumn("city", "City")
    Call list.SetColumnWidth("name", 240)
    Call list.SetKeyField("id")
    Call list.SetOnSelectCallback("OnListSelect", "customer-list")
    Call list.SetOnDoubleClickCallback("OnListDoubleClick", "customer-list", 2)

    Print "TITLE=" & list.Title
    Print "ROWS=" & list.RowCount
    Print "COLUMNS=" & list.ColumnCount
    Print "ROW0_NAME=" & list.GetRowValueString(0, "name")

    Call list.SelectRow(1)
    Print "SELECTED_INDEX=" & list.SelectedIndex
    Print "SELECTED_NAME=" & list.GetSelectedValueString("name")
    Print "SELECTED_KEY=" & list.GetSelectedKey()

    Call list.ClearSelection()
    Print "SELECTED_AFTER_CLEAR=" & list.SelectedIndex
End Sub
