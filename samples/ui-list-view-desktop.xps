' (c) xpagedeveloper.com 2026

Sub Main()
    Dim rows As New JsonArray
    Dim first As New JsonObject
    Dim second As New JsonObject
    Dim list As New UIListView("Customers")
    Dim result As String

    Call first.Set("id", "1001")
    Call first.Set("name", "Kalle")
    Call first.Set("city", "Stockholm")
    Call rows.Add(first)

    Call second.Set("id", "1002")
    Call second.Set("name", "Anna")
    Call second.Set("city", "Gothenburg")
    Call rows.Add(second)

    Call list.BindData(rows)
    Call list.AddColumn("name", "Name")
    Call list.AddColumn("city", "City")
    Call list.SetColumnWidth("name", 240)
    Call list.SetColumnWidth("city", 220)
    Call list.SetKeyField("id")
    Call list.SetOnSelect("CustomerSelected")
    Call list.SetOnDoubleClick("CustomerDoubleClicked")
    Call list.SetRowAction("customer-form.xps", "id", "customerId")

    result = list.ShowDialog()
    Print "RESULT=" & result
    Print "SELECTED_INDEX=" & list.SelectedIndex
    Print "SELECTED_KEY=" & list.GetSelectedKey()
End Sub

Sub CustomerSelected(list As Variant)
    Print "SELECTED=" & list.GetSelectedKey()
End Sub

Sub CustomerDoubleClicked(list As Variant)
    Print "DOUBLE_CLICKED=" & list.GetSelectedValueString("name")
End Sub
