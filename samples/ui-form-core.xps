' XPScript UIForm core and JSON binding regression
' (c) xpagedeveloper.com 2026

Sub Main()
    Dim first As New UIForm("First", 640, 480, True)
    Dim second As New UIForm("Second")
    Dim data As New XPJsonObject

    Print "FIRST_TITLE=" & first.Title
    Print "FIRST_WIDTH=" & CStr(first.Width)
    Print "FIRST_HEIGHT=" & CStr(first.Height)
    Print "FIRST_RESIZABLE=" & CStr(first.Resizable)
    Print "FIRST_HAS_SIZE=" & CStr(first.HasExplicitSize)

    Print "SECOND_TITLE=" & second.Title
    Print "SECOND_WIDTH=" & CStr(second.Width)
    Print "SECOND_HEIGHT=" & CStr(second.Height)
    Print "SECOND_HAS_SIZE=" & CStr(second.HasExplicitSize)

    first.Title = "Changed"
    first.Width = 800
    first.Height = 600
    first.Resizable = False

    Print "FIRST_CHANGED_TITLE=" & first.Title
    Print "FIRST_CHANGED_WIDTH=" & CStr(first.Width)
    Print "FIRST_CHANGED_HEIGHT=" & CStr(first.Height)
    Print "FIRST_CHANGED_RESIZABLE=" & CStr(first.Resizable)
    Print "SECOND_STILL_TITLE=" & second.Title

    Call data.Set("existing", "Loaded from JSON")
    Call data.Set("age", 42)
    Call data.Set("enabled", True)
    Call data.Set("birthday", "2026-08-18")
    Call data.Set("country", "SE")
    Call first.BindData(data)
    If first.HasValidationSchema Then Error 5, "Expected no JSON Schema validation by default"
    If Not first.IsDataValid Then Error 5, "Expected UIForm data without a validation schema to be valid"
    If Not first.ValidateData().Valid Then Error 5, "Expected default UIForm validation result to be valid"

    Dim schema As XPJsonSchema
    Set schema = XPJsonSchema.Parse("{""type"":""object"",""properties"":{""age"":{""type"":""integer"",""minimum"":50}}}")
    Call first.SetValidationSchema(schema)
    If Not first.HasValidationSchema Then Error 5, "Expected UIForm JSON Schema to be configured"
    If first.IsDataValid Then Error 5, "Expected bound JSON data to fail configured schema"
    If first.ValidateData().FailedPaths.Get(0) <> "$.age" Then Error 5, "Expected UIForm schema failure path"

    Dim nestedForm As New UIForm("Nested schema")
    Dim nestedData As New XPJsonObject
    Dim customer As New XPJsonObject
    Dim address As New XPJsonObject
    Call address.Set("city", "")
    Call customer.Set("address", address)
    Call nestedData.Set("customer", customer)
    Call nestedForm.BindData(nestedData)
    Call nestedForm.AddTextField("customer", "Customer")
    Set schema = XPJsonSchema.Parse("{""type"":""object"",""properties"":{""customer"":{""type"":""object"",""properties"":{""address"":{""type"":""object"",""properties"":{""city"":{""minLength"":2}}}}}}}}")
    Call nestedForm.SetValidationSchema(schema)
    If nestedForm.ValidateData().FailedPaths.Get(0) <> "$.customer.address.city" Then Error 5, "Expected nested UIForm schema failure path"
    If nestedForm.GetValidationError("customer") = "" Then Error 5, "Expected nested schema error to map to parent UIForm field"

    Dim arrayForm As New UIForm("Array schema")
    Dim arrayData As XPJsonDocument
    Set arrayData = XPJson.Parse("{""items"":[{""quantity"":0}]}")
    Call arrayForm.BindData(arrayData)
    Call arrayForm.AddTextField("items", "Items")
    Set schema = XPJsonSchema.Parse("{""type"":""object"",""properties"":{""items"":{""type"":""array"",""items"":{""type"":""object"",""properties"":{""quantity"":{""minimum"":1}}}}}}")
    Call arrayForm.SetValidationSchema(schema)
    If arrayForm.ValidateData().FailedPaths.Get(0) <> "$.items[0].quantity" Then Error 5, "Expected array UIForm schema failure path"
    If arrayForm.GetValidationError("items") = "" Then Error 5, "Expected array schema error to map to parent UIForm field"

    Dim prefixForm As New UIForm("Schema prefix boundary")
    Dim prefixData As XPJsonDocument
    Set prefixData = XPJson.Parse("{""username"":""""}")
    Call prefixForm.BindData(prefixData)
    Call prefixForm.AddTextField("user", "User")
    Call prefixForm.AddTextField("username", "Username")
    Set schema = XPJsonSchema.Parse("{""type"":""object"",""properties"":{""username"":{""minLength"":2}}}")
    Call prefixForm.SetValidationSchema(schema)
    If prefixForm.GetValidationError("user") <> "" Then Error 5, "Schema error for username must not map to user prefix field"
    If prefixForm.GetValidationError("username") = "" Then Error 5, "Expected schema error to map to exact username field"

    Call first.SetValidationSchema(Nothing)
    If first.HasValidationSchema Then Error 5, "Expected UIForm JSON Schema to be cleared"
    If Not first.IsDataValid Then Error 5, "Expected UIForm data to be valid after clearing schema"
    Call first.AddTextField("existing", "Existing")
    Call first.AddTextField("missing", "Missing")
    Call first.AddTextArea("notes", "Notes")
    Call first.AddNumberField("age", "Age")
    Call first.AddCheckBox("enabled", "Enabled")
    Call first.AddDateField("birthday", "Birthday")
    Call first.AddPasswordField("password", "Password")
    Call first.AddSelect("country", "Country")
    Call first.AddOption("country", "SE")
    Call first.AddOption("country", "NO")
    Call first.AddOption("country", "DK")
    Call first.SetRequired("existing", True)
    Call first.SetRequired("country", True)
    Call first.SetLength("existing", 3, 100)
    Call first.SetLength("notes", 0, 2000)
    Call first.SetLength("password", 8, 128)
    Call first.SetNumberRange("age", 0, 150)
    Call first.SetRegexValidation("existing", "^[A-Za-z ]+$")
    Call first.SetDateRange("birthday", "2020-01-01", "2030-12-31")

    Print "VALIDATION_CONFIGURED=True"
    Print "REGEX_VALIDATION_CONFIGURED=True"
    Print "DATE_RANGE_CONFIGURED=True"
    Print "FIELD_COUNT=" & CStr(first.FieldCount)
    Print "BOUND_EXISTING=" & first.GetFieldValueString("existing")
    Print "BOUND_MISSING=" & first.GetFieldValueString("missing")
    Print "BOUND_AGE=" & first.GetFieldValueString("age")
    Print "BOUND_ENABLED=" & first.GetFieldValueString("enabled")
    Print "BOUND_BIRTHDAY=" & first.GetFieldValueString("birthday")
    Print "BOUND_COUNTRY=" & first.GetFieldValueString("country")
    Print "MISSING_EXISTS_INITIAL=" & CStr(data.Contains("missing"))
    Print "NOTES_EXISTS_INITIAL=" & CStr(data.Contains("notes"))
    Print "PASSWORD_EXISTS_INITIAL=" & CStr(data.Contains("password"))

    Call first.SetFieldValue("missing", "")
    Call first.SetFieldValue("notes", "")
    Call first.SetFieldValue("password", "")
    Print "MISSING_EXISTS_AFTER_EMPTY=" & CStr(data.Contains("missing"))
    Print "NOTES_EXISTS_AFTER_EMPTY=" & CStr(data.Contains("notes"))
    Print "PASSWORD_EXISTS_AFTER_EMPTY=" & CStr(data.Contains("password"))

    Call first.SetFieldValue("missing", "Created by user")
    Call first.SetFieldValue("notes", "Longer text")
    Print "MISSING_EXISTS_AFTER_VALUE=" & CStr(data.Contains("missing"))
    Print "NOTES_EXISTS_AFTER_VALUE=" & CStr(data.Contains("notes"))
    Print "MISSING_VALUE=" & CStr(data.Get("missing"))
    Print "NOTES_VALUE=" & CStr(data.Get("notes"))
    Print "JSON_DATA=" & data.Stringify()
End Sub
