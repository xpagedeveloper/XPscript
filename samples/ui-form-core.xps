' XPScript UIForm core and JSON binding regression
' (c) xpagedeveloper.com 2026

Sub Main()
    Dim first As New UIForm("First", 640, 480, True)
    Dim second As New UIForm("Second")
    Dim data As New XPJsonObject

    Print "FIRST_TITLE=" & first.Title
    Print "FIRST_WIDTH=" & CStr(first.Width)
    Print "FIRST_HEIGHT=" & CStr(first.Height)
    Print "FIRST_RESIZABLE=" & CStr(first.Resizable)
    Print "FIRST_HAS_SIZE=" & CStr(first.HasExplicitSize)

    Print "SECOND_TITLE=" & second.Title
    Print "SECOND_WIDTH=" & CStr(second.Width)
    Print "SECOND_HEIGHT=" & CStr(second.Height)
    Print "SECOND_HAS_SIZE=" & CStr(second.HasExplicitSize)

    first.Title = "Changed"
    first.Width = 800
    first.Height = 600
    first.Resizable = False

    Print "FIRST_CHANGED_TITLE=" & first.Title
    Print "FIRST_CHANGED_WIDTH=" & CStr(first.Width)
    Print "FIRST_CHANGED_HEIGHT=" & CStr(first.Height)
    Print "FIRST_CHANGED_RESIZABLE=" & CStr(first.Resizable)
    Print "SECOND_STILL_TITLE=" & second.Title

    Call data.Set("existing", "Loaded from JSON")
    Call data.Set("age", 42)
    Call data.Set("enabled", True)
    Call data.Set("birthday", "2026-08-18")
    Call data.Set("country", "SE")
    Call first.BindData(data)
    Call first.AddTextField("existing", "Existing")
    Call first.AddTextField("missing", "Missing")
    Call first.AddTextArea("notes", "Notes")
    Call first.AddNumberField("age", "Age")
    Call first.AddCheckBox("enabled", "Enabled")
    Call first.AddDateField("birthday", "Birthday")
    Call first.AddPasswordField("password", "Password")
    Call first.AddSelect("country", "Country")
    Call first.AddOption("country", "SE")
    Call first.AddOption("country", "NO")
    Call first.AddOption("country", "DK")
    Call first.SetRequired("existing", True)
    Call first.SetRequired("country", True)
    Call first.SetLength("existing", 3, 100)
    Call first.SetLength("notes", 0, 2000)
    Call first.SetLength("password", 8, 128)
    Call first.SetNumberRange("age", 0, 150)
    Call first.SetRegexValidation("existing", "^[A-Za-z ]+$")
    Call first.SetDateRange("birthday", "2020-01-01", "2030-12-31")

    Print "VALIDATION_CONFIGURED=True"
    Print "REGEX_VALIDATION_CONFIGURED=True"
    Print "DATE_RANGE_CONFIGURED=True"
    Print "FIELD_COUNT=" & CStr(first.FieldCount)
    Print "BOUND_EXISTING=" & first.GetFieldValueString("existing")
    Print "BOUND_MISSING=" & first.GetFieldValueString("missing")
    Print "BOUND_AGE=" & first.GetFieldValueString("age")
    Print "BOUND_ENABLED=" & first.GetFieldValueString("enabled")
    Print "BOUND_BIRTHDAY=" & first.GetFieldValueString("birthday")
    Print "BOUND_COUNTRY=" & first.GetFieldValueString("country")
    Print "MISSING_EXISTS_INITIAL=" & CStr(data.Contains("missing"))
    Print "NOTES_EXISTS_INITIAL=" & CStr(data.Contains("notes"))
    Print "PASSWORD_EXISTS_INITIAL=" & CStr(data.Contains("password"))

    Call first.SetFieldValue("missing", "")
    Call first.SetFieldValue("notes", "")
    Call first.SetFieldValue("password", "")
    Print "MISSING_EXISTS_AFTER_EMPTY=" & CStr(data.Contains("missing"))
    Print "NOTES_EXISTS_AFTER_EMPTY=" & CStr(data.Contains("notes"))
    Print "PASSWORD_EXISTS_AFTER_EMPTY=" & CStr(data.Contains("password"))

    Call first.SetFieldValue("missing", "Created by user")
    Call first.SetFieldValue("notes", "Longer text")
    Print "MISSING_EXISTS_AFTER_VALUE=" & CStr(data.Contains("missing"))
    Print "NOTES_EXISTS_AFTER_VALUE=" & CStr(data.Contains("notes"))
    Print "MISSING_VALUE=" & CStr(data.Get("missing"))
    Print "NOTES_VALUE=" & CStr(data.Get("notes"))
    Print "JSON_DATA=" & data.Stringify()
End Sub
