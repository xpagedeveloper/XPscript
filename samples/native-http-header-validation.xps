Option Declare

Sub Main()
    Dim http As New XPHttpClient
    Dim response As XPHttpResponse
    Dim errCode As Integer

    On Error Resume Next
    Call http.SetHeader("Bad Header", "value")
    errCode = Err
    On Error GoTo 0
    If errCode = 0 Then
        Print "BAD-NAME-NOT-REJECTED"
    Else
        Print "BAD-NAME-ERR=" & CStr(errCode)
    End If

    On Error Resume Next
    Call http.SetHeader("X-Test", "safe" & Chr(13) & Chr(10) & "Injected: yes")
    errCode = Err
    On Error GoTo 0
    If errCode = 0 Then
        Print "BAD-VALUE-NOT-REJECTED"
    Else
        Print "BAD-VALUE-ERR=" & CStr(errCode)
    End If

    On Error Resume Next
    Call http.SetHeader("Content-Length", "1")
    errCode = Err
    On Error GoTo 0
    If errCode = 0 Then
        Print "BAD-FRAMING-NOT-REJECTED"
    Else
        Print "BAD-FRAMING-ERR=" & CStr(errCode)
    End If

    On Error Resume Next
    Set response = http.Get("file:///etc/passwd")
    errCode = Err
    On Error GoTo 0
    If errCode = 0 Then
        Print "BAD-SCHEME-NOT-REJECTED"
    Else
        Print "BAD-SCHEME-ERR=" & CStr(errCode)
    End If

    On Error Resume Next
    Set response = http.Get("http://127.0.0.1:18080/")
    errCode = Err
    On Error GoTo 0
    If errCode = 0 Then
        Print "PRIVATE-TARGET-NOT-REJECTED"
    Else
        Print "PRIVATE-TARGET-ERR=" & CStr(errCode)
    End If

    Call http.SetHeader("X-Valid-Header", "valid-value")
    Print "VALID-HEADER=OK"
End Sub
