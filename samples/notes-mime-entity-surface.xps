' Runtime probe for native MIME create, save, reopen, and a known HTML MIME document.
Sub Main()
    Const KNOWN_HTML_MIME_UNID = "100EC86E73301B37C1258BB20034683C"

    Dim session As New NotesSession()
    Dim db As NotesDatabase
    Dim doc As NotesDocument
    Dim reopened As NotesDocument
    Dim knownHtml As NotesDocument
    Dim mime As NotesMIMEEntity
    Dim unid As String

    session.ConvertMIME = False
    Set db = session.OpenDatabase("", "mail.nsf")

    Print "MIME create/reopen probe: creating document"
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "Memo")
    Call doc.ReplaceItemValue("Subject", "XPScript native MIME create/reopen probe")
    Call doc.ReplaceItemValue("XPScriptMarker", "notes-mime-entity-surface")

    Set mime = doc.CreateMIMEEntity("Body")
    If mime Is Nothing Then
        Print "FAIL: CreateMIMEEntity returned Nothing"
    Else
        Print "Created MIME ContentType: " & mime.ContentType
        Print "Created MIME ContentSubType: " & mime.ContentSubType
        Print "Created MIME Charset: " & mime.Charset
    End If

    Call doc.CloseMIMEEntities()
    Set mime = Nothing

    Call doc.Save()
    unid = doc.UniversalID
    Print "Saved MIME document: " & unid

    Call doc.Recycle()
    Set doc = Nothing

    Print "MIME create/reopen probe: reopening document"
    Set reopened = db.GetDocumentByUNID(unid)
    If reopened Is Nothing Then
        Print "FAIL: saved document could not be reopened"
    Else
        Set mime = reopened.GetMIMEEntity("Body")
        If mime Is Nothing Then
            Print "FAIL: reopened Body is not MIME"
        Else
            Print "Reopened MIME ContentType: " & mime.ContentType
            Print "Reopened MIME ContentSubType: " & mime.ContentSubType
            Print "Reopened MIME Charset: " & mime.Charset

            If mime.ContentType = "text" Then
                Print "PASS: ContentType is text"
            Else
                Print "FAIL: ContentType is " & mime.ContentType
            End If

            If mime.ContentSubType = "plain" Then
                Print "PASS: ContentSubType is plain"
            Else
                Print "FAIL: ContentSubType is " & mime.ContentSubType
            End If

            If mime.Charset = "UTF-8" Then
                Print "PASS: Charset is UTF-8"
            Else
                Print "FAIL: Charset is " & mime.Charset
            End If
        End If

        Call reopened.CloseMIMEEntities()
        Set mime = Nothing
        Call reopened.Recycle()
        Set reopened = Nothing
    End If

    Print "Known HTML MIME probe: " & KNOWN_HTML_MIME_UNID
    Set knownHtml = db.GetDocumentByUNID(KNOWN_HTML_MIME_UNID)
    If knownHtml Is Nothing Then
        Print "FAIL: known HTML MIME document could not be opened"
    Else
        Set mime = knownHtml.GetMIMEEntity("Body")
        If mime Is Nothing Then
            Print "FAIL: known HTML Body is not MIME"
        Else
            Print "Known HTML MIME ContentType: " & mime.ContentType
            Print "Known HTML MIME ContentSubType: " & mime.ContentSubType
            Print "Known HTML MIME Charset: " & mime.Charset

            If mime.ContentType = "text" Then
                Print "PASS: known HTML ContentType is text"
            Else
                Print "FAIL: known HTML ContentType is " & mime.ContentType
            End If

            If mime.ContentSubType = "html" Then
                Print "PASS: known HTML ContentSubType is html"
            Else
                Print "FAIL: known HTML ContentSubType is " & mime.ContentSubType
            End If
        End If

        Call knownHtml.CloseMIMEEntities()
        Set mime = Nothing
        Call knownHtml.Recycle()
        Set knownHtml = Nothing
    End If

    Call db.Recycle()
    Set db = Nothing

    session.ConvertMIME = True
    Call session.Recycle()
    Set session = Nothing

    Print "MIME create/reopen probe: completed"
End Sub
