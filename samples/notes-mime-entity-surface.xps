' Runtime probe for MIME on the first ten documents in the mail inbox.
Sub Main()
    Dim session As New NotesSession()
    Dim db As NotesDatabase
    Dim view As NotesView
    Dim doc As NotesDocument
    Dim mime As NotesMIMEEntity
    Dim count As Integer

    session.ConvertMIME = False
    Set db = session.OpenDatabase("", "mail.nsf")
    Set view = db.GetView("($Inbox)")

    If view Is Nothing Then
        Print "MIME probe: ($Inbox) view not found"
    Else
        Set doc = view.GetFirstDocument()
        count = 0

        Do While Not(doc Is Nothing) And count < 10
            count = count + 1
            Print "Document " & count & ": " & doc.UniversalID

            Set mime = doc.GetMIMEEntity("Body")
            If mime Is Nothing Then
                Print "  Body: not MIME"
            Else
                Print "  Body: MIME"
                Print "  ContentType: " & mime.ContentType
                Print "  ContentSubType: " & mime.ContentSubType
                Print "  Charset: " & mime.Charset
            End If

            Call doc.CloseMIMEEntities()
            Set mime = Nothing

            ' GetNextDocument advances the view navigation state. Do not recycle the
            ' current document here because the returned navigation object can share
            ' the same runtime wrapper/handle lifecycle.
            Set doc = view.GetNextDocument(doc)
        Loop

        Print "MIME probe: inspected " & count & " inbox documents"
        Set doc = Nothing
        Call view.Recycle()
        Set view = Nothing
    End If

    Call db.Recycle()
    Set db = Nothing

    session.ConvertMIME = True
    Call session.Recycle()
    Set session = Nothing

    Print "MIME probe: completed"
End Sub
