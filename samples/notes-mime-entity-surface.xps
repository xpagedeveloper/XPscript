' Compile/runtime surface probe for the currently native-backed NotesMIMEEntity surface.
Sub Main()
    Dim session As New NotesSession(".")
    Dim db As NotesDatabase
    Dim doc As NotesDocument
    Dim item As NotesItem
    Dim mime As NotesMIMEEntity
    Dim itemMime As NotesMIMEEntity
    Dim createdMime As NotesMIMEEntity
    Dim child As NotesMIMEEntity
    Dim sibling As NotesMIMEEntity

    session.ConvertMIME = False
    Set db = session.OpenDatabase("", "mail.nsf")
    Set doc = db.GetDocumentByNoteId("00000000")
    If Not(doc Is Nothing) Then
        Set mime = doc.GetMIMEEntity("Body")
        If Not(mime Is Nothing) Then
            Print mime.ContentType
            Print mime.ContentSubType
            Print mime.Charset
            Print mime.BoundaryStart
            Print mime.BoundaryEnd

            Set child = mime.GetFirstChildEntity()
            If Not(child Is Nothing) Then
                Print child.ContentType
                Print child.ContentSubType
                Print child.Charset
                Set sibling = child.GetNextSibling()
                Set child = child.GetNextEntity(NotesConst.SEARCH_DEPTH)
            End If
        End If

        Set item = doc.GetFirstItem("Body")
        If Not(item Is Nothing) Then
            Set itemMime = item.GetMIMEEntity()
        End If
        Call doc.CloseMIMEEntities()

        ' CreateMIMEEntity is currently Body-only because MIMEOpenDirectory is note-level.
        ' Keep this compile-only because a real document may already contain Body.
        If False Then
            Set createdMime = doc.CreateMIMEEntity("Body")
        End If
    End If
    session.ConvertMIME = True
End Sub
