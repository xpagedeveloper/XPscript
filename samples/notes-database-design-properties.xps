' Verifies NotesDatabase design-element properties.
Option Declare

Sub Main()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim agents As Variant
    Dim forms As Variant
    Dim views As Variant
    Dim agentCount As Integer
    Dim formCount As Integer
    Dim viewCount As Integer

    Set session = New NotesSession()
    Set db = session.OpenDatabase("", "testdb.nsf")
    If Not db.IsOpen Then Error 53, "Unable to open testdb.nsf"

    agents = db.Agents
    forms = db.Forms
    views = db.Views

    ForAll agent In agents
        agentCount = agentCount + 1
        Print "AGENT=" & agent.Name
    End ForAll
    Print "AGENTS=" & CStr(agentCount)

    ForAll formName In forms
        formCount = formCount + 1
        Print "FORM=" & formName
    End ForAll
    Print "FORMS=" & CStr(formCount)

    ForAll view In views
        viewCount = viewCount + 1
        Print "VIEW=" & view.Name
        Call view.Recycle()
    End ForAll
    Print "VIEWS=" & CStr(viewCount)

    Call db.Recycle()
    Call session.Recycle()
End Sub
