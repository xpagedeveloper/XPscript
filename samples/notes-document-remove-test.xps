' NotesDocument.Remove local smoke test.
' Requires local xpscript.nsf and write access.

Option Declare

Sub Main()
    Const NOTES_RUNTIME = "C:\Program Files\HCL\Notes"
    Const LOCAL_DATABASE = "xpscript.nsf"

    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim doc As NotesDocument
    Dim checkDoc As NotesDocument
    Dim unid As String
    Dim removed As Boolean

    Print "NOTESDOCUMENT-REMOVE-TEST-BEGIN"

    Set session = New NotesSession(NOTES_RUNTIME)
    Set db = session.OpenDatabase("", LOCAL_DATABASE)

    If db = Nothing Or Not db.IsOpen Then
        Print "FAIL: xpscript.nsf is not open"
        GoTo Cleanup
    End If

    ' Default force=False overload.
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptRemoveTest")
    Call doc.ReplaceItemValue("Subject", "Remove default False test")
    Call doc.Save()
    unid = doc.UniversalId

    removed = doc.Remove()
    Print "RemoveDefault.Result=" & CStr(removed)

    Set checkDoc = db.GetDocumentByUNID(unid)
    Print "RemoveDefault.DocumentMissing=" & CStr(checkDoc = Nothing)
    If checkDoc <> Nothing Then
        Call checkDoc.Recycle()
        Set checkDoc = Nothing
    End If
    Call doc.Recycle()
    Set doc = Nothing

    ' Explicit force=True path.
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptRemoveTest")
    Call doc.ReplaceItemValue("Subject", "Remove force True test")
    Call doc.Save()
    unid = doc.UniversalId

    removed = doc.Remove(True)
    Print "RemoveForceTrue.Result=" & CStr(removed)

    Set checkDoc = db.GetDocumentByUNID(unid)
    Print "RemoveForceTrue.DocumentMissing=" & CStr(checkDoc = Nothing)

    Print "NOTESDOCUMENT-REMOVE-TEST-END"

Cleanup:
    If checkDoc <> Nothing Then Call checkDoc.Recycle()
    If doc <> Nothing Then Call doc.Recycle()
    If db <> Nothing Then Call db.Recycle()
    If session <> Nothing Then Call session.Recycle()
End Sub
