' XPscript UIListView target form showcase
' (c) xpagedeveloper.com 2026

[Anonymous]
[Get]
[Post]
Sub Main()
    Dim data As New JsonObject
    Dim form As New UIForm("Customer", 720, 420, True)
    Dim grid As Variant
    Dim customerId As String
    Dim result As String

    customerId = CStr(Request.State.Get("customerId"))
    If customerId = "" Then
        customerId = "new"
    End If

    Call data.Set("id", customerId)
    Call data.Set("name", "Customer " & customerId)
    Call data.Set("status", "Loaded from UIListView")

    Call form.BindData(data)
    Call form.AddHiddenField("id")
    Call form.AddTextField("name", "Name")
    Call form.AddTextField("status", "Status")
    Call form.SetFieldReadOnly("status", True)

    Set grid = form.AddGridColumns(12)
    Call grid.SetFieldPosition("name", 6)
    Call grid.AddNewRow()
    Call grid.SetFieldPosition("status", 12)

    result = form.ShowDialog()
    If result = "OK" Then
        Print "CUSTOMER_ID=" & data.Get("id")
        Print "NAME=" & data.Get("name")
    End If
End Sub
