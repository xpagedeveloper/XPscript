Declare Function NativeDouble Lib "native-null-abi" (ByVal value As Double) As Double
Declare Function NativeSingle Lib "native-null-abi" (ByVal value As Single) As Single
Declare Function NativeBoolean Lib "native-null-abi" (ByVal value As Boolean) As Boolean
Declare Function NativeByte Lib "native-null-abi" (ByVal value As Byte) As Byte
