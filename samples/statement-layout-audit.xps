Declare Function NativeProcessId Lib "native-process" _
    WindowsLib "kernel32.dll" WindowsAlias "GetCurrentProcessId" _
    LinuxLib "libc.so.6" LinuxAlias "getpid" _
    MacOSLib "libSystem.B.dylib" MacOSAlias "getpid" _
    () As Integer

Class BaseBox
    Public Value As Integer
End Class

Class ChildBox As _
    BaseBox

    Public Function Twice( _
        value As Integer _
    ) As Integer
        Twice = value * 2
    End Function

    Public Property Get Current _
        As Integer
        Current = Me.Value
    End Property
End Class

Function AddValues( _
    leftValue As Integer, _
    rightValue As Integer _
) As Integer
    AddValues = leftValue + rightValue
End Function

Sub Main()
    Dim total As Integer
    Dim i As Integer
    Dim box As New ChildBox
    Dim names List As String
    Dim forallCount As Integer

    total = AddValues( _
        1, _
        2 _
    )
    If total <> 3 Then
        Print "FUNCTION_BAD"
        Exit Sub
    End If
    Print "FUNCTION_CALL=OK"

    names.Append("one")
    names.Append("two")
    ForAll name In names
        forallCount = forallCount + 1
    End ForAll
    Print "FORALL=" & CStr(forallCount)

    For i = _
        1 _
        To 2
        total = total + i
    Next
    Print "FOR=" & CStr(total)

    i = 0
    Do
        i = i + 1
    Loop While _
        i < 2
    Print "LOOP_WHILE=" & CStr(i)

    i = 0
    Do
        i = i + 1
    Loop Until _
        i >= 2
    Print "LOOP_UNTIL=" & CStr(i)

    Select Case _
        total
    Case 1
        Print "SELECT_BAD"
    Case 2 To _
        3
        Print "SELECT=OK"
    Case Else
        Print "SELECT_BAD"
    End Select

    box.Value = 7
    With box
        .Value = .Value + 1
        Print "WITH=" & CStr(.Value)
    End With

    Print "FUNCTION=" & CStr(box.Twice( _
        4 _
    ))
    Print "PROPERTY=" & CStr(box.Current)
    Print "DECLARE=COMPILED"
End Sub