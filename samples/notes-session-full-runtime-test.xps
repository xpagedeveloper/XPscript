' Focused NotesSession full runtime regression.
Option Declare

Sub Main()
    Dim session As NotesSession
    Dim failures As Integer
    Dim hashedPassword As String

    failures = 0
    Set session = New NotesSession()

    If session Is Nothing Then
        Print "NOTES-SESSION-FULL=FAIL COUNT=1"
        Exit Sub
    End If

    If session.IsRecycled Then
        Print "FAIL IsRecycled expected False before Recycle"
        failures = failures + 1
    End If

    session.ConvertMIME = False
    If session.ConvertMIME Then
        Print "FAIL ConvertMIME expected False after assignment"
        failures = failures + 1
    End If

    session.ConvertMIME = True
    If Not session.ConvertMIME Then
        Print "FAIL ConvertMIME expected True after assignment"
        failures = failures + 1
    End If

    hashedPassword = session.HashPassword("XPscript-password-test")
    If hashedPassword = "" Then
        Print "FAIL HashPassword returned an empty digest"
        failures = failures + 1
    End If

    If Not session.VerifyPassword("XPscript-password-test", hashedPassword) Then
        Print "FAIL VerifyPassword rejected the correct password"
        failures = failures + 1
    End If

    If session.VerifyPassword("XPscript-password-test-wrong", hashedPassword) Then
        Print "FAIL VerifyPassword accepted an incorrect password"
        failures = failures + 1
    End If

    Forall addressBook In session.AddressBooks
        Print "AddressBook=" & addressBook.Server & "!!" & addressBook.FilePath
        If addressBook.IsOpen Then
            Print "FAIL AddressBooks must return closed NotesDatabase objects"
            failures = failures + 1
        End If
        Call addressBook.Recycle()
    End Forall

    Call session.Recycle()
    If Not session.IsRecycled Then
        Print "FAIL IsRecycled expected True after Recycle"
        failures = failures + 1
    End If

    If failures = 0 Then
        Print "NOTES-SESSION-FULL=PASS"
    Else
        Print "NOTES-SESSION-FULL=FAIL COUNT=" & CStr(failures)
    End If
End Sub
