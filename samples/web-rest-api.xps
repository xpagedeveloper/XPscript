Option Declare

Public Class CreateUserRequest
    [Required]
    Public Name As String

    [Required]
    [Email]
    Public Email As String
End Class

[Anonymous]
[Get]
[Route:/api/users/{id}]
Sub GetUser(ByVal id As Integer)
    Dim data As New XPJsonObject
    Call data.Set("id", id)
    Call data.Set("name", "Ada")
    Response.OK(data)
End Sub

[Anonymous]
[Post]
[Route:/api/users]
Sub CreateUser([FromBody] payload As CreateUserRequest)
    Response.Created("/api/users/1", payload)
End Sub

[Anonymous]
[Delete]
[Route:/api/users/{id}]
Sub DeleteUser(ByVal id As Integer)
    Response.NoContent()
End Sub

[Anonymous]
[Get]
[Route:/api/problem/{kind}]
Sub ProblemDemo(ByVal kind As String)
    Dim status As Long
    Select Case kind
    Case "bad-request"
        Response.BadRequest("Invalid request")
    Case "unauthorized"
        Response.Unauthorized("Authentication required")
    Case "forbidden"
        Response.Forbidden("Access denied")
    Case "conflict"
        Response.Conflict("Resource conflict")
    Case Else
        status = 500
        Response.Problem(status, "Demo problem", "Example Problem Details response")
    End Select
End Sub
