Sub Main()
    Dim leftDate As Date
    Dim rightDate As Date
    Dim textValue As String
    Dim a As Integer

    a = 1
    If a = 1 Then Print "SINGLE_VALUE=KALLE"
    If a = 1 Then Print "SINGLE_IF_ELSE=1" Else Print "SINGLE_IF_ELSE=2"
    a = 2
    If a = 1 Then Print "SINGLE_IF_ELSE_BAD" Else Print "SINGLE_IF_ELSE_FALSE=2"

    If True Then Print "SINGLE=OK"
    If False Then Print "SINGLE_TRUE_BAD" Else Print "SINGLE_ELSE=OK"

    textValue = "Else"
    If textValue = "Else" Then Print "STRING_ELSE=OK"

    If True Then
        Print "BLOCK=OK"
    End If

    If False Then
        Print "MULTILINE_BAD"
    ElseIf True Then
        Print "MULTILINE_ELSEIF=OK"
    Else
        Print "MULTILINE_BAD"
    End If

    If True
    Then
        Print "SPLIT_THEN=OK"
    End If

    If False Then
        Print "ELSEIF_BAD"
    ElseIf True
    Then
        Print "SPLIT_ELSEIF=OK"
    Else
        Print "ELSEIF_BAD"
    End If

    If False Then
        Print "INLINE_ELSEIF_BAD"
    ElseIf True Then Print "INLINE_ELSEIF=OK"
    Else
        Print "INLINE_ELSEIF_BAD"
    End If

    leftDate = DateNumber(2026, 8, 12)
    rightDate = DateNumber(2026, 8, 13)
    If leftDate < rightDate Then Print "DATE_SINGLE=OK"
End Sub
