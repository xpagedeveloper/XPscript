Sub Main()
    Dim leftDate As Date
    Dim rightDate As Date
    Dim textValue As String

    If True Then Print "SINGLE=OK"
    If False Then Print "SINGLE_TRUE_BAD" Else Print "SINGLE_ELSE=OK"
    If False Then Print "ONE_LINE_BAD" ElseIf True Then Print "ONE_LINE_ELSEIF=OK" Else Print "ONE_LINE_BAD" End If
    If True Then Print "ONE_LINE_IF=OK" ElseIf False Then Print "ONE_LINE_BAD" Else Print "ONE_LINE_BAD" End If
    If False Then Print "ONE_LINE_BAD" ElseIf False Then Print "ONE_LINE_BAD" Else Print "ONE_LINE_ELSE=OK" End If

    textValue = "Else"
    If textValue = "Else" Then Print "STRING_ELSE=OK"

    If True Then
        Print "BLOCK=OK"
    End If

    If False Then
        Print "MULTILINE_BAD"
    ElseIf True Then
        Print "MULTILINE_ELSEIF=OK"
    Else
        Print "MULTILINE_BAD"
    End If

    If True
    Then
        Print "SPLIT_THEN=OK"
    End If

    If False Then
        Print "ELSEIF_BAD"
    ElseIf True
    Then
        Print "SPLIT_ELSEIF=OK"
    Else
        Print "ELSEIF_BAD"
    End If

    If False Then
        Print "INLINE_ELSEIF_BAD"
    ElseIf True Then Print "INLINE_ELSEIF=OK"
    Else
        Print "INLINE_ELSEIF_BAD"
    End If

    If False Then Print "MIXED_BAD"
    ElseIf True Then
        Print "MIXED_ELSEIF=OK"
    Else Print "MIXED_BAD"
    End If

    leftDate = DateNumber(2026, 8, 12)
    rightDate = DateNumber(2026, 8, 13)
    If leftDate < rightDate Then Print "DATE_SINGLE=OK"
End Sub
