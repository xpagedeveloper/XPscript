' Regression: malformed numeric input must not be echoed and retained structural diagnostics are length-limited.

Sub Main()
    Dim result As Variant
    Dim longName As String
    Dim malformed As String
    Dim evaluateErr As Integer
    Dim evaluateMessage As String

    malformed = "123e+"

    On Error Resume Next
    result = Evaluate("Return " & malformed)
    evaluateErr = Err
    evaluateMessage = Error$
    On Error GoTo 0
    If evaluateErr <> 5 Then
        Error 9401, "Malformed numeric literal should use error 5, got " & CStr(evaluateErr)
    End If
    If Instr(evaluateMessage, malformed) > 0 Then
        Error 9402, "Malformed numeric literal leaked into Evaluate diagnostic"
    End If

    longName = String(700, "A")
    On Error Resume Next
    result = Evaluate("Return " & longName)
    evaluateErr = Err
    evaluateMessage = Error$
    On Error GoTo 0
    If evaluateErr <> 5 Then
        Error 9403, "Oversized structural diagnostic should use error 5, got " & CStr(evaluateErr)
    End If
    If Len(evaluateMessage) <> 515 Then
        Error 9404, "Evaluate structural diagnostic must be exactly 515 characters, got " & CStr(Len(evaluateMessage))
    End If
    If Right$(evaluateMessage, 3) <> "..." Then
        Error 9405, "Evaluate structural diagnostic must end with ellipsis"
    End If
    If Instr(evaluateMessage, "Unknown identifier in Evaluate scope: ") <> 1 Then
        Error 9406, "Expected retained structural unknown-identifier diagnostic"
    End If

    Print "EVALUATE-DIAGNOSTIC-EDGE=OK"
End Sub
