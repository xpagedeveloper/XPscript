' (c) xpagedeveloper.com 2026
' Regression: malformed input and source-controlled identifiers must not be echoed.

Sub Main()
    Dim result As Variant
    Dim longName As String
    Dim malformed As String
    Dim evaluateErr As Integer
    Dim evaluateMessage As String

    malformed = "123e+"

    On Error Resume Next
    result = Evaluate("Return " & malformed)
    evaluateErr = Err
    evaluateMessage = Error$
    On Error GoTo 0
    If evaluateErr <> 5 Then
        Error 9401, "Malformed numeric literal should use error 5, got " & CStr(evaluateErr)
    End If
    If Instr(evaluateMessage, malformed) > 0 Then
        Error 9402, "Malformed numeric literal leaked into Evaluate diagnostic"
    End If

    longName = String(700, "A")
    On Error Resume Next
    result = Evaluate("Return " & longName)
    evaluateErr = Err
    evaluateMessage = Error$
    On Error GoTo 0
    If evaluateErr <> 5 Then
        Error 9403, "Unknown identifier should use error 5, got " & CStr(evaluateErr)
    End If
    If evaluateMessage <> "Evaluate source contains an invalid identifier." Then
        Error 9404, "Expected generic unknown-identifier diagnostic"
    End If
    If Instr(evaluateMessage, longName) > 0 Then
        Error 9405, "Evaluate identifier leaked into diagnostic"
    End If

    On Error Resume Next
    result = Evaluate("Return SecretFunctionName123(1)")
    evaluateErr = Err
    evaluateMessage = Error$
    On Error GoTo 0
    If evaluateErr <> 5 Then
        Error 9406, "Unavailable function should use error 5, got " & CStr(evaluateErr)
    End If
    If evaluateMessage <> "Evaluate source contains an unavailable function." Then
        Error 9407, "Expected generic unavailable-function diagnostic"
    End If
    If Instr(evaluateMessage, "SecretFunctionName123") > 0 Then
        Error 9408, "Evaluate function name leaked into diagnostic"
    End If

    Print "EVALUATE-DIAGNOSTIC-EDGE=OK"
End Sub
