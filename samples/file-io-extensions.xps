Option Declare

Sub Main()
    Dim f As Integer
    Dim part As String
    Dim line As String
    Dim lockPayload As String

    If Command = "hold-lock" Then
        f = FreeFile
        lockPayload = "ABCDEF"
        Open "xpscript-lock-test.bin" For Binary As #f
        Put #f, 1, lockPayload
        Lock #f, 1 To 3
        Print "LOCKHELD"
        Sleep 4
        Unlock #f, 1 To 3
        Close #f
        Print "LOCKRELEASED"
        Exit Sub
    End If

    ' Explicit Latin-1 text round trip.
    f = FreeFile
    Open "xpscript-latin1.txt" For Output As #f Charset "latin1"
    Print #f, "ÅÄÖ-é"
    Close #f

    f = FreeFile
    Open "xpscript-latin1.txt" For Input As #f Charset "latin1"
    part = Input$(3, #f)
    Print "FILEINPUT=" & part
    Line Input #f, line
    Print "LATIN1REST=" & line
    Close #f

    ' Binary Input$ must use the same defined XPScript Latin-1 byte mapping.
    f = FreeFile
    Open "xpscript-latin1.txt" For Binary As #f
    part = Input$(3, #f)
    Print "BINARYINPUT=" & part
    Close #f

    ' Lock/Unlock operate on the underlying OS file handle.
    f = FreeFile
    Open "xpscript-latin1.txt" For Binary As #f
    Lock #f, 1 To 3
    Print "LOCK=OK"
    Unlock #f, 1 To 3
    Print "UNLOCK=OK"
    Close #f

    If Platform = "Windows" Then
        ChDrive "C"
        Print "CHDRIVE=" & Left(CurDir, 3)
    Else
        Print "CHDRIVE=SKIPPED"
    End If

    Kill "xpscript-latin1.txt"
End Sub
