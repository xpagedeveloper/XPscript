' Regression: exactly 16 MiB estimated payload is accepted; the first byte above is rejected.

Sub Main()
    Dim accepted As String
    Dim rejected As String
    Dim result As Variant

    accepted = String(16777216, "A")
    result = Evaluate("Return Len(callvar)", ByVal accepted)
    If CInt(result) <> 16777216 Then
        Error 9601, "Evaluate exact payload budget changed the accepted String"
    End If

    rejected = String(16777217, "A")

    On Error GoTo ExpectedError
    result = Evaluate("Return Len(callvar)", ByVal rejected)
    Error 9602, "Expected Evaluate to reject payload above 16 MiB"

ExpectedError:
    If Err <> 5 Then
        Error 9603, "Expected XPScript error 5 but got " & CStr(Err)
    End If
    If Instr(Error$, "maximum estimated payload budget of 16777216 bytes") = 0 Then
        Error 9604, "Expected exact Evaluate payload-budget diagnostic"
    End If
    Print "PAYLOAD-BOUNDARY=OK"
End Sub
