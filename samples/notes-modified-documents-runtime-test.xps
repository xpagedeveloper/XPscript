' Runtime/compile regression for NotesDatabase.GetModifiedDocuments.
' Requires an open local xpscript.nsf for runtime execution.
Option Declare

Sub Main()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim since As NotesDateTime
    Dim changed As NotesDocumentCollection
    Dim numericAll As NotesDocumentCollection
    Dim documents As NotesDocumentCollection
    Dim design As NotesDocumentCollection
    Dim doc As NotesDocument

    Set session = New NotesSession()
    Set db = session.OpenDatabase("", "xpscript.nsf")
    If db Is Nothing Or Not db.IsOpen Then
        Print "NOTES-MODIFIED=SKIP xpscript.nsf is not open"
        Exit Sub
    End If

    Set since = session.CreateDateTimeNow()
    Call since.AdjustHour(-1)

    ' Regression: the literal Domino DBMOD_DOC_ALL value must be accepted.
    Set numericAll = db.GetModifiedDocuments(since, 32767)
    If numericAll Is Nothing Then Error 9959, "GetModifiedDocuments(since, 32767) returned Nothing"
    Print "MODIFIED-32767=" & CStr(numericAll.Count)

    ' The NotesConst alias must have identical behavior.
    Set changed = db.GetModifiedDocuments(since, NotesConst.All)
    If changed Is Nothing Then Error 9960, "GetModifiedDocuments(since, NotesConst.All) returned Nothing"
    If changed.Count <> numericAll.Count Then Error 9961, "NotesConst.All differs from literal 32767"

    Set documents = changed.Documents
    Set design = changed.DesignElements

    Print "MODIFIED-ALL=" & CStr(changed.Count)
    Print "MODIFIED-DOCUMENTS=" & CStr(documents.Count)
    Print "MODIFIED-DESIGN=" & CStr(design.Count)
    Print "UNTIL=" & changed.UntilTime.LocalTime

    If documents.Count + design.Count > changed.Count Then
        Error 9962, "Filtered modified collections exceed the complete collection"
    End If

    Set doc = documents.GetFirstDocument()
    If Not doc Is Nothing Then
        If doc.IsDesign Then Error 9963, "Documents filter returned a design note"
        Print "FIRST-DOCUMENT=" & doc.NoteID
        Call doc.Recycle()
    End If

    Set doc = design.GetFirstDocument()
    If Not doc Is Nothing Then
        If Not doc.IsDesign Then Error 9964, "DesignElements filter returned a data note"
        Print "FIRST-DESIGN=" & doc.DesignType & " " & doc.DesignTitle
        Call doc.Recycle()
    End If

    Set documents = db.GetModifiedDocuments(since, NotesConst.Data)
    Print "MODIFIED-DATA-ONLY=" & CStr(documents.Count)

    Call design.Recycle()
    Call documents.Recycle()
    Call changed.Recycle()
    Call numericAll.Recycle()
    Call since.Recycle()
    Call db.Recycle()
    Call session.Recycle()
    Print "NOTES-MODIFIED=PASS"
End Sub
