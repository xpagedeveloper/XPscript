  <agent name="XPScriptTestAgent" publicaccess="false" designerversion="14.5"><trigger type="agentlist"/><code event="action"><formula>@True</formula></code></agent>

  <document form="XPScriptTest"><item name="Form"><text>XPScriptTest</text></item><item name="Subject"><text>Alpha</text></item><item name="XPScriptMarker"><text>fixture-alpha</text></item><item name="XPScriptGroup"><text>Group A</text></item><item name="TextList"><textlist><text>one</text><text>two</text><text>three</text></textlist></item><item name="NumberValue"><number>12.5</number></item><item name="Body"><richtext><pardef id="1"/><par def="1">XPscript rich text fixture Alpha</par></richtext></item></document>
