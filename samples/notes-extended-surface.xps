' Compile-time regression for NotesStream, NotesAgent, NotesNoteCollection and modified-note collections.
Option Declare

Sub Main()
    Const DBMOD_DOC_ALL = 32767
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim stream As NotesStream
    Dim agent As NotesAgent
    Dim nc As NotesNoteCollection
    Dim exporter As NotesDXLExporter
    Dim since As NotesDateTime
    Dim changed As NotesDocumentCollection
    Dim changedDocuments As NotesDocumentCollection
    Dim changedDesign As NotesDocumentCollection

    Set session = New NotesSession()
    Set stream = session.CreateStream()
    stream.Charset = "UTF-8"
    Call stream.WriteText("surface")
    stream.Position = 0
    Print stream.ReadText()

    Set db = session.OpenDatabase("", "xpscript.nsf")
    Set agent = db.GetAgent("XPScriptTestAgent")
    If Not agent Is Nothing Then
        Print agent.Name
        Print agent.Owner
        Print agent.Trigger
        Print agent.Target
    End If

    Set nc = db.CreateNoteCollection(False)
    nc.SelectDocuments = True
    Call nc.BuildCollection()
    Set exporter = session.CreateDXLExporter()
    Call exporter.Export(nc, "out/notes-dxl/extended-surface.dxl")

    Set since = session.CreateDateTimeNow()
    Call since.AdjustHour(-1)
    Set changed = db.GetModifiedDocuments(since, DBMOD_DOC_ALL)
    If Not changed Is Nothing Then
        Print changed.Count
        If Not changed.UntilTime Is Nothing Then Print changed.UntilTime.LocalTime
        Set changedDocuments = changed.Documents
        Set changedDesign = changed.DesignElements
        Print changedDocuments.Count
        Print changedDesign.Count
        Call changedDesign.Recycle()
        Call changedDocuments.Recycle()
        Call changed.Recycle()
    End If

    Call since.Recycle()
    Call exporter.Recycle()
    Call nc.Recycle()
    If Not agent Is Nothing Then Call agent.Recycle()
    Call db.Recycle()
    Call stream.Recycle()
    Call session.Recycle()
End Sub
