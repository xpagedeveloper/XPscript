Sub Main()
    Dim trueSchema As XPJsonSchema
    Set trueSchema = XPJsonSchema.Parse("true")
    If Not trueSchema.IsValid(37) Then Error 5, "Expected true schema to accept scalar values"
    If Not trueSchema.IsValid("Ada") Then Error 5, "Expected true schema to accept string values"

    Dim falseSchema As XPJsonSchema
    Set falseSchema = XPJsonSchema.Parse("false")
    If falseSchema.IsValid(37) Then Error 5, "Expected false schema to reject scalar values"

    Dim propertySchema As XPJsonSchema
    Set propertySchema = XPJsonSchema.Parse("{""type"":""object"",""properties"":{""allowed"":true,""forbidden"":false}}")
    Dim allowedObject As XPJsonDocument
    Set allowedObject = XPJsonDocument.Parse("{""allowed"":123}")
    If Not propertySchema.IsValid(allowedObject) Then Error 5, "Expected true property schema to accept any property value"
    Dim forbiddenObject As XPJsonDocument
    Set forbiddenObject = XPJsonDocument.Parse("{""forbidden"":123}")
    If propertySchema.IsValid(forbiddenObject) Then Error 5, "Expected false property schema to reject a present property"

    Dim itemsSchema As XPJsonSchema
    Set itemsSchema = XPJsonSchema.Parse("{""type"":""array"",""prefixItems"":[true,false],""items"":false}")
    Dim validTuple As New XPJsonArray
    Call validTuple.Add("first")
    If Not itemsSchema.IsValid(validTuple) Then Error 5, "Expected true prefix schema to accept the first item"
    Dim invalidTuple As New XPJsonArray
    Call invalidTuple.Add("first")
    Call invalidTuple.Add("second")
    If itemsSchema.IsValid(invalidTuple) Then Error 5, "Expected false prefix schema to reject the second item"

    Dim anyOfSchema As XPJsonSchema
    Set anyOfSchema = XPJsonSchema.Parse("{""anyOf"":[false,{""type"":""integer""}]}")
    If Not anyOfSchema.IsValid(37) Then Error 5, "Expected anyOf to evaluate boolean schema branches"
    If anyOfSchema.IsValid("Ada") Then Error 5, "Expected anyOf false branch not to count as a match"

    Dim notFalseSchema As XPJsonSchema
    Set notFalseSchema = XPJsonSchema.Parse("{""not"":false}")
    If Not notFalseSchema.IsValid(37) Then Error 5, "Expected not false to accept every value"

    Print "XPJSONSCHEMA-BOOLEAN-RUNTIME=OK"
End Sub
