Option Declare

Sub Main()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim doc As NotesDocument
    Dim item As NotesItem
    Dim richText As NotesRichTextItem
    Dim maybeRichText As NotesRichTextItem

    Set session = New NotesSession("C:\Program Files\HCL\Notes")

    session.ConvertMIME = False
    Print "ConvertMIME=" & CStr(session.ConvertMIME)
    session.ConvertMIME = True

    Set db = session.OpenDatabase("", "names.nsf")
    Set doc = db.CreateDocument()

    Set richText = doc.CreateRichTextItem("Body")
    Call richText.AppendText("Hello from XPscript rich text")

    Set item = doc.GetFirstItem("Body")
    If Not item Is Nothing Then
        Set maybeRichText = item.GetRichTextItem()
        If Not maybeRichText Is Nothing Then
            Print "RichText=" & maybeRichText.Text
        End If
    End If

    Set item = doc.ReplaceItemValue("Subject", "Plain text")
    Set maybeRichText = item.GetRichTextItem()
    If maybeRichText Is Nothing Then Print "NonRichText=Nothing"

    Call doc.Recycle()
    Call db.Recycle()
    Call session.Recycle()
End Sub
