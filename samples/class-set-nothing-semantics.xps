Class ClearProbe
    Public Name As String

    Public Sub New(ByVal value As String)
        Name = value
    End Sub

    Public Sub Delete()
        Print "DELETE_CALLED"
    End Sub
End Class

Sub Main()
    Dim primary As ClearProbe
    Dim aliasRef As ClearProbe

    Set primary = New ClearProbe("alive")
    Set aliasRef = primary
    Set primary = Nothing

    If primary Is Nothing Then Print "PRIMARY_NOTHING=YES"
    If aliasRef Is Nothing Then
        Print "ALIAS_NOTHING=YES"
    Else
        Print "ALIAS_NAME=" & aliasRef.Name
    End If
End Sub
