' Requires xpscript.nsf with the standard CWF fixture forms.
Option Declare
Sub Main()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim ok As Boolean
    Dim errorCode As Long
    Set session = New NotesSession()
    Set db = session.OpenDatabase("", "xpscript.nsf")
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptCWFValid")
    failedFields = "sentinel"
    ok = doc.ComputeWithForm(False, False, failedFields)
    If Not ok Then Error 5, "Valid form failed"
    If failedFields Is Not Nothing Then Error 5, "Valid form did not clear output"
    If doc.GetString("CWFDefault") <> "DEFAULT-VALUE" Then Error 5, "Default field not computed"
    Call doc.Recycle()
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptCWFErrors")
    failedFields = "sentinel"
    ok = doc.ComputeWithForm(False, False, failedFields)
    If ok Then Error 5, "Invalid form unexpectedly passed"
    If failedFields Is Not Nothing Then Error 5, "Non-raising validation did not clear output"
    On Error Resume Next
    Call doc.ComputeWithForm(False, True, failedFields)
    errorCode = Err
    On Error GoTo 0
    If errorCode <> 5 Then Error 5, "Raising validation must report error 5"
    If failedFields Is Nothing Then Error 5, "Failed fields did not survive validation error"
    If UBound(failedFields) < LBound(failedFields) Then Error 5, "Failed fields array is empty"
    Call doc.Recycle()
    Call db.Recycle()
    Call session.Recycle()
    Print "NOTES-CWF-BYREF=PASS"
End Sub
