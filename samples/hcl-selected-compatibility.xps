Option Declare

Sub Assert(condition As Boolean, message As String)
    If Not condition Then
        Error 5, message
    End If
End Sub

Sub Main()
    Dim source As Variant
    Dim replaced As Variant
    Dim cleaned As Variant
    Dim evaluated As Variant
    Dim singleValue As Single
    Dim firstRnd As Single
    Dim repeatedRnd As Single
    Dim negativeA As Single
    Dim negativeB As Single
    Dim ole As Variant
    Dim fileNumber As Integer
    Dim inputText As String
    Dim inputPath As String
    Dim matrix(1 To 2, 3 To 4) As String
    Dim matrixResult As Variant

    source = Array("alpha", "beta", "alpha")
    replaced = ArrayReplace(source, "alpha", "x")
    Call Assert(Implode(replaced, ",") = "x,beta,x", "ArrayReplace/Implode failed")

    matrix(1, 3) = "a"
    matrix(1, 4) = "b"
    matrix(2, 3) = "a"
    matrix(2, 4) = "c"
    matrixResult = ArrayReplace(matrix, "a", "z")
    Call Assert(LBound(matrixResult, 1) = 1, "ArrayReplace lower bound dimension 1 failed")
    Call Assert(UBound(matrixResult, 1) = 2, "ArrayReplace upper bound dimension 1 failed")
    Call Assert(LBound(matrixResult, 2) = 3, "ArrayReplace lower bound dimension 2 failed")
    Call Assert(UBound(matrixResult, 2) = 4, "ArrayReplace upper bound dimension 2 failed")
    Call Assert(matrixResult(1, 3) = "z", "ArrayReplace multidimensional replacement failed")
    Call Assert(matrixResult(2, 4) = "c", "ArrayReplace multidimensional preservation failed")

    cleaned = FullTrim(Array("  one   two  ", "", " three "))
    Call Assert(Implode(cleaned, "|") = "one two|three", "FullTrim array failed")
    Call Assert(FullTrim("  one   two  ") = "one two", "FullTrim string failed")

    evaluated = Execute("Return 2 + 3")
    Call Assert(CInt(evaluated) = 5, "Execute alias failed")

    Call Assert(UString(3, 65) = "AAA", "UString numeric code failed")
    Call Assert(UString(2, "xyz") = "xx", "UString string failed")

    singleValue = 1.25
    Call Assert(Len(singleValue) = 4, "Len numeric storage size failed")
    Call Assert(LenB(singleValue) = 4, "LenB numeric storage size failed")
    Call Assert(LenB("alphabet") = 16, "LenB Unicode string size failed")

    Call Assert(LenBP("ABCDE") = 5, "LenBP failed")
    Call Assert(LeftBP("ABCDE", 2) = "AB", "LeftBP failed")
    Call Assert(RightBP("ABCDE", 2) = "DE", "RightBP failed")
    Call Assert(MidBP("ABCDE", 2, 3) = "BCD", "MidBP failed")
    Call Assert(InStrBP("ABCDE", "CD") = 3, "InStrBP failed")

    inputPath = "hcl-inputbp-regression.txt"
    fileNumber = FreeFile
    Open inputPath For Output As #fileNumber
    Print #fileNumber, "ABCDE"
    Close #fileNumber
    fileNumber = FreeFile
    Open inputPath For Binary As #fileNumber
    inputText = InputBP(3, fileNumber)
    Close #fileNumber
    Kill inputPath
    Call Assert(inputText = "ABC", "InputBP file read failed")

    Call Assert(LenC("A" & UChr(769) & "B") = 2, "LenC combining-character failed")
    Call Assert(LeftC("A" & UChr(769) & "B", 1) = "A" & UChr(769), "LeftC failed")
    Call Assert(RightC("A" & UChr(769) & "B", 1) = "B", "RightC failed")
    Call Assert(MidC("A" & UChr(769) & "BC", 2, 2) = "BC", "MidC failed")
    Call Assert(InStrC("A" & UChr(769) & "BC", "B") = 2, "InStrC failed")

    Randomize 123
    firstRnd = Rnd
    repeatedRnd = Rnd(0)
    Call Assert(firstRnd = repeatedRnd, "Rnd(0) did not return previous value")
    negativeA = Rnd(-99)
    negativeB = Rnd(-99)
    Call Assert(negativeA = negativeB, "Rnd(negative) did not reseed deterministically")

    If Platform() = "Windows" Then
        Call Assert(Len(CurDrive) = 2, "CurDrive failed on Windows")
        ole = CreateObject("Scripting.Dictionary")
        Call Assert(IsObject(ole), "CreateObject failed")
    Else
        Call Assert(CurDrive = "", "CurDrive must be empty on non-Windows")
    End If

    Print "HCL_SELECTED_COMPATIBILITY=OK"
End Sub
