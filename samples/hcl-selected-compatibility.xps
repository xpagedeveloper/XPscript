Option Declare

Sub Main()
    Dim source As Variant
    Dim replaced As Variant
    Dim cleaned As Variant
    Dim evaluated As Variant
    Dim singleValue As Single
    Dim firstRnd As Single
    Dim repeatedRnd As Single
    Dim negativeA As Single
    Dim negativeB As Single
    Dim ole As Variant
    Dim fileNumber As Integer
    Dim inputText As String
    Dim inputPath As String
    Dim matrix(1 To 2, 3 To 4) As String
    Dim matrixResult As Variant

    source = Array("alpha", "beta", "alpha")
    replaced = ArrayReplace(source, "alpha", "x")
    If Implode(replaced, ",") <> "x,beta,x" Then
        Error 5, "ArrayReplace/Implode failed"
    End If

    matrix(1, 3) = "a"
    matrix(1, 4) = "b"
    matrix(2, 3) = "a"
    matrix(2, 4) = "c"
    matrixResult = ArrayReplace(matrix, "a", "z")
    If LBound(matrixResult, 1) <> 1 Then
        Error 5, "ArrayReplace lower bound dimension 1 failed"
    End If
    If UBound(matrixResult, 1) <> 2 Then
        Error 5, "ArrayReplace upper bound dimension 1 failed"
    End If
    If LBound(matrixResult, 2) <> 3 Then
        Error 5, "ArrayReplace lower bound dimension 2 failed"
    End If
    If UBound(matrixResult, 2) <> 4 Then
        Error 5, "ArrayReplace upper bound dimension 2 failed"
    End If
    If matrixResult(1, 3) <> "z" Then
        Error 5, "ArrayReplace multidimensional replacement failed"
    End If
    If matrixResult(2, 4) <> "c" Then
        Error 5, "ArrayReplace multidimensional preservation failed"
    End If

    cleaned = FullTrim(Array("  one   two  ", "", " three "))
    If Implode(cleaned, "|") <> "one two|three" Then
        Error 5, "FullTrim array failed"
    End If
    If CStr(FullTrim("  one   two  ")) <> "one two" Then
        Error 5, "FullTrim string failed"
    End If

    evaluated = Execute("Return 2 + 3")
    If CInt(evaluated) <> 5 Then
        Error 5, "Execute alias failed"
    End If

    If UString(3, 65) <> "AAA" Then
        Error 5, "UString numeric code failed"
    End If
    If UString(2, "xyz") <> "xx" Then
        Error 5, "UString string failed"
    End If

    singleValue = CSng(1.25)
    If Len(singleValue) <> 4 Then
        Error 5, "Len numeric storage size failed"
    End If
    If LenB(singleValue) <> 4 Then
        Error 5, "LenB numeric storage size failed"
    End If
    If LenB("alphabet") <> 16 Then
        Error 5, "LenB Unicode string size failed"
    End If

    If LenBP("ABCDE") <> 5 Then
        Error 5, "LenBP failed"
    End If
    If LeftBP("ABCDE", 2) <> "AB" Then
        Error 5, "LeftBP failed"
    End If
    If RightBP("ABCDE", 2) <> "DE" Then
        Error 5, "RightBP failed"
    End If
    If MidBP("ABCDE", 2, 3) <> "BCD" Then
        Error 5, "MidBP failed"
    End If
    If InStrBP("ABCDE", "CD") <> 3 Then
        Error 5, "InStrBP failed"
    End If

    inputPath = "hcl-inputbp-regression.txt"
    fileNumber = FreeFile
    Open inputPath For Output As #fileNumber
    Print #fileNumber, "ABCDE"
    Close #fileNumber
    fileNumber = FreeFile
    Open inputPath For Binary As #fileNumber
    inputText = InputBP(3, fileNumber)
    Close #fileNumber
    Kill inputPath
    If inputText <> "ABC" Then
        Error 5, "InputBP file read failed"
    End If

    If LenC("A" & UChr(769) & "B") <> 2 Then
        Error 5, "LenC combining-character failed"
    End If
    If LeftC("A" & UChr(769) & "B", 1) <> "A" & UChr(769) Then
        Error 5, "LeftC failed"
    End If
    If RightC("A" & UChr(769) & "B", 1) <> "B" Then
        Error 5, "RightC failed"
    End If
    If MidC("A" & UChr(769) & "BC", 2, 2) <> "BC" Then
        Error 5, "MidC failed"
    End If
    If InStrC("A" & UChr(769) & "BC", "B") <> 2 Then
        Error 5, "InStrC failed"
    End If

    Randomize 123
    firstRnd = Rnd
    repeatedRnd = Rnd(0)
    If firstRnd <> repeatedRnd Then
        Error 5, "Rnd(0) did not return previous value"
    End If
    negativeA = Rnd(-99)
    negativeB = Rnd(-99)
    If negativeA <> negativeB Then
        Error 5, "Rnd(negative) did not reseed deterministically"
    End If

    If IsDefined("SOME_UNKNOWN_XPSCRIPT_CONSTANT") Then
        Error 5, "IsDefined unknown constant failed"
    End If
    If Platform() = "Windows" Then
        If Not IsDefined("WINDOWS") Then
            Error 5, "IsDefined WINDOWS failed"
        End If
        If Not IsDefined("WIN32") Then
            Error 5, "IsDefined WIN32 failed"
        End If
        If Not IsDefined("OLE") Then
            Error 5, "IsDefined OLE failed"
        End If
        If IsDefined("UNIX") Then
            Error 5, "IsDefined UNIX failed on Windows"
        End If
        If Len(CurDrive) <> 2 Then
            Error 5, "CurDrive failed on Windows"
        End If
        ole = CreateObject("Scripting.Dictionary")
        If Not IsObject(ole) Then
            Error 5, "CreateObject failed"
        End If
    Else
        If Not IsDefined("UNIX") Then
            Error 5, "IsDefined UNIX failed"
        End If
        If IsDefined("WINDOWS") Then
            Error 5, "IsDefined WINDOWS failed on Unix"
        End If
        If Platform() = "Linux" Then
            If Not IsDefined("LINUX") Then
                Error 5, "IsDefined LINUX failed"
            End If
        End If
        If CurDrive <> "" Then
            Error 5, "CurDrive must be empty on non-Windows"
        End If
    End If

    Print "HCL_SELECTED_COMPATIBILITY=OK"
End Sub
