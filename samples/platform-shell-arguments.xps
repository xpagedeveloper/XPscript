Sub Main()
    Dim Result As String

    Print "PLATFORM-CALL=" & Platform()
    Print "PLATFORM-BARE=" & Platform

    Result = Shell("dotnet --version")
    If Len(Result) > 0 Then
        Print "SHELL-CAPTURE=OK"
    Else
        Print "SHELL-CAPTURE=EMPTY"
    End If

    If Platform() = "Windows" Then
        Call Shell("\"./shell test åäö/shell-args-helper.cmd\" \"space value\" \"\" \"brackets-$[]{}\"")
        Call Shell("\"./shell test åäö/shell-args-helper.ps1\" \"unicode-åäö-漢字\" \"space value\" \"\"")
    ElseIf Platform() = "Linux" Or Platform() = "MacOS" Then
        Call Shell("\"./shell test åäö/shell-args-helper.sh\" \"space value\" \"unicode-åäö-漢字\" \"\" \"brackets-$[]{}\"")
        Call Shell("\"./shell test åäö/shell-args-helper.ps1\" \"unicode-åäö-漢字\" \"space value\" \"\"")
    End If
End Sub
