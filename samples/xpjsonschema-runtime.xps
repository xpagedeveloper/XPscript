Sub Main()
    Dim schema As New XPJsonSchema
    schema.Type = "object"
    schema.Title = "Person"
    schema.Description = "Person validation schema"
    schema.AddString("name", True)
    schema.AddInteger("age", True)
    schema.AddBoolean("active", False)
    schema.AdditionalProperties = False

    Dim validJson As XPJsonDocument
    Set validJson = XPJsonDocument.Parse("{""name"":""Ada"",""age"":37,""active"":true}")
    Dim validResult As XPJsonValidationResult
    Set validResult = schema.Validate(validJson)
    If Not validResult.Valid Then Error 5, "Expected valid JSON to satisfy schema"
    If validResult.ErrorCount <> 0 Then Error 5, "Expected zero validation errors"
    If validResult.Errors.Count <> 0 Then Error 5, "Expected empty validation error collection"

    Dim invalidJson As XPJsonDocument
    Set invalidJson = XPJsonDocument.Parse("{""name"":""Ada""}")
    Dim invalidResult As XPJsonValidationResult
    Set invalidResult = schema.Validate(invalidJson)
    If invalidResult.Valid Then Error 5, "Expected missing required age to fail validation"
    If invalidResult.ErrorCount = 0 Then Error 5, "Expected validation errors for invalid JSON"
    If invalidResult.Errors.Count <> invalidResult.ErrorCount Then Error 5, "Expected Errors.Count to match ErrorCount"
    If invalidResult.Json.Text = "" Then Error 5, "Expected validation result JSON"

    ' FromJson infers a schema from XPJson data.
    Dim inferred As XPJsonSchema
    Set inferred = XPJsonSchema.FromJson(validJson)
    If Not inferred.IsValid(validJson) Then Error 5, "Expected inferred schema to validate its source JSON"

    ' Parse reads an existing JSON Schema document.
    Dim parsed As XPJsonSchema
    Set parsed = XPJsonSchema.Parse("{""type"":""object"",""properties"":{""name"":{""type"":""string""}},""required"":[""name""],""additionalProperties"":false}")
    Dim parsedJson As XPJsonDocument
    Set parsedJson = XPJsonDocument.Parse("{""name"":""Ada""}")
    If Not parsed.IsValid(parsedJson) Then Error 5, "Expected parsed schema to validate matching JSON"
    If parsed.IsValid(validJson) Then Error 5, "Expected parsed schema to reject additional properties"

    ' Composition keywords follow JSON Schema applicator semantics.
    Dim allOfSchema As XPJsonSchema
    Set allOfSchema = XPJsonSchema.Parse("{""allOf"":[{""type"":""integer""},{""minimum"":10}]}")
    If Not allOfSchema.IsValid(12) Then Error 5, "Expected allOf to accept value satisfying every branch"
    If allOfSchema.IsValid(8) Then Error 5, "Expected allOf to reject value failing one branch"

    Dim anyOfSchema As XPJsonSchema
    Set anyOfSchema = XPJsonSchema.Parse("{""anyOf"":[{""type"":""string""},{""type"":""integer""}]}")
    If Not anyOfSchema.IsValid("Ada") Then Error 5, "Expected anyOf to accept matching string branch"
    If Not anyOfSchema.IsValid(37) Then Error 5, "Expected anyOf to accept matching integer branch"
    If anyOfSchema.IsValid(True) Then Error 5, "Expected anyOf to reject value matching no branch"

    Dim oneOfSchema As XPJsonSchema
    Set oneOfSchema = XPJsonSchema.Parse("{""oneOf"":[{""type"":""number""},{""type"":""integer""}]}")
    If Not oneOfSchema.IsValid(1.5) Then Error 5, "Expected oneOf to accept exactly one matching branch"
    If oneOfSchema.IsValid(1) Then Error 5, "Expected oneOf to reject value matching multiple branches"

    Dim notSchema As XPJsonSchema
    Set notSchema = XPJsonSchema.Parse("{""not"":{""type"":""string""}}")
    If Not notSchema.IsValid(37) Then Error 5, "Expected not to accept a non-matching value"
    If notSchema.IsValid("Ada") Then Error 5, "Expected not to reject a matching value"

    Print "XPJSONSCHEMA-RUNTIME=OK"
End Sub
