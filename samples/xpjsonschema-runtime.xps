Sub Main()
    Dim schema As New XPJsonSchema
    schema.Type = "object"
    schema.Title = "Person"
    schema.Description = "Person validation schema"
    schema.AddString("name", True)
    schema.AddInteger("age", True)
    schema.AddBoolean("active", False)
    schema.AdditionalProperties = False

    Dim validJson As XPJsonDocument
    Set validJson = XPJsonDocument.Parse("{""name"":""Ada"",""age"":37,""active"":true}")
    Dim validResult As XPJsonValidationResult
    Set validResult = schema.Validate(validJson)
    If Not validResult.Valid Then Error 5, "Expected valid JSON to satisfy schema"
    If validResult.ErrorCount <> 0 Then Error 5, "Expected zero validation errors"
    If validResult.Errors.Count <> 0 Then Error 5, "Expected empty validation error collection"

    Dim invalidJson As XPJsonDocument
    Set invalidJson = XPJsonDocument.Parse("{""name"":""Ada""}")
    Dim invalidResult As XPJsonValidationResult
    Set invalidResult = schema.Validate(invalidJson)
    If invalidResult.Valid Then Error 5, "Expected missing required age to fail validation"
    If invalidResult.ErrorCount = 0 Then Error 5, "Expected validation errors for invalid JSON"
    If invalidResult.Errors.Count <> invalidResult.ErrorCount Then Error 5, "Expected Errors.Count to match ErrorCount"
    If invalidResult.Json.Stringify() = "" Then Error 5, "Expected validation result JSON"

    Dim inferred As XPJsonSchema
    Set inferred = XPJsonSchema.FromJson(validJson)
    If Not inferred.IsValid(validJson) Then Error 5, "Expected inferred schema to validate its source JSON"

    Dim parsed As XPJsonSchema
    Set parsed = XPJsonSchema.Parse("{""type"":""object"",""properties"":{""name"":{""type"":""string""}},""required"":[""name""],""additionalProperties"":false}")
    Dim parsedJson As XPJsonDocument
    Set parsedJson = XPJsonDocument.Parse("{""name"":""Ada""}")
    If Not parsed.IsValid(parsedJson) Then Error 5, "Expected parsed schema to validate matching JSON"
    If parsed.IsValid(validJson) Then Error 5, "Expected parsed schema to reject additional properties"

    Dim closedObject As XPJsonSchema
    Set closedObject = XPJsonSchema.Parse("{""type"":""object"",""additionalProperties"":false}")
    Dim emptyObject As XPJsonDocument
    Set emptyObject = XPJsonDocument.Parse("{}")
    Dim objectWithProperty As XPJsonDocument
    Set objectWithProperty = XPJsonDocument.Parse("{""unexpected"":1}")
    If Not closedObject.IsValid(emptyObject) Then Error 5, "Expected closed empty object schema to accept an empty object"
    If closedObject.IsValid(objectWithProperty) Then Error 5, "Expected additionalProperties=false to reject undeclared properties without a properties keyword"

    Dim allOfSchema As XPJsonSchema
    Set allOfSchema = XPJsonSchema.Parse("{""allOf"":[{""type"":""integer""},{""minimum"":10}]}")
    If Not allOfSchema.IsValid(12) Then Error 5, "Expected allOf to accept value satisfying every branch"
    If allOfSchema.IsValid(8) Then Error 5, "Expected allOf to reject value failing one branch"

    Dim anyOfSchema As XPJsonSchema
    Set anyOfSchema = XPJsonSchema.Parse("{""anyOf"":[{""type"":""string""},{""type"":""integer""}]}")
    If Not anyOfSchema.IsValid("Ada") Then Error 5, "Expected anyOf to accept matching string branch"
    If Not anyOfSchema.IsValid(37) Then Error 5, "Expected anyOf to accept matching integer branch"
    If anyOfSchema.IsValid(True) Then Error 5, "Expected anyOf to reject value matching no branch"

    Dim oneOfSchema As XPJsonSchema
    Set oneOfSchema = XPJsonSchema.Parse("{""oneOf"":[{""type"":""number""},{""type"":""integer""}]}")
    If Not oneOfSchema.IsValid(1.5) Then Error 5, "Expected oneOf to accept exactly one matching branch"
    If oneOfSchema.IsValid(1) Then Error 5, "Expected oneOf to reject value matching multiple branches"

    Dim notSchema As XPJsonSchema
    Set notSchema = XPJsonSchema.Parse("{""not"":{""type"":""string""}}")
    If Not notSchema.IsValid(37) Then Error 5, "Expected not to accept a non-matching value"
    If notSchema.IsValid("Ada") Then Error 5, "Expected not to reject a matching value"

    Dim propertyCountSchema As XPJsonSchema
    Set propertyCountSchema = XPJsonSchema.Parse("{""type"":""object"",""minProperties"":1,""maxProperties"":2}")
    Dim oneProperty As XPJsonDocument
    Set oneProperty = XPJsonDocument.Parse("{""a"":1}")
    Dim threeProperties As XPJsonDocument
    Set threeProperties = XPJsonDocument.Parse("{""a"":1,""b"":2,""c"":3}")
    If propertyCountSchema.IsValid(emptyObject) Then Error 5, "Expected minProperties to reject an empty object"
    If Not propertyCountSchema.IsValid(oneProperty) Then Error 5, "Expected property count inside bounds to validate"
    If propertyCountSchema.IsValid(threeProperties) Then Error 5, "Expected maxProperties to reject an oversized object"

    Dim uniqueItemsSchema As XPJsonSchema
    Set uniqueItemsSchema = XPJsonSchema.Parse("{""type"":""array"",""uniqueItems"":true}")
    Dim uniqueValues As New XPJsonArray
    Call uniqueValues.Add(1)
    Call uniqueValues.Add(2)
    Call uniqueValues.Add(3)
    If Not uniqueItemsSchema.IsValid(uniqueValues) Then Error 5, "Expected uniqueItems to accept distinct values"

    Dim duplicateValues As New XPJsonArray
    Call duplicateValues.Add(1)
    Call duplicateValues.Add(2)
    Call duplicateValues.Add(1)
    If uniqueItemsSchema.IsValid(duplicateValues) Then Error 5, "Expected uniqueItems to reject duplicate values"

    Dim duplicateObjects As New XPJsonArray
    Dim duplicateObject1 As New XPJsonObject
    Dim duplicateObject2 As New XPJsonObject
    Call duplicateObject1.Set("id", 1)
    Call duplicateObject2.Set("id", 1)
    Call duplicateObjects.Add(duplicateObject1)
    Call duplicateObjects.Add(duplicateObject2)
    If uniqueItemsSchema.IsValid(duplicateObjects) Then Error 5, "Expected uniqueItems to compare structured JSON values"

    Dim numericBoundsSchema As XPJsonSchema
    Set numericBoundsSchema = XPJsonSchema.Parse("{""type"":""number"",""exclusiveMinimum"":1,""exclusiveMaximum"":10}")
    If numericBoundsSchema.IsValid(1) Then Error 5, "Expected exclusiveMinimum to reject its boundary"
    If Not numericBoundsSchema.IsValid(1.5) Then Error 5, "Expected exclusive numeric bounds to accept an interior value"
    If numericBoundsSchema.IsValid(10) Then Error 5, "Expected exclusiveMaximum to reject its boundary"

    Dim multipleOfSchema As XPJsonSchema
    Set multipleOfSchema = XPJsonSchema.Parse("{""type"":""number"",""multipleOf"":0.5}")
    If Not multipleOfSchema.IsValid(2.5) Then Error 5, "Expected multipleOf to accept an exact decimal multiple"
    If multipleOfSchema.IsValid(2.6) Then Error 5, "Expected multipleOf to reject a non-multiple"

    Dim containsSchema As XPJsonSchema
    Set containsSchema = XPJsonSchema.Parse("{""type"":""array"",""contains"":{""type"":""integer"",""minimum"":10},""minContains"":2,""maxContains"":3}")
    Dim containsValid As New XPJsonArray
    Call containsValid.Add(10)
    Call containsValid.Add(12)
    Call containsValid.Add("skip")
    If Not containsSchema.IsValid(containsValid) Then Error 5, "Expected contains/minContains to accept two matching items"
    Dim containsTooFew As New XPJsonArray
    Call containsTooFew.Add(10)
    Call containsTooFew.Add(2)
    If containsSchema.IsValid(containsTooFew) Then Error 5, "Expected minContains to reject too few matching items"
    Dim containsTooMany As New XPJsonArray
    Call containsTooMany.Add(10)
    Call containsTooMany.Add(11)
    Call containsTooMany.Add(12)
    Call containsTooMany.Add(13)
    If containsSchema.IsValid(containsTooMany) Then Error 5, "Expected maxContains to reject too many matching items"

    Dim dependencySchema As XPJsonSchema
    Set dependencySchema = XPJsonSchema.Parse("{""type"":""object"",""dependentRequired"":{""creditCard"":[""billingAddress""]}}")
    Dim noCreditCard As XPJsonDocument
    Set noCreditCard = XPJsonDocument.Parse("{""name"":""Ada""}")
    If Not dependencySchema.IsValid(noCreditCard) Then Error 5, "Expected dependentRequired to be inactive without its trigger"
    Dim completePayment As XPJsonDocument
    Set completePayment = XPJsonDocument.Parse("{""creditCard"":""1234"",""billingAddress"":""Stockholm""}")
    If Not dependencySchema.IsValid(completePayment) Then Error 5, "Expected dependentRequired to accept complete dependencies"
    Dim incompletePayment As XPJsonDocument
    Set incompletePayment = XPJsonDocument.Parse("{""creditCard"":""1234""}")
    If dependencySchema.IsValid(incompletePayment) Then Error 5, "Expected dependentRequired to reject a missing dependent property"

    ' dependentSchemas validates the whole object when its trigger is present.
    Dim dependentSchemasSchema As XPJsonSchema
    Set dependentSchemasSchema = XPJsonSchema.Parse("{""type"":""object"",""dependentSchemas"":{""creditCard"":{""required"":[""billingAddress""],""properties"":{""billingAddress"":{""type"":""string""}}}}}")
    If Not dependentSchemasSchema.IsValid(noCreditCard) Then Error 5, "Expected dependentSchemas to be inactive without its trigger"
    If Not dependentSchemasSchema.IsValid(completePayment) Then Error 5, "Expected dependentSchemas to accept a matching dependent schema"
    If dependentSchemasSchema.IsValid(incompletePayment) Then Error 5, "Expected dependentSchemas to reject an invalid triggered object"

    ' if/then/else applies only the selected conditional branch.
    Dim conditionalSchema As XPJsonSchema
    Set conditionalSchema = XPJsonSchema.Parse("{""type"":""object"",""if"":{""properties"":{""country"":{""const"":""SE""}},""required"":[""country""]},""then"":{""required"":[""postalCode""]},""else"":{""required"":[""region""]}}")
    Dim swedishAddress As XPJsonDocument
    Set swedishAddress = XPJsonDocument.Parse("{""country"":""SE"",""postalCode"":""11122""}")
    If Not conditionalSchema.IsValid(swedishAddress) Then Error 5, "Expected then branch to accept a Swedish address with postalCode"
    Dim invalidSwedishAddress As XPJsonDocument
    Set invalidSwedishAddress = XPJsonDocument.Parse("{""country"":""SE""}")
    If conditionalSchema.IsValid(invalidSwedishAddress) Then Error 5, "Expected then branch to require postalCode"
    Dim foreignAddress As XPJsonDocument
    Set foreignAddress = XPJsonDocument.Parse("{""country"":""US"",""region"":""CA""}")
    If Not conditionalSchema.IsValid(foreignAddress) Then Error 5, "Expected else branch to accept a non-Swedish address with region"
    Dim invalidForeignAddress As XPJsonDocument
    Set invalidForeignAddress = XPJsonDocument.Parse("{""country"":""US""}")
    If conditionalSchema.IsValid(invalidForeignAddress) Then Error 5, "Expected else branch to require region"

    Dim propertyNamesSchema As XPJsonSchema
    Set propertyNamesSchema = XPJsonSchema.Parse("{""type"":""object"",""propertyNames"":{""pattern"":""^[a-z]+$""}}")
    Dim validPropertyNames As XPJsonDocument
    Set validPropertyNames = XPJsonDocument.Parse("{""name"":1,""age"":2}")
    If Not propertyNamesSchema.IsValid(validPropertyNames) Then Error 5, "Expected propertyNames to accept matching names"
    Dim invalidPropertyNames As XPJsonDocument
    Set invalidPropertyNames = XPJsonDocument.Parse("{""valid"":1,""BadName"":2}")
    If propertyNamesSchema.IsValid(invalidPropertyNames) Then Error 5, "Expected propertyNames to reject a non-matching name"

    Dim patternPropertiesSchema As XPJsonSchema
    Set patternPropertiesSchema = XPJsonSchema.Parse("{""type"":""object"",""patternProperties"":{""^S_"":{""type"":""string""},""^I_"":{""type"":""integer""}},""additionalProperties"":false}")
    Dim validPatternProperties As XPJsonDocument
    Set validPatternProperties = XPJsonDocument.Parse("{""S_name"":""Ada"",""I_age"":37}")
    If Not patternPropertiesSchema.IsValid(validPatternProperties) Then Error 5, "Expected patternProperties to validate matching properties"
    Dim invalidPatternValue As XPJsonDocument
    Set invalidPatternValue = XPJsonDocument.Parse("{""S_name"":37}")
    If patternPropertiesSchema.IsValid(invalidPatternValue) Then Error 5, "Expected patternProperties to validate matching property values"
    Dim unmatchedPatternProperty As XPJsonDocument
    Set unmatchedPatternProperty = XPJsonDocument.Parse("{""other"":1}")
    If patternPropertiesSchema.IsValid(unmatchedPatternProperty) Then Error 5, "Expected additionalProperties=false to reject properties unmatched by patternProperties"

    Dim additionalPropertiesSchema As XPJsonSchema
    Set additionalPropertiesSchema = XPJsonSchema.Parse("{""type"":""object"",""properties"":{""name"":{""type"":""string""}},""patternProperties"":{""^S_"":{""type"":""string""}},""additionalProperties"":{""type"":""integer""}}")
    Dim validAdditionalProperties As XPJsonDocument
    Set validAdditionalProperties = XPJsonDocument.Parse("{""name"":""Ada"",""S_label"":""ok"",""count"":2}")
    If Not additionalPropertiesSchema.IsValid(validAdditionalProperties) Then Error 5, "Expected additionalProperties schema to validate unmatched properties"
    Dim invalidAdditionalProperty As XPJsonDocument
    Set invalidAdditionalProperty = XPJsonDocument.Parse("{""name"":""Ada"",""count"":""two""}")
    If additionalPropertiesSchema.IsValid(invalidAdditionalProperty) Then Error 5, "Expected additionalProperties schema to reject an invalid unmatched property"
    Dim patternPropertyNotAdditional As XPJsonDocument
    Set patternPropertyNotAdditional = XPJsonDocument.Parse("{""S_label"":""ok""}")
    If Not additionalPropertiesSchema.IsValid(patternPropertyNotAdditional) Then Error 5, "Expected pattern-matched properties not to be revalidated by additionalProperties"

    Dim prefixItemsSchema As XPJsonSchema
    Set prefixItemsSchema = XPJsonSchema.Parse("{""type"":""array"",""prefixItems"":[{""type"":""string""},{""type"":""integer""}],""items"":{""type"":""boolean""}}")
    Dim validTuple As New XPJsonArray
    Call validTuple.Add("Ada")
    Call validTuple.Add(37)
    Call validTuple.Add(True)
    If Not prefixItemsSchema.IsValid(validTuple) Then Error 5, "Expected prefixItems and trailing items to validate a tuple"
    Dim invalidTuplePrefix As New XPJsonArray
    Call invalidTuplePrefix.Add(37)
    Call invalidTuplePrefix.Add(37)
    If prefixItemsSchema.IsValid(invalidTuplePrefix) Then Error 5, "Expected prefixItems to reject an invalid prefix value"
    Dim invalidTupleTail As New XPJsonArray
    Call invalidTupleTail.Add("Ada")
    Call invalidTupleTail.Add(37)
    Call invalidTupleTail.Add("notBoolean")
    If prefixItemsSchema.IsValid(invalidTupleTail) Then Error 5, "Expected items to validate elements after prefixItems"

    Dim dialectSchema As XPJsonSchema
    Set dialectSchema = XPJsonSchema.Parse("{""$schema"":""https://json-schema.org/draft/2020-12/schema""}")
    If Not dialectSchema.IsValid(validJson) Then Error 5, "Expected $schema metadata not to invalidate an instance"

    Print "XPJSONSCHEMA-RUNTIME=OK"
End Sub
