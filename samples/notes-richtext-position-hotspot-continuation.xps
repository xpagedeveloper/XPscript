' Compile-only surface for NotesRichTextNavigator attachment positioning.
Sub Main()
    Dim session As New NotesSession
    Dim db As NotesDatabase
    Dim doc As NotesDocument
    Dim body As NotesRichTextItem
    Dim nav As NotesRichTextNavigator
    Dim embedded As NotesEmbeddedObject

    Set db = session.CurrentDatabase
    Set doc = db.CreateDocument
    Set body = New NotesRichTextItem(doc, "Body")
    Set nav = body.CreateNavigator()
    Set embedded = body.GetEmbeddedObject("missing.bin")
    If Not embedded Is Nothing Then Call nav.SetPositionAtEnd(embedded)
End Sub
