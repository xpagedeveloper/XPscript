Sub Main()
    Dim form As New UIForm("Android Progress API")
    Dim progress = form.AddProgressBar("progress", "Progress")
    progress.Value = 0.5
    progress.IsIndeterminate = False
    Dim activity = form.AddActivityIndicator("loading", "Loading")
    activity.IsRunning = True
    Call Application.Debug.Info("ANDROID-PROGRESS-VALUE=" & progress.Value)
    Call Application.Debug.Info("ANDROID-PROGRESS-INDETERMINATE=" & progress.IsIndeterminate)
    Call Application.Debug.Info("ANDROID-ACTIVITY-RUNNING=" & activity.IsRunning)
    Print "ANDROID-PROGRESS-ACTIVITY-API=ready"
End Sub
