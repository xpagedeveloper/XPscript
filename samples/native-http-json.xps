Option Declare

Sub Main()
    Dim http As New HttpClient
    Dim response As HttpResponse
    Dim document As JsonDocument
    Dim obj As JsonObject
    Dim arr As JsonArray
    Dim text As String

    http.Timeout = 30
    Call http.SetHeader("Accept", "application/json")
    Call http.SetHeader("User-Agent", "XPScript")

    ' Network call example. Keep disabled in local/offline tests unless a test endpoint is configured.
    ' Set response = http.Get("https://example.com/api")
    ' Print response.StatusCode
    ' Print response.StatusText
    ' Print response.Body
    ' Print response.ContentType
    ' Print response.IsSuccess

    Set document = JsonDocument.Parse("{""name"":""Alice"",""roles"":[""admin""]}")
    text = document.Stringify()
    Print "DOCUMENT=" & text

    Set obj = New JsonObject
    Call obj.Set("name", "Fredrik")
    Call obj.Set("enabled", True)
    Print "OBJCOUNT=" & CStr(obj.Count)
    Print "OBJNAME=" & CStr(obj.Get("name"))
    Print "OBJHAS=" & CStr(obj.Contains("enabled"))
    Call obj.Remove("enabled")

    Set arr = New JsonArray
    Call arr.Add("one")
    Call arr.Add("two")
    Call arr.Set(1, "TWO")
    Print "ARRAYCOUNT=" & CStr(arr.Count)
    Print "ARRAYVALUE=" & CStr(arr.Get(1))
    Call arr.RemoveAt(0)

    Print "JSONSTRINGIFY=" & JsonStringify(obj)
    Print "JSONENCODE=" & JsonEncode(arr)
    Set document = JsonDecode("{""ok"":true}")
    Print "JSONDECODE=" & document.Stringify()
End Sub
