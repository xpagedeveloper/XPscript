Private sharedProbe As LazyProbe

Class LazyProbe
    Public Marker As String

    Public Sub New()
        Me.Marker = "ready"
    End Sub
End Class

Function GetProbe() As LazyProbe
    If sharedProbe Is Nothing Then
        Set sharedProbe = New LazyProbe()
    End If
    Set GetProbe = sharedProbe
End Function

Sub Main()
    Print "BEFORE=" & CStr(sharedProbe Is Nothing)

    Dim first As LazyProbe
    Dim second As LazyProbe
    Set first = GetProbe()
    first.Marker = "reused"
    Set second = GetProbe()

    Print "AFTER=" & CStr(sharedProbe Is Nothing)
    Print "FIRST=" & first.Marker
    Print "SECOND=" & second.Marker
End Sub
