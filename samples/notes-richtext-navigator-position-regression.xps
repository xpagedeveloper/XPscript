' Compile-surface regression for rich-text navigator position methods.
' Runtime attachment hotspot traversal is covered by Notes integration tests when available.
Sub Main()
    Dim session As New NotesSession
    Dim db As NotesDatabase
    Dim doc As NotesDocument
    Dim richText As NotesRichTextItem
    Dim nav As NotesRichTextNavigator
    Dim embedded As NotesEmbeddedObject

    Set db = session.CurrentDatabase
    Set doc = db.CreateDocument
    Set richText = New NotesRichTextItem(doc, "Body")
    Set nav = richText.CreateNavigator()
    Set embedded = richText.GetEmbeddedObject("missing.bin")

    If Not embedded Is Nothing Then
        Call nav.SetPosition(embedded)
        Call nav.SetPositionAtEnd(embedded)
    End If
End Sub
