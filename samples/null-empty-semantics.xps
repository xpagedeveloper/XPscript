' XPScript Null and Empty normal-runtime regression
' (c) xpagedeveloper.com 2026

Sub Main()
    Dim emptyValue As Variant
    Dim nullValue As Variant
    Dim nullSum As Variant
    Dim nullDifference As Variant
    Dim nullProduct As Variant
    Dim nullDivision As Variant
    Dim nullIntegerDivision As Variant
    Dim nullModulo As Variant
    Dim nullPower As Variant
    Dim nullUnaryPlus As Variant
    Dim nullUnaryMinus As Variant
    Dim nullEqual As Variant
    Dim nullNotEqual As Variant
    Dim nullLess As Variant
    Dim nullLessEqual As Variant
    Dim nullGreater As Variant
    Dim nullGreaterEqual As Variant
    Dim nullConcatLeft As Variant
    Dim nullConcatRight As Variant
    Dim nullConcatBoth As Variant
    Dim emptyDifference As Variant
    Dim emptyProduct As Variant
    Dim emptyDivision As Variant
    Dim emptyModulo As Variant
    Dim emptyPower As Variant
    Dim arithmeticPrecedence As Variant
    Dim divisionValue As Variant
    Dim integerDivisionValue As Variant
    Dim moduloValue As Variant
    Dim powerValue As Variant
    Dim powerChain As Variant
    Dim powerParenthesized As Variant
    Dim negativePowerPrecedence As Variant
    Dim negativePowerParenthesized As Variant

    nullValue = Null
    nullSum = nullValue + 1
    nullDifference = nullValue - 1
    nullProduct = 2 * nullValue
    nullDivision = nullValue / 2
    nullIntegerDivision = nullValue \ 2
    nullModulo = nullValue Mod 2
    nullPower = nullValue ^ 2
    nullUnaryPlus = +nullValue
    nullUnaryMinus = -nullValue
    nullEqual = nullValue = 1
    nullNotEqual = nullValue <> 1
    nullLess = nullValue < 1
    nullLessEqual = nullValue <= 1
    nullGreater = nullValue > 1
    nullGreaterEqual = nullValue >= 1
    nullConcatLeft = nullValue & "A"
    nullConcatRight = "A" & nullValue
    nullConcatBoth = nullValue & nullValue
    emptyDifference = emptyValue - 1
    emptyProduct = emptyValue * 5
    emptyDivision = emptyValue / 2
    emptyModulo = emptyValue Mod 5
    emptyPower = emptyValue ^ 2
    arithmeticPrecedence = 10 - 8 / 2 * 3
    divisionValue = 8 / 5
    integerDivisionValue = 16.9 \ 5.6
    moduloValue = 12 Mod 8
    powerValue = 4.5 ^ 3
    powerChain = 2 ^ 3 ^ 2
    powerParenthesized = 2 ^ (3 ^ 2)
    negativePowerPrecedence = -2 ^ 2
    negativePowerParenthesized = (-2) ^ 2

    Print "EMPTY_DT=" & CStr(DataType(emptyValue))
    Print "EMPTY_TYPE=" & TypeName(emptyValue)
    Print "EMPTY_ISEMPTY=" & CStr(IsEmpty(emptyValue))
    Print "EMPTY_ISNULL=" & CStr(IsNull(emptyValue))

    Print "NULL_DT=" & CStr(DataType(nullValue))
    Print "NULL_TYPE=" & TypeName(nullValue)
    Print "NULL_ISEMPTY=" & CStr(IsEmpty(nullValue))
    Print "NULL_ISNULL=" & CStr(IsNull(nullValue))
    Print "NULL_PROPAGATES=" & CStr(IsNull(nullSum))
    Print "NULL_SUBTRACT_PROPAGATES=" & CStr(IsNull(nullDifference))
    Print "NULL_MULTIPLY_PROPAGATES=" & CStr(IsNull(nullProduct))
    Print "NULL_DIVIDE_PROPAGATES=" & CStr(IsNull(nullDivision))
    Print "NULL_INTEGER_DIVIDE_PROPAGATES=" & CStr(IsNull(nullIntegerDivision))
    Print "NULL_MOD_PROPAGATES=" & CStr(IsNull(nullModulo))
    Print "NULL_POWER_PROPAGATES=" & CStr(IsNull(nullPower))
    Print "NULL_UNARY_PLUS_PROPAGATES=" & CStr(IsNull(nullUnaryPlus))
    Print "NULL_UNARY_MINUS_PROPAGATES=" & CStr(IsNull(nullUnaryMinus))
    Print "NULL_EQUAL_PROPAGATES=" & CStr(IsNull(nullEqual))
    Print "NULL_NOT_EQUAL_PROPAGATES=" & CStr(IsNull(nullNotEqual))
    Print "NULL_LESS_PROPAGATES=" & CStr(IsNull(nullLess))
    Print "NULL_LESS_EQUAL_PROPAGATES=" & CStr(IsNull(nullLessEqual))
    Print "NULL_GREATER_PROPAGATES=" & CStr(IsNull(nullGreater))
    Print "NULL_GREATER_EQUAL_PROPAGATES=" & CStr(IsNull(nullGreaterEqual))
    Print "NULL_CONCAT_LEFT=" & CStr(nullConcatLeft)
    Print "NULL_CONCAT_RIGHT=" & CStr(nullConcatRight)
    Print "NULL_CONCAT_BOTH_PROPAGATES=" & CStr(IsNull(nullConcatBoth))
    Print "EMPTY_SUBTRACT_ZERO=" & CStr(emptyDifference)
    Print "EMPTY_MULTIPLY_ZERO=" & CStr(emptyProduct)
    Print "EMPTY_DIVIDE_ZERO=" & CStr(emptyDivision)
    Print "EMPTY_MOD_ZERO=" & CStr(emptyModulo)
    Print "EMPTY_POWER_ZERO=" & CStr(emptyPower)
    Print "ARITHMETIC_PRECEDENCE=" & CStr(arithmeticPrecedence)
    Print "DIVISION_VALUE=" & CStr(divisionValue)
    Print "INTEGER_DIVISION_VALUE=" & CStr(integerDivisionValue)
    Print "MOD_VALUE=" & CStr(moduloValue)
    Print "POWER_VALUE=" & CStr(powerValue)
    Print "POWER_CHAIN=" & CStr(powerChain)
    Print "POWER_PARENTHESIZED=" & CStr(powerParenthesized)
    Print "NEGATIVE_POWER_PRECEDENCE=" & CStr(negativePowerPrecedence)
    Print "NEGATIVE_POWER_PARENTHESIZED=" & CStr(negativePowerParenthesized)
End Sub
