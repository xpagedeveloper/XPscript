' XPscript UIForm layout and reactive refresh API sample
' (c) xpagedeveloper.com 2026

Sub Main()
    Dim data As New XPJsonObject
    Dim form As New UIForm("Layout and reactive example", 760, 520, True)
    Dim result As String

    Call data.Set("country", "SE")
    Call data.Set("city", "Stockholm")
    Call data.Set("name", "Kalle")
    Call data.Set("email", "kalle@example.com")
    Call form.BindData(data)

    Call form.SetGridColumns(12)

    Call form.AddTextField("name", "Name")
    Call form.AddEmailField("email", "Email")
    Call form.AddSelect("country", "Country")
    Call form.AddSelect("city", "City")

    Call form.AddOption("country", "SE")
    Call form.AddOption("country", "NO")
    Call form.AddOption("country", "DK")

    Call form.AddOption("city", "Stockholm")
    Call form.AddOption("city", "Göteborg")

    Call form.SetFieldPosition("name", 1, 1, 6, 1)
    Call form.SetFieldPosition("email", 1, 7, 6, 1)
    Call form.SetFieldPosition("country", 2, 1, 6, 1)
    Call form.SetFieldPosition("city", 2, 7, 6, 1)

    Call form.SetFieldRegion("city", "cityRegion")
    Call form.SetRefreshOnChange("country", "cityRegion", "RefreshCities")

    result = form.ShowDialog()
    Print "RESULT=" & result
    Print "DATA=" & data.Stringify()
End Sub

Function RefreshCities(country As String) As String
    If country = "NO" Then
        RefreshCities = "Oslo|Bergen"
    ElseIf country = "DK" Then
        RefreshCities = "Copenhagen|Aarhus"
    Else
        RefreshCities = "Stockholm|Göteborg"
    End If
End Function
