' NotesDBDirectory regression coverage.
Option Declare

Sub Main()
    Dim session As NotesSession
    Dim directory As NotesDBDirectory
    Dim parentSession As NotesSession
    Dim db As NotesDatabase
    Dim firstPath As String
    Dim firstTemplateCandidatePath As String
    Dim count As Integer
    Dim constantFailures As Integer
    Dim typeFailures As Integer
    Dim openFailures As Integer
    Dim propertyFailures As Integer
    Dim errCode As Integer

    Set session = New NotesSession()
    Set directory = session.GetDbDirectory("")

    Print "NOTES-DBDIRECTORY-BEGIN"
    Print "Name=" & directory.Name
    Set parentSession = directory.Parent
    If parentSession Is Nothing Then
        Print "NOTES-DBDIRECTORY=FAIL PARENT-NOTHING"
        propertyFailures = propertyFailures + 1
    ElseIf parentSession.UserName <> session.UserName Then
        Print "NOTES-DBDIRECTORY=FAIL PARENT-USERNAME=" & parentSession.UserName
        propertyFailures = propertyFailures + 1
    Else
        Print "PARENT=PASS"
    End If
    If directory.Name <> "" Then
        Print "NOTES-DBDIRECTORY=FAIL LOCAL-NAME=" & directory.Name
        propertyFailures = propertyFailures + 1
    Else
        Print "LOCAL-NAME=PASS"
    End If
    If propertyFailures = 0 Then
        Print "PROPERTIES=PASS"
    Else
        Print "PROPERTIES=FAIL " & CStr(propertyFailures)
    End If

    If NotesConst.REPLICA_CANDIDATE <> 1245 Then
        Print "NOTES-DBDIRECTORY=FAIL REPLICA_CANDIDATE"
        constantFailures = constantFailures + 1
    End If
    If NotesConst.TEMPLATE_CANDIDATE <> 1246 Then
        Print "NOTES-DBDIRECTORY=FAIL TEMPLATE_CANDIDATE"
        constantFailures = constantFailures + 1
    End If
    If NotesConst.DATABASE <> 1247 Then
        Print "NOTES-DBDIRECTORY=FAIL DATABASE"
        constantFailures = constantFailures + 1
    End If
    If NotesConst.TEMPLATE <> 1248 Then
        Print "NOTES-DBDIRECTORY=FAIL TEMPLATE"
        constantFailures = constantFailures + 1
    End If
    If constantFailures = 0 Then
        Print "TYPE-CONSTANTS=PASS"
    Else
        Print "TYPE-CONSTANTS=FAIL " & CStr(constantFailures)
    End If

    Set db = directory.GetFirstDatabase(NotesConst.DATABASE)
    If Not db Is Nothing Then firstPath = db.FilePath
    Do While Not db Is Nothing
        Print "DATABASE=" & db.FilePath
        If db.IsOpen Then
            Print "NOTES-DBDIRECTORY=FAIL ENUMERATION-OPENED-DATABASE"
            typeFailures = typeFailures + 1
        End If
        count = count + 1
        Call db.Recycle()
        Set db = directory.GetNextDatabase()
    Loop
    Print "DATABASE-COUNT=" & CStr(count)

    ' A completed enumeration must stay exhausted until GetFirstDatabase starts a new one.
    Set db = directory.GetNextDatabase()
    If Not db Is Nothing Then
        Print "NOTES-DBDIRECTORY=FAIL NEXT-AFTER-END"
        typeFailures = typeFailures + 1
        Call db.Recycle()
    Else
        Print "NEXT-AFTER-END=PASS"
    End If

    Set db = directory.GetFirstDatabase(NotesConst.DATABASE)
    If firstPath <> "" Then
        If db Is Nothing Then
            Print "NOTES-DBDIRECTORY=FAIL RESET-NOTHING"
            typeFailures = typeFailures + 1
        ElseIf db.FilePath <> firstPath Then
            Print "NOTES-DBDIRECTORY=FAIL RESET-PATH=" & db.FilePath
            typeFailures = typeFailures + 1
        Else
            Print "ENUMERATION-RESET=PASS"
        End If
    Else
        If db Is Nothing Then
            Print "ENUMERATION-RESET=PASS"
        Else
            Print "NOTES-DBDIRECTORY=FAIL RESET-UNEXPECTED-DATABASE=" & db.FilePath
            typeFailures = typeFailures + 1
        End If
    End If
    If Not db Is Nothing Then Call db.Recycle()

    Set db = directory.GetFirstDatabase(NotesConst.REPLICA_CANDIDATE)
    If Not db Is Nothing Then
        Print "REPLICA-CANDIDATE=" & db.FilePath
        If db.IsOpen Then
            Print "NOTES-DBDIRECTORY=FAIL REPLICA-CANDIDATE-OPENED-DATABASE"
            typeFailures = typeFailures + 1
        End If
        Call db.Recycle()
    Else
        Print "REPLICA-CANDIDATE=NONE"
    End If
    Set db = directory.GetNextDatabase()
    If Not db Is Nothing Then
        Print "REPLICA-CANDIDATE-NEXT=" & db.FilePath
        If db.IsOpen Then
            Print "NOTES-DBDIRECTORY=FAIL REPLICA-CANDIDATE-NEXT-OPENED-DATABASE"
            typeFailures = typeFailures + 1
        End If
        Call db.Recycle()
    Else
        Print "REPLICA-CANDIDATE-NEXT=NONE"
    End If

    ' Capture the target type, switch away, then require GetFirstDatabase to restart it.
    Set db = directory.GetFirstDatabase(NotesConst.TEMPLATE_CANDIDATE)
    If Not db Is Nothing Then
        firstTemplateCandidatePath = db.FilePath
        Print "TEMPLATE-CANDIDATE=" & db.FilePath
        If db.IsOpen Then
            Print "NOTES-DBDIRECTORY=FAIL TEMPLATE-CANDIDATE-OPENED-DATABASE"
            typeFailures = typeFailures + 1
        End If
        Call db.Recycle()
    Else
        Print "TEMPLATE-CANDIDATE=NONE"
    End If

    Set db = directory.GetFirstDatabase(NotesConst.DATABASE)
    If Not db Is Nothing Then Call db.Recycle()
    Set db = directory.GetNextDatabase()
    If Not db Is Nothing Then Call db.Recycle()

    Set db = directory.GetFirstDatabase(NotesConst.TEMPLATE_CANDIDATE)
    If firstTemplateCandidatePath <> "" Then
        If db Is Nothing Then
            Print "NOTES-DBDIRECTORY=FAIL TYPE-SWITCH-RESET-NOTHING"
            typeFailures = typeFailures + 1
        ElseIf db.FilePath <> firstTemplateCandidatePath Then
            Print "NOTES-DBDIRECTORY=FAIL TYPE-SWITCH-RESET-PATH=" & db.FilePath
            typeFailures = typeFailures + 1
        Else
            Print "TYPE-SWITCH-RESET=PASS"
        End If
    Else
        If db Is Nothing Then
            Print "TYPE-SWITCH-RESET=PASS"
        Else
            Print "NOTES-DBDIRECTORY=FAIL TYPE-SWITCH-RESET-UNEXPECTED=" & db.FilePath
            typeFailures = typeFailures + 1
        End If
    End If
    If Not db Is Nothing Then Call db.Recycle()

    Set db = directory.GetFirstDatabase(NotesConst.TEMPLATE)
    If Not db Is Nothing Then
        Print "TEMPLATE=" & db.FilePath
        If db.IsOpen Then
            Print "NOTES-DBDIRECTORY=FAIL TEMPLATE-OPENED-DATABASE"
            typeFailures = typeFailures + 1
        End If
        Call db.Recycle()
    Else
        Print "TEMPLATE=NONE"
    End If
    If typeFailures = 0 Then
        Print "TYPE-ENUMERATION=PASS"
    Else
        Print "TYPE-ENUMERATION=FAIL " & CStr(typeFailures)
    End If

    Set db = directory.OpenDatabase("names.nsf")
    If db Is Nothing Then
        Print "NOTES-DBDIRECTORY=FAIL OPEN-NAMES-NOTHING"
        openFailures = openFailures + 1
    Else
        If Not db.IsOpen Then
            Print "NOTES-DBDIRECTORY=FAIL OPEN-NAMES-CLOSED"
            openFailures = openFailures + 1
        End If
        If db.FilePath <> "names.nsf" Then
            Print "NOTES-DBDIRECTORY=FAIL OPEN-NAMES-PATH=" & db.FilePath
            openFailures = openFailures + 1
        End If
        Call db.Recycle()
    End If
    If openFailures = 0 Then
        Print "OPEN-DATABASE=PASS"
    Else
        Print "OPEN-DATABASE=FAIL " & CStr(openFailures)
    End If

    errCode = 0
    On Error Resume Next
    Set db = directory.GetFirstDatabase(99)
    errCode = Err
    On Error GoTo 0
    If errCode <> 5 Then
        Print "NOTES-DBDIRECTORY=FAIL INVALID-TYPE=" & CStr(errCode)
    Else
        Print "INVALID-TYPE=PASS"
    End If

    Call directory.Recycle()
    Call session.Recycle()
    Print "NOTES-DBDIRECTORY-END"
End Sub
