' NotesDBDirectory regression coverage.
Option Declare

Sub Main()
    Dim session As NotesSession
    Dim directory As NotesDBDirectory
    Dim db As NotesDatabase
    Dim firstPath As String
    Dim count As Integer
    Dim errCode As Integer

    Set session = New NotesSession()
    Set directory = session.GetDbDirectory("")

    Print "NOTES-DBDIRECTORY-BEGIN"
    Print "Name=" & directory.Name
    Print "ParentUser=" & directory.Parent.UserName

    If NotesConst.REPLICA_CANDIDATE <> 1245 Then Print "NOTES-DBDIRECTORY=FAIL REPLICA_CANDIDATE"
    If NotesConst.TEMPLATE_CANDIDATE <> 1246 Then Print "NOTES-DBDIRECTORY=FAIL TEMPLATE_CANDIDATE"
    If NotesConst.DATABASE <> 1247 Then Print "NOTES-DBDIRECTORY=FAIL DATABASE"
    If NotesConst.TEMPLATE <> 1248 Then Print "NOTES-DBDIRECTORY=FAIL TEMPLATE"
    Print "TYPE-CONSTANTS=PASS"

    Set db = directory.GetFirstDatabase(NotesConst.DATABASE)
    If Not db Is Nothing Then firstPath = db.FilePath
    Do While Not db Is Nothing
        Print "DATABASE=" & db.FilePath
        If db.IsOpen Then
            Print "NOTES-DBDIRECTORY=FAIL ENUMERATION-OPENED-DATABASE"
        End If
        count = count + 1
        Call db.Recycle()
        Set db = directory.GetNextDatabase()
    Loop
    Print "DATABASE-COUNT=" & CStr(count)

    ' A completed enumeration must stay exhausted until GetFirstDatabase starts a new one.
    Set db = directory.GetNextDatabase()
    If Not db Is Nothing Then
        Print "NOTES-DBDIRECTORY=FAIL NEXT-AFTER-END"
        Call db.Recycle()
    Else
        Print "NEXT-AFTER-END=PASS"
    End If

    Set db = directory.GetFirstDatabase(NotesConst.DATABASE)
    If firstPath <> "" Then
        If db Is Nothing Then
            Print "NOTES-DBDIRECTORY=FAIL RESET-NOTHING"
        ElseIf db.FilePath <> firstPath Then
            Print "NOTES-DBDIRECTORY=FAIL RESET-PATH=" & db.FilePath
        Else
            Print "ENUMERATION-RESET=PASS"
        End If
    ElseIf db Is Nothing Then
        Print "ENUMERATION-RESET=PASS"
    End If
    If Not db Is Nothing Then Call db.Recycle()

    Set db = directory.GetFirstDatabase(NotesConst.REPLICA_CANDIDATE)
    If Not db Is Nothing Then
        Print "REPLICA-CANDIDATE=" & db.FilePath
        Call db.Recycle()
    Else
        Print "REPLICA-CANDIDATE=NONE"
    End If

    Set db = directory.GetFirstDatabase(NotesConst.TEMPLATE_CANDIDATE)
    If Not db Is Nothing Then
        Print "TEMPLATE-CANDIDATE=" & db.FilePath
        Call db.Recycle()
    Else
        Print "TEMPLATE-CANDIDATE=NONE"
    End If

    Set db = directory.GetFirstDatabase(NotesConst.TEMPLATE)
    If Not db Is Nothing Then
        Print "TEMPLATE=" & db.FilePath
        Call db.Recycle()
    Else
        Print "TEMPLATE=NONE"
    End If
    Print "TYPE-ENUMERATION=PASS"

    Set db = directory.OpenDatabase("names.nsf")
    Print "OPEN-NAMES=" & CStr(db.IsOpen)
    Call db.Recycle()

    errCode = 0
    On Error Resume Next
    Set db = directory.GetFirstDatabase(99)
    errCode = Err
    On Error GoTo 0
    If errCode <> 5 Then
        Print "NOTES-DBDIRECTORY=FAIL INVALID-TYPE=" & CStr(errCode)
    Else
        Print "INVALID-TYPE=PASS"
    End If

    Call directory.Recycle()
    Call session.Recycle()
    Print "NOTES-DBDIRECTORY-END"
End Sub
