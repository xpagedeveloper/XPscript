Sub Main()
    Print "PLATFORM=" & Platform()

    Dim result As Variant
    Dim args(2) As String
    If Platform() = "Windows" Then
        args(0) = "/c"
        args(1) = "echo"
        args(2) = "XPScript-Windows"
        result = ShellExecute("cmd.exe", args)
    ElseIf Platform() = "Linux" Then
        args(0) = "-c"
        args(1) = "echo XPScript-Linux"
        args(2) = ""
        result = ShellExecute("/bin/sh", args)
    ElseIf Platform() = "MacOS" Then
        args(0) = "-c"
        args(1) = "echo XPScript-MacOS"
        args(2) = ""
        result = ShellExecute("/bin/sh", args)
    Else
        Print "Shell sample skipped for unsupported platform"
        Exit Sub
    End If

    Print Trim(result.Output)
End Sub
