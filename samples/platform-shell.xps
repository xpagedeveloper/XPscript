Sub Main()
    Print "PLATFORM-FUNCTION=" & Platform()
    Print "PLATFORM-BARE=" & Platform

    Call Shell("\"samples/shell helpers åäö/args helper.ps1\" \"space value\" \"\" \"åäö 漢字\" \"a&b|c<>^%!\"")

    If Platform = "Windows" Then
        Call Shell("\"samples/shell helpers åäö/safe.cmd\" \"safe value\"")
        Call Shell("cmd.exe /d /c echo DIRECT-WINDOWS")
    ElseIf Platform = "Linux" Or Platform = "MacOS" Then
        Call Shell("\"samples/shell helpers åäö/safe.sh\" \"safe value\"")
        Call Shell("\"samples/shell helpers åäö/shebang-helper\" \"safe value\"")
        Call Shell("/bin/sh -c \"echo DIRECT-UNIX\"")
    Else
        Print "Shell sample skipped for unsupported platform"
    End If
End Sub
