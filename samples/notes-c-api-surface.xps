' Compile-only surface probe for the HCL Notes/Domino C API wrapper.
' Main does not create NotesSession, so CI does not require an installed Notes runtime.

Option Declare

Sub CompileNotesSurface()
    Dim session As New NotesSession("C:\Program Files\HCL\Notes")
    Dim db As NotesDatabase
    Dim dbCopy As NotesDatabase
    Dim docs As NotesDocumentCollection
    Dim otherDocs As NotesDocumentCollection
    Dim doc As NotesDocument
    Dim name As NotesName
    Dim whenValue As NotesDateTime

    Print session.Username
    Print session.Platform

    Set name = session.CreateName("CN=Ada Lovelace/O=Example")
    Print name.Canonical
    Print name.Abbreviated
    Print name.Common
    Print name.Organization

    Set whenValue = session.CreateDateTime("2026-08-25 12:00:00")
    Call whenValue.AdjustDay(1)
    Print whenValue.LocalTime

    Set db = session.OpenDatabase("", "apps\customers.nsf")
    Print db.ReplicaID

    Set docs = db.CreateDocumentCollection()
    Set otherDocs = db.CreateDocumentCollection()
    Print docs.Count
    Set doc = docs.GetFirstDocument()
    Set doc = docs.GetDocument("00000001")
    Set doc = docs.GetNextDocument(doc)
    Call docs.AddDocument(doc)
    Call docs.AddDocument(otherDocs)
    Call docs.RemoveDocument(doc)
    Call docs.RemoveDocument(otherDocs)

    Set dbCopy = db.CreateCopy("", "apps\customers-copy.nsf")
    Print dbCopy.ReplicaID

    Call db.SetReplicaId("85258D12004A1234")
    Print db.ReplicaID
End Sub

Sub Main()
    Print "NOTES-C-API-SURFACE=COMPILED"
End Sub
