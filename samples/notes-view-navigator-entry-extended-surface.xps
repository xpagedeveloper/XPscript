' Compile-only coverage for NotesViewNavigator and NotesViewEntryCollection navigation.
Option Declare

Sub CompileNotesViewNavigatorSurface()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim view As NotesView
    Dim nav As Variant
    Dim entries As Variant
    Dim entry As Variant

    Set session = New NotesSession()
    Set db = session.OpenDatabase("", "apps\customers.nsf")
    Set view = db.GetView("Customers")
    nav = view.CreateViewNav()
    entries = view.CreateViewEntryCollection()
    entry = entries.GetFirstEntry()

    Print nav.ParentView
    Call nav.GetNext(entry)
    Call nav.GetPrev(entry)
    Call nav.GetPrevCategory(entry)
    Call nav.GetPrevSibling(entry)
    Call nav.GotoChild(entry)
    Call nav.GotoFirst()
    Call nav.GotoFirstDocument()
    Call nav.GotoLast()
    Call nav.GotoLastDocument()
    Call nav.GotoNextCategory(entry)
    Call nav.GotoNextDocument(entry)
    Call nav.GotoNextSibling(entry)
    Call nav.GotoParent(entry)
    Call nav.GotoPos("1", ".")
    Call nav.GotoPrev(entry)
    Call nav.GotoPrevCategory(entry)
    Call nav.GotoPrevDocument(entry)
    Call nav.GotoPrevSibling(entry)

    Call entries.AddEntry(Nothing)
    Call entries.DeleteEntry(Nothing)
    Call entries.GetLastEntry()
    Call entries.GetNthEntry(1)
    Call entries.GetPrevEntry(entry)
End Sub

Sub Main()
    Print "NOTES-VIEW-NAVIGATOR-ENTRY-EXTENDED-SURFACE=COMPILED"
End Sub
