Class RootCalc
    Public Function Compute(ByVal value As Integer) As String
        Compute = CStr(value)
    End Function
End Class

Class MiddleCalc Extend RootCalc
End Class

Class LeafCalc Extend MiddleCalc
    Public Function Compute(ByVal value As String) As String
        Compute = value
    End Function
End Class

Sub Main()
End Sub
