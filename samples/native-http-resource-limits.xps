Option Declare

Sub Main()
    Dim client As New HttpClient
    Dim response As HttpResponse
    Dim hugeBody As String
    Dim errCode As Integer

    client.Timeout = 5

    Set response = client.Get("http://127.0.0.1:18080/redirect")
    Print "REDIRECT_STATUS=" & CStr(response.StatusCode)
    Print "REDIRECT_BODY=" & response.Body

    hugeBody = String(8388609, "A")
    On Error Resume Next
    Set response = client.Post("http://127.0.0.1:18080/post", hugeBody)
    errCode = Err
    On Error GoTo 0
    Print "REQUEST_BODY_LIMIT_ERR=" & CStr(errCode)

    On Error Resume Next
    Set response = client.Get("http://127.0.0.1:18080/oversized-declared")
    errCode = Err
    On Error GoTo 0
    Print "DECLARED_RESPONSE_LIMIT_ERR=" & CStr(errCode)

    On Error Resume Next
    Set response = client.Get("http://127.0.0.1:18080/oversized-stream")
    errCode = Err
    On Error GoTo 0
    Print "STREAM_RESPONSE_LIMIT_ERR=" & CStr(errCode)

    client.Timeout = 1
    On Error Resume Next
    Set response = client.Get("http://127.0.0.1:18080/slow")
    errCode = Err
    On Error GoTo 0
    Print "TIMEOUT_ERR=" & CStr(errCode)

    Call client.Dispose()
    On Error Resume Next
    Set response = client.Get("http://127.0.0.1:18080/get")
    errCode = Err
    On Error GoTo 0
    Print "DISPOSED_ERR=" & CStr(errCode)

    Print "HTTP_RESOURCE_LIMITS=OK"
End Sub
