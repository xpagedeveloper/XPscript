' XPScript OpenAI-compatible AI client regression
' (c) xpagedeveloper.com 2026

Option Declare

Private streamedText As String

Sub OnAiChunk(ByVal chunk As String)
    streamedText = streamedText & chunk
    Print "CHUNK=" & chunk
End Sub

Sub OnAiChunkWithContext(ByVal chunk As String, ByVal requestId As String, ByVal sequence As Integer)
    streamedText = streamedText & chunk
    Print "CALLBACK=" & requestId & ":" & CStr(sequence) & ":" & chunk
End Sub

Sub Main()
    Dim endpoint As String
    Dim compatBase As String
    Dim ai As XPAi
    Dim response As XPAiResponse
    Dim providerExtra As JsonObject

    Set ai = New XPAi("openai", "test-key")
    Print "PRESET-OPENAI=" & ai.Endpoint
    Call ai.Dispose()
    Set ai = New XPAi("claude", "test-key")
    Print "PRESET-CLAUDE=" & ai.Endpoint
    Call ai.Dispose()
    Set ai = New XPAi("openrouter", "test-key")
    Print "PRESET-OPENROUTER=" & ai.Endpoint
    Call ai.Dispose()
    Set ai = New XPAi("azure", "test-key", "xpscript-test")
    Print "PRESET-AZURE=" & ai.Endpoint
    Print "PRESET-AZURE-PROVIDER=" & ai.Provider
    Call ai.Dispose()

    compatBase = Environ("XPSCRIPT_AI_COMPAT_BASE")
    If compatBase <> "" Then
        Set ai = New XPAi(compatBase & "/compat/openai", "OPENAI_COMPAT_KEY")
        ai.Model = "openai-compat-model"
        Call ai.AddMessage("user", "OpenAI compatibility fixture")
        Set response = ai.Complete()
        Print response.Text
        Call ai.Dispose()

        Set ai = New XPAi(compatBase & "/compat/openrouter", "OPENROUTER_COMPAT_KEY")
        ai.Model = "openrouter-compat-model"
        Call ai.SetHeader("HTTP-Referer", "https://xpscript.test/compat")
        Call ai.SetHeader("X-OpenRouter-Title", "XPScript CI")
        Call ai.AddMessage("user", "OpenRouter compatibility fixture")
        Set response = ai.Complete()
        Print response.Text
        Call ai.Dispose()

        Set ai = New XPAi(compatBase & "/compat/azure")
        ai.Model = "azure-compat-model"
        Call ai.SetHeader("api-key", "AZURE_COMPAT_KEY")
        Call ai.AddMessage("user", "Azure compatibility fixture")
        Set response = ai.Complete()
        Print response.Text
        Call ai.Dispose()
    End If

    endpoint = Environ("XPSCRIPT_AI_ENDPOINT")
    If endpoint = "" Then
        Print "XPAI-COMPILE=OK"
        Exit Sub
    End If

    Set ai = New XPAi(endpoint, "XPAI_SECRET_MARKER")
    ai.Model = "mock-model"
    ai.Timeout = 15
    Call ai.SetHeader("X-Provider", "xpscript-test")
    Call ai.AddMessage("system", "Answer briefly.")
    Call ai.AddMessage("user", "Hello")
    ai.Temperature = 0.2
    ai.MaxOutputTokens = 64

    Set response = ai.Complete()
    Print "STATUS=" & CStr(response.StatusCode)
    Print "SUCCESS=" & CStr(response.IsSuccess)
    Print "MODEL=" & response.Model
    Print "TEXT=" & response.Text
    Print "TOKENS=" & CStr(response.Usage.Root.AsObject().Get("total_tokens"))
    Set providerExtra = response.RawJson.Root.AsObject().Get("provider_extra")
    Print "RAWEXTRA=" & CStr(providerExtra.Get("preserved"))

    streamedText = ""
    Set response = ai.Stream("OnAiChunk")
    Print "STREAM=" & streamedText
    Print "COLLECTED=" & response.Text

    streamedText = ""
    Set response = ai.StreamCallback("OnAiChunkWithContext", "request-42", 7)
    Print "STREAM-CONTEXT=" & streamedText

    On Error GoTo ProviderError
    ai.Model = "error-model"
    Set response = ai.Complete()
    Print "PROVIDER-ERROR=FAILED"
    Exit Sub

ProviderError:
    Print "PROVIDER-ERROR=" & Error$
    Print "XPAI=OK"
End Sub
