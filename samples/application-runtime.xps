Option Declare

Sub Main()
    Dim i As Integer

    Print "EXEPATH=" & Application.ExecutablePath
    Print "PATH=" & Application.Path
    Print "EXEFILE=" & Application.ExecutableFileName
    Print "FILENAME=" & Application.FileName
    Print "EXEDIR=" & Application.ExecutableDirectory
    Print "TEMPPATH=" & Application.TempPath
    Print "TEMPFOLDER=" & Application.TempFolder
    Print "ARGCOUNT=" & CStr(Application.ArgCount)
    Print "COMMANDLINE=" & Application.CommandLine

    For i = 0 To Application.ArgCount - 1
        Print "ARG" & CStr(i) & "=" & Application.Args(i)
    Next
End Sub
