' XPScript UIForm structural elements sample
' (c) xpagedeveloper.com 2026

Sub Main()
    Dim form As New UIForm("Structural elements")

    Call form.AddTextField("name", "Name")
    Call form.AddSeparator("customer_separator")
    Call form.AddTextField("email", "Email")
    Call form.AddSpacer("actions_spacer")
    Call form.AddCheckBox("active", "Active")

    Call form.SetGridColumns(12)
    Call form.SetFieldPosition("name", 1, 1, 6)
    Call form.SetFieldPosition("customer_separator", 2, 1, 12)
    Call form.SetFieldPosition("email", 3, 1, 6)
    Call form.SetFieldPosition("actions_spacer", 4, 1, 12)
    Call form.SetFieldPosition("active", 5, 1, 12)

    Print "FIELD_COUNT=" & form.FieldCount
End Sub
