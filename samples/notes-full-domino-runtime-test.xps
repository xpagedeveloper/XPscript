' Consolidated HCL Notes/Domino runtime regression for XPscript.
'
' Target database: xpscript.nsf
' The test removes any existing xpscript.nsf through NotesDatabase.Remove before importing the repository DXL fixture.
'
' This master sample exercises the currently exposed Notes runtime surface across:
' NotesSession, NotesName, NotesDateTime, NotesDatabase, NotesDocument,
' NotesDocumentCollection, NotesNoteCollection, NotesItem, NotesRichTextItem,
' NotesAgent, NotesAgentResult, NotesStream, NotesView, NotesViewEntry,
' NotesViewEntryCollection, NotesViewNavigator, NotesDXLImporter and NotesDXLExporter.
'
' The database lifecycle section creates and removes only a temporary NSF.
' Temporary documents and stream files created by this script are removed before exit.
' Full-text operations are attempted and reported as INFO when no FT index exists.
'
Option Declare

Sub Main()
    Const NOTES_RUNTIME = "C:\Program Files\HCL\Notes"
    Const NOTES_INI = ""
    Const DATABASE_PATH = "xpscript.nsf"
    Const FIXTURE_DXL = "xpscript-notes-runtime-fixture.dxl"
    Const TEST_VIEW = "XPScriptTestView"
    Const HIERARCHY_VIEW = "XPScriptHierarchyView"
    Const TEST_AGENT = "XPScriptTestAgent"
    Const VALID_FORM = "XPScriptCWFValid"
    Const ERROR_FORM = "XPScriptCWFErrors"

    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim importer As NotesDXLImporter
    Dim failures As Integer
    Dim bootstrapErr As Integer

    failures = 0
    If NOTES_INI = "" Then
        Set session = New NotesSession()
    Else
        Set session = New NotesSession(NOTES_RUNTIME, NOTES_INI)
    End If

    Print "STEP=00/17 Recreate xpscript.nsf"
    If session Is Nothing Then
        Print "BOOTSTRAP-ERROR NotesSession is Nothing"
        Print "NOTES-FULL-DOMINO=FAIL COUNT=1"
        Exit Sub
    End If

    If session.DataDir = "" Then
        Print "BOOTSTRAP-ERROR NotesSession.DataDir is empty"
        Call session.Recycle()
        Print "NOTES-FULL-DOMINO=FAIL COUNT=1"
        Exit Sub
    End If

    Print "OPEN NotesDatabase for " & DATABASE_PATH
    Set db = session.OpenDatabase("", DATABASE_PATH)
    If db Is Nothing Then
        Call session.Recycle()
        Print "NOTES-FULL-DOMINO=FAIL COUNT=1"
        Exit Sub
    End If

    If db.IsOpen Then
        Print "FOUND " & db.FilePath
        Print "REMOVE " & db.FilePath
        bootstrapErr = 0
        On Error Resume Next
        Call db.Remove()
        bootstrapErr = Err
        On Error GoTo 0
        If bootstrapErr <> 0 Then
            Print "BOOTSTRAP-DELETE-ERROR=" & CStr(bootstrapErr)
            Call db.Recycle()
            Call session.Recycle()
            Print "NOTES-FULL-DOMINO=FAIL COUNT=1"
            Exit Sub
        End If
        Print "REMOVED " & DATABASE_PATH
    Else
        Print "xpscript.nsf is already absent"
    End If

    Print "CREATE NotesDatabase for fresh xpscript.nsf"
    bootstrapErr = 0
    On Error Resume Next
    Call db.Create("", "", True)
    bootstrapErr = Err
    If bootstrapErr = 0 Then
        Set importer = session.CreateDXLImporter()
        If importer Is Nothing Then
            bootstrapErr = 91
        Else
            importer.ExitOnFirstFatalError = True
            Call importer.Import(FIXTURE_DXL, db)
            bootstrapErr = Err
            If bootstrapErr <> 0 Then
                Print "BOOTSTRAP-DXL-IMPORT-ERROR=" & CStr(bootstrapErr)
                Print "BOOTSTRAP-DXL-IMPORT-LOG-BEGIN"
                Print importer.Log
                Print "BOOTSTRAP-DXL-IMPORT-LOG-END"
            Else
                Print "BOOTSTRAP-DXL-IMPORTED-NOTE-COUNT=" & CStr(importer.ImportedNoteCount)
            End If
            Call importer.Recycle()
        End If
    End If
    On Error GoTo 0

    If bootstrapErr <> 0 Or Not db.IsOpen Then
        Print "BOOTSTRAP-ERROR=" & CStr(bootstrapErr)
        Call db.Recycle()
        Call session.Recycle()
        Print "NOTES-FULL-DOMINO=FAIL COUNT=1"
        Exit Sub
    End If

    Print "NOTES-FULL-DOMINO-BEGIN"
    Print "STEP=01/17 NotesSession"
    failures = failures + TestSession(session, db)
    Print "STEP-RESULT=01 TOTAL=" & CStr(failures)
    Print "STEP=02/17 NotesName"
    failures = failures + TestName(session)
    Print "STEP-RESULT=02 TOTAL=" & CStr(failures)
    Print "STEP=03/17 NotesDateTime"
    failures = failures + TestDateTime(session)
    Print "STEP-RESULT=03 TOTAL=" & CStr(failures)
    Print "STEP=04/17 NotesDatabase"
    failures = failures + TestDatabase(session, db, TEST_VIEW, TEST_AGENT)
    Print "STEP-RESULT=04 TOTAL=" & CStr(failures)
    Print "STEP=05/17 NotesDocument"
    failures = failures + TestDocument(session, db)
    Print "STEP-RESULT=05 TOTAL=" & CStr(failures)
    Print "STEP=06/17 NotesDocumentCollection"
    failures = failures + TestDocumentCollection(db)
    Print "STEP-RESULT=06 TOTAL=" & CStr(failures)
    Print "STEP=07/17 NotesNoteCollection"
    failures = failures + TestNoteCollection(db)
    Print "STEP-RESULT=07 TOTAL=" & CStr(failures)
    Print "STEP=08/17 NotesItem NotesRichTextItem"
    failures = failures + TestItemAndRichText(session, db, TEST_VIEW)
    Print "STEP-RESULT=08 TOTAL=" & CStr(failures)
    Print "STEP=09/17 NotesAgent NotesAgentResult"
    failures = failures + TestAgent(db, TEST_AGENT)
    Print "STEP-RESULT=09 TOTAL=" & CStr(failures)
    Print "STEP=10/17 NotesStream"
    failures = failures + TestStream(session)
    Print "STEP-RESULT=10 TOTAL=" & CStr(failures)
    Print "STEP=11/17 NotesView"
    failures = failures + TestView(db, TEST_VIEW)
    Print "STEP-RESULT=11 TOTAL=" & CStr(failures)
    Print "STEP=12/17 NotesViewEntry Collection Navigator V1"
    failures = failures + TestViewNavigationV1(db, TEST_VIEW)
    Print "STEP-RESULT=12 TOTAL=" & CStr(failures)
    Print "STEP=13/17 NotesViewNavigator V2"
    failures = failures + TestViewNavigationV2(db, HIERARCHY_VIEW)
    Print "STEP-RESULT=13 TOTAL=" & CStr(failures)
    Print "STEP=14/17 NotesView V3"
    failures = failures + TestViewNavigationV3(db, TEST_VIEW)
    Print "STEP-RESULT=14 TOTAL=" & CStr(failures)
    Print "STEP=15/17 NotesDXLImporter NotesDXLExporter"
    failures = failures + TestDXL(session, db)
    Print "STEP-RESULT=15 TOTAL=" & CStr(failures)
    Print "STEP=16/17 NotesDocument ComputeWithForm"
    failures = failures + TestComputeWithForm(db, VALID_FORM, ERROR_FORM)
    Print "STEP-RESULT=16 TOTAL=" & CStr(failures)
    Print "STEP=17/17 NotesDatabase lifecycle"
    failures = failures + TestDatabaseLifecycle(session)
    Print "STEP-RESULT=17 TOTAL=" & CStr(failures)

    Print "NOTES-FULL-DOMINO-END"
    Call db.Recycle()
    Call session.Recycle()

    If failures = 0 Then
        Print "NOTES-FULL-DOMINO=PASS"
    Else
        Print "NOTES-FULL-DOMINO=FAIL COUNT=" & CStr(failures)
    End If
End Sub

Function TestSession(ByVal session As Variant, ByVal db As Variant) As Integer
    Dim failures As Integer
    Dim replicaDb As NotesDatabase
    Dim n As NotesName
    Dim dt As NotesDateTime
    failures = 0

    Print "SECTION=NotesSession"
    Print "Username=" & session.Username
    Print "UserName=" & session.UserName
    Print "CommonUsername=" & session.CommonUsername
    Print "CommonUserName=" & session.CommonUserName
    Print "NotesVersion=" & session.NotesVersion
    Print "NotesBuildVersion=" & CStr(session.NotesBuildVersion)
    Print "Platform=" & session.Platform
    Print "RuntimeDirectory=" & session.RuntimeDirectory
    Print "ProgramDir=" & session.ProgramDir
    Print "NotesIni=" & session.NotesIni
    Print "IniDir=" & session.IniDir
    Print "DataDir=" & session.DataDir

    Set replicaDb = session.OpenByReplicaID("", db.ReplicaID)
    If replicaDb Is Nothing Or Not replicaDb.IsOpen Then failures = failures + 1
    If Not replicaDb Is Nothing Then Call replicaDb.Recycle()
	Forall agent in db.agents
	print agent.name
	End forall
	Forall form in db.forms
	print form.name
	End forall
	Forall view in db.views
	print view.name
	End forall
    Set n = session.CreateName("CN=Ada Lovelace/OU=Engineering/O=Example/C=SE")
    If n Is Nothing Then failures = failures + 1 Else Call n.Recycle()

    Set dt = session.CreateDateTime("2026-08-29 08:00:00")
    If dt Is Nothing Then failures = failures + 1 Else Call dt.Recycle()
    Set dt = session.CreateDateTimeNow()
    If dt Is Nothing Then failures = failures + 1 Else Call dt.Recycle()

    TestSession = failures
End Function
Function TestName(ByVal session As Variant) As Integer
    Dim n As NotesName
    Dim internetName As NotesName
    Print "SECTION=NotesName"

    Set n = session.CreateName("CN=Ada Lovelace/OU=Engineering/OU=Platform/O=Example/C=SE")
    Print "Parent=" & n.Parent.Username
    Print "Source=" & n.Source
    Print "Canonical=" & n.Canonical
    Print "Abbreviated=" & n.Abbreviated
    Print "IsHierarchical=" & CStr(n.IsHierarchical)
    Print "Common=" & n.Common
    Print "Country=" & n.Country
    Print "Organization=" & n.Organization
    Print "OrgUnit1=" & n.OrgUnit1
    Print "OrgUnit2=" & n.OrgUnit2
    Print "OrgUnit3=" & n.OrgUnit3
    Print "OrgUnit4=" & n.OrgUnit4
    Print "ADMD=" & n.ADMD
    Print "PRMD=" & n.PRMD
    Call n.Recycle()

    Set internetName = session.CreateName("Ada Lovelace <ada@example.com>")
    Print "Addr821=" & internetName.Addr821
    Print "Addr822LocalPart=" & internetName.Addr822LocalPart
    Print "Addr822Phrase=" & internetName.Addr822Phrase
    Call internetName.Recycle()

    TestName = 0
End Function

Function TestDateTime(ByVal session As Variant) As Integer
    Dim dt As NotesDateTime
    Print "SECTION=NotesDateTime"

    Set dt = session.CreateDateTime("2026-08-29 08:00:00")
    Print "Parent=" & dt.Parent.Username
    Print "IsValidDate=" & CStr(dt.IsValidDate)
    Print "IsDST=" & CStr(dt.IsDST)
    Print "TimeZone=" & CStr(dt.TimeZone)
    Print "LocalTime=" & dt.LocalTime
    Print "GMTTime=" & dt.GMTTime
    Print "ZoneTime=" & dt.ZoneTime
    Print "DateOnly=" & dt.DateOnly
    Print "TimeOnly=" & dt.TimeOnly
    Call dt.AdjustSecond(1)
    Call dt.AdjustMinute(1)
    Call dt.AdjustHour(1)
    Call dt.AdjustDay(1)
    Call dt.AdjustMonth(1)
    Call dt.AdjustYear(1)
    Call dt.Recycle()

    TestDateTime = 0
End Function

Function TestDatabase(ByVal session As Variant, ByVal db As Variant, ByVal viewName As String, ByVal agentName As String) As Integer
    Dim failures As Integer
    Dim parentSession As NotesSession
    Dim dt As NotesDateTime
    Dim docs As NotesDocumentCollection
    Dim view As NotesView
    Dim temp As NotesDocument
    Dim opened As NotesDocument
    Dim profile As NotesDocument
    Dim result As NotesAgentResult
    Dim agent As NotesAgent
    Dim noteId As String
    Dim unid As String
    Dim errCode As Integer
    Dim oldTitle As String
    Dim oldCategories As String
    Dim oldTemplate As String
    Dim oldDesignTemplate As String
    failures = 0

    Print "SECTION=NotesDatabase"
    Set parentSession = db.Parent
    Print "Parent=" & parentSession.Username
    Print "Server=" & db.Server
    Print "FilePath=" & db.FilePath
    Print "FileName=" & db.FileName
    Print "IsOpen=" & CStr(db.IsOpen)
    Print "Title=" & db.Title
    Print "Categories=" & db.Categories
    Print "TemplateName=" & db.TemplateName
    Print "DesignTemplateName=" & db.DesignTemplateName
    Print "ReplicaID=" & db.ReplicaID
    Print "Size=" & CStr(db.Size)
    Print "PercentUsed=" & CStr(db.PercentUsed)
    Print "CurrentAccessLevel=" & CStr(db.CurrentAccessLevel)
    Print "FileFormat=" & CStr(db.FileFormat)
    Set dt = db.Created
    Print "Created=" & dt.LocalTime
    Call dt.Recycle()
    Set dt = db.LastModified
    Print "LastModified=" & dt.LocalTime
    Call dt.Recycle()

    oldTitle = db.Title
    oldCategories = db.Categories
    oldTemplate = db.TemplateName
    oldDesignTemplate = db.DesignTemplateName
    db.Title = oldTitle & " [XPscript-test]"
    db.Categories = "XPscriptRuntimeTest"
    db.TemplateName = "XPscriptRuntimeTemplate"
    db.DesignTemplateName = "XPscriptRuntimeDesignTemplate"
    db.Title = oldTitle
    db.Categories = oldCategories
    db.TemplateName = oldTemplate
    db.DesignTemplateName = oldDesignTemplate

    Set temp = db.CreateDocument()
    Call temp.ReplaceItemValue("Form", "XPScriptTest")
    Call temp.ReplaceItemValue("Subject", "Full runtime database surface")
    Call temp.Save()
    noteId = temp.NoteID
    unid = temp.UniversalID

    Set opened = db.GetDocumentByID(noteId)
    If opened Is Nothing Then failures = failures + 1 Else Call opened.Recycle()
    Set opened = db.GetDocumentByNoteId(noteId)
    If opened Is Nothing Then failures = failures + 1 Else Call opened.Recycle()
    Set opened = db.OpenDocumentByNoteId(noteId)
    If opened Is Nothing Then failures = failures + 1 Else Call opened.Recycle()
    Set opened = db.GetDocumentByUNID(unid)
    If opened Is Nothing Then failures = failures + 1 Else Call opened.Recycle()
    Set opened = db.OpenDocumentByUNID(unid)
    If opened Is Nothing Then failures = failures + 1 Else Call opened.Recycle()

    Set docs = db.CreateDocumentCollection()
    Call docs.Recycle()
    Set docs = db.AllDocuments
    Call docs.Recycle()
    Set docs = db.Search("Form=\"XPScriptTest\"")
    Call docs.Recycle()
    Set docs = db.Search("Form=\"XPScriptTest\"", 1)
    Call docs.Recycle()

    errCode = 0
    On Error Resume Next
    Set docs = db.FTSearch("XPscript", 10)
    errCode = Err
    On Error GoTo 0
    If errCode = 0 Then
        If docs Is Not Nothing Then Call docs.Recycle()
    Else
        Print "INFO NotesDatabase.FTSearch requires FT index Err=" & CStr(errCode)
    End If

    Set view = db.GetView(viewName)
    If view Is Nothing Then failures = failures + 1 Else Call view.Recycle()
    Set view = db.OpenView(viewName)
    If view Is Nothing Then failures = failures + 1 Else Call view.Recycle()

    Set agent = db.GetAgent(agentName)
    If agent Is Nothing Then failures = failures + 1 Else Call agent.Recycle()

    Set profile = db.GetProfileDocument("XPScriptTestProfile", "FullRuntime")
    Call profile.ReplaceItemValue("XPScriptProfileMarker", "profile-ok")
    Call profile.Save()
    If profile.GetString("XPScriptProfileMarker") <> "profile-ok" Then failures = failures + 1
    If Not profile.IsValid Then failures = failures + 1
    If Not profile.IsProfile Then failures = failures + 1
    If profile.IsDesign Then failures = failures + 1
    Print "ProfileIsValid=" & CStr(profile.IsValid)
    Print "ProfileIsProfile=" & CStr(profile.IsProfile)
    Print "ProfileIsDesign=" & CStr(profile.IsDesign)
    Call profile.Recycle()

    Set result = db.RunAgent(agentName)
    If result Is Nothing Then failures = failures + 1 Else Call result.Recycle()
    Set result = db.RunAgent(agentName, temp)
    If result Is Nothing Then failures = failures + 1 Else Call result.Recycle()

    Call temp.Remove(True)
    Call temp.Recycle()
    TestDatabase = failures
End Function

Function TestDocument(ByVal session As Variant, ByVal db As Variant) As Integer
    Dim failures As Integer
    Dim doc As NotesDocument
    Dim child As NotesDocument
    Dim other As NotesDocument
    Dim copiedDoc As NotesDocument
    Dim designDoc As NotesDocument
    Dim item As NotesItem
    Dim copiedItem As NotesItem
    Dim responses As NotesDocumentCollection
    Dim designNotes As NotesNoteCollection
    Dim dt As NotesDateTime
    Dim values As Variant
    Dim allItems As Variant
    Dim originalUnid As String
    Dim attachmentSaved As Boolean
    Dim designNoteId As String
    Dim i As Integer
    failures = 0
    Print "SECTION=NotesDocument"
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptTest")
    Call doc.ReplaceItemValue("Subject", "Document Surface")
    Call doc.ReplaceItemValue("TextValue", "hello")
    Call doc.SetString("SetStringValue", "world")
    Call doc.SetNumber("NumberValue", 42.5)
    Set dt = session.CreateDateTime("2026-08-29 09:10:11")
    Call doc.SetDateTime("DateValue", dt)
    Call dt.Recycle()
    Call doc.SetValue("GenericValue", "generic")

    If Not doc.IsValid Then failures = failures + 1
    If Not doc.IsNewNote Then failures = failures + 1
    If doc.IsProfile Then failures = failures + 1
    If doc.IsResponse Then failures = failures + 1
    If doc.IsDesign Then failures = failures + 1
    If doc.DesignType <> "" Then failures = failures + 1
    If doc.DesignTitle <> "" Then failures = failures + 1
    If doc.DesignAlias <> "" Then failures = failures + 1

    Print "IsValid=" & CStr(doc.IsValid)
    Print "IsNewNote=" & CStr(doc.IsNewNote)
    Print "IsProfile=" & CStr(doc.IsProfile)
    Print "IsResponse=" & CStr(doc.IsResponse)
    Print "IsDesign=" & CStr(doc.IsDesign)
    Print "DesignType=" & doc.DesignType
    Print "DesignTitle=" & doc.DesignTitle
    Print "DesignAlias=" & doc.DesignAlias

    allItems = doc.Items
    Print "ItemsBounds=" & CStr(LBound(allItems)) & ":" & CStr(UBound(allItems))
    For i = LBound(allItems) To UBound(allItems)
        Print "ITEM[" & CStr(i) & "]=" & allItems(i).Name
    Next
    ForAll itemInDocument In doc.Items
        Print "ITEM-FORALL=" & itemInDocument.Name
    End ForAll

    Call doc.Save()
    Print "NoteID=" & doc.NoteID
    Print "NoteIdHex=" & doc.NoteIdHex
    originalUnid = doc.UniversalID
    doc.UniversalID = originalUnid
    Print "UniversalID=" & doc.UniversalID
    Print "Size=" & CStr(doc.Size)
    Print "ParentDocumentUNID=" & doc.ParentDocumentUNID
    Print "IsDeleted=" & CStr(doc.IsDeleted)

    Set dt = doc.Created
    Call dt.Recycle()
    Set dt = doc.LastModified
    Call dt.Recycle()

    If Not doc.HasItem("TextValue") Then failures = failures + 1
    If doc.GetString("TextValue") <> "hello" Then failures = failures + 1
    Print "GetNumber=" & CStr(doc.GetNumber("NumberValue"))
    Print "GetValue=" & CStr(doc.GetValue("GenericValue"))
    Set dt = doc.GetDateTime("DateValue")
    Call dt.Recycle()
    values = doc.GetItemValue("TextValue")

    Set item = doc.GetFirstItem("TextValue")
    Set copiedItem = doc.CopyItem(item, "CopiedTextValue")
    Call copiedItem.Recycle()
    Call item.Recycle()

    Set other = db.CreateDocument()
    Call doc.CopyAllItems(other)
    Call doc.CopyAllItems(other, True)
    If other.GetString("TextValue") <> "hello" Then failures = failures + 1

    Set copiedDoc = doc.CopyToDatabase(db)
    If copiedDoc Is Nothing Then
        failures = failures + 1
    Else
        Call copiedDoc.Remove(True)
        Call copiedDoc.Recycle()
    End If

    Set child = db.CreateDocument()
    Call child.ReplaceItemValue("Form", "XPScriptTest")
    Call child.MakeResponse(doc)
    Call child.Save()
    If Not child.IsResponse Then failures = failures + 1
    Set responses = doc.Responses
    If responses.Count < 1 Then failures = failures + 1
    Call responses.Recycle()

    Call doc.PutInFolder("XPScript Runtime Folder", True)
    Call doc.RemoveFromFolder("XPScript Runtime Folder")
    Call doc.MarkUnread()
    Call doc.MarkRead()
    Call doc.MarkUnread(session.Username)
    Call doc.MarkRead(session.Username)
    attachmentSaved = doc.SaveAttachment("missing-runtime-attachment.bin", "missing-runtime-attachment.out")
    Print "SaveAttachmentMissing=" & CStr(attachmentSaved)
    Call doc.RemoveItem("GenericValue")

    Set designNotes = db.CreateNoteCollection(False)
    Call designNotes.SelectAllDesignElements(True)
    Call designNotes.BuildCollection()
    designNoteId = designNotes.GetFirstNoteID()
    If designNoteId = "" Then
        failures = failures + 1
    Else
        Set designDoc = db.GetDocumentByID(designNoteId)
        If designDoc Is Nothing Then
            failures = failures + 1
        Else
            If Not designDoc.IsValid Then failures = failures + 1
            If Not designDoc.IsDesign Then failures = failures + 1
            If designDoc.DesignType = "" Then failures = failures + 1
            Print "DESIGN NoteID=" & designNoteId
            Print "DESIGN Type=" & designDoc.DesignType
            Print "DESIGN Title=" & designDoc.DesignTitle
            Print "DESIGN Alias=" & designDoc.DesignAlias
            Call designDoc.Recycle()
        End If
    End If
    Call designNotes.Recycle()

    Call child.Remove(True)
    Call child.Recycle()
    Call other.Recycle()
    Call doc.Remove(True)
    Call doc.Recycle()

    TestDocument = failures
End Function

Function TestDocumentCollection(ByVal db As Variant) As Integer
    Dim failures As Integer
    Dim docs As NotesDocumentCollection
    Dim work As NotesDocumentCollection
    Dim doc As NotesDocument
    Dim nextDoc As NotesDocument
    Dim byId As NotesDocument
    Dim parentDb As NotesDatabase
    Dim noteId As String
    failures = 0

    Print "SECTION=NotesDocumentCollection"
    Set docs = db.Search("Form=\"XPScriptTest\"")
    Set parentDb = docs.Parent
    Print "Parent=" & parentDb.FilePath
    Print "Count=" & CStr(docs.Count)

    Set doc = docs.GetFirstDocument()
    If doc Is Nothing Then
        failures = failures + 1
    Else
        noteId = doc.NoteID
        Set nextDoc = docs.GetNextDocument(doc)
        If nextDoc Is Not Nothing Then Call nextDoc.Recycle()
        Set byId = docs.GetDocument(doc)
        If byId Is Nothing Then failures = failures + 1 Else Call byId.Recycle()
        Set byId = docs.GetDocument(noteId)
        If byId Is Nothing Then failures = failures + 1 Else Call byId.Recycle()
    End If

    Set work = db.CreateDocumentCollection()
    If doc Is Not Nothing Then Call work.AddDocument(doc)
    Call work.AddDocument(docs)
    If doc Is Not Nothing Then Call work.RemoveDocument(doc)
    Call work.RemoveDocument(docs)

    If doc Is Not Nothing Then Call doc.Recycle()
    Call work.Recycle()
    Call docs.Recycle()
    TestDocumentCollection = failures
End Function

Function TestNoteCollection(ByVal db As Variant) As Integer
    Dim failures As Integer
    Dim notes As NotesNoteCollection
    Dim alpha As NotesNoteCollection
    Dim design As NotesNoteCollection
    Dim work As NotesNoteCollection
    Dim parentDb As NotesDatabase
    Dim lastBuild As NotesDateTime
    Dim noteId As String
    Dim seen As Integer
    failures = 0

    Print "SECTION=NotesNoteCollection"

    Set notes = db.CreateNoteCollection(False)
    If notes Is Nothing Then
        TestNoteCollection = 1
        Exit Function
    End If

    Set parentDb = notes.Parent
    If parentDb.FilePath <> db.FilePath Then failures = failures + 1

    notes.SelectDocuments = True
    notes.SelectionFormula = "Form=\"XPScriptTest\""
    Call notes.BuildCollection()
    Print "DocumentCount=" & CStr(notes.Count)
    Set lastBuild = notes.LastBuildTime
    Print "LastBuildTime=" & lastBuild.LocalTime
    Call lastBuild.Recycle()

    seen = 0
    noteId = notes.GetFirstNoteID()
    Do While noteId <> ""
        seen = seen + 1
        noteId = notes.GetNextNoteID(noteId)
    Loop
    If seen <> notes.Count Then failures = failures + 1

    Set design = db.CreateNoteCollection(False)
    Call design.SelectAllDesignElements(True)
    Call design.BuildCollection()
    Print "DesignCount=" & CStr(design.Count)
    If design.Count = 0 Then failures = failures + 1

    Set alpha = db.CreateNoteCollection(False)
    alpha.SelectDocuments = True
    alpha.SelectionFormula = "Subject=\"Alpha\""
    Call alpha.BuildCollection()
    If alpha.Count <> 1 Then failures = failures + 1

    Call notes.ClearCollection()
    Call notes.BuildCollection()

    Set work = db.CreateNoteCollection(False)
    work.SelectDocuments = True
    work.SelectionFormula = "Subject=\"XPscript-no-match\""
    Call work.BuildCollection()
    If work.Count <> 0 Then failures = failures + 1
    Call work.Add(alpha)
    If work.Count <> alpha.Count Then failures = failures + 1
    Call work.Intersect(alpha)
    If work.Count <> alpha.Count Then failures = failures + 1
    Call work.Remove(alpha)
    If work.Count <> 0 Then failures = failures + 1

    Call work.Recycle()
    Call alpha.Recycle()
    Call design.Recycle()
    Call notes.Recycle()
    TestNoteCollection = failures
End Function

Function TestItemAndRichText(ByVal session As Variant, ByVal db As Variant, ByVal viewName As String) As Integer
    Dim failures As Integer
    Dim doc As NotesDocument
    Dim other As NotesDocument
    Dim fixtureDoc As NotesDocument
    Dim item As NotesItem
    Dim copied As NotesItem
    Dim rich As NotesRichTextItem
    Dim dt As NotesDateTime
    Dim values As Variant
    Dim view As NotesView
    Dim saved As Boolean
    failures = 0

    Print "SECTION=NotesItem/NotesRichTextItem"
    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptTest")
    Set item = doc.ReplaceItemValue("ItemSurface", "one")
    Print "Parent=" & item.Parent.NoteID
    Print "Name=" & item.Name
    Print "Text=" & item.Text
    Print "Type=" & CStr(item.Type)
    Print "ValueLength=" & CStr(item.ValueLength)

    Set dt = item.LastModified
    Call dt.Recycle()

    item.IsAuthors = True
    item.IsAuthors = False
    item.IsNames = True
    item.IsReaders = True
    item.IsReaders = False
    item.IsEncrypted = True
    item.IsEncrypted = False
    item.IsProtected = True
    item.IsProtected = False
    item.IsSigned = True
    item.IsSigned = False
    item.IsSummary = True
    values = item.Values
    item.Values = Array("one", "two")

    Set other = db.CreateDocument()
    Set copied = item.CopyToDocument(other)
    Call copied.Recycle()
    Set copied = item.CopyToDocument(other, "RenamedItemSurface")
    Call copied.Recycle()
    Call item.Recycle()

    Set dt = session.CreateDateTime("2026-08-29 10:11:12")
    Call doc.SetDateTime("DateItem", dt)
    Call dt.Recycle()
    Set item = doc.GetFirstItem("DateItem")
    Set dt = item.DateTimeValue
    If dt Is Nothing Then failures = failures + 1 Else item.DateTimeValue = dt
    If Not dt Is Nothing Then Call dt.Recycle()
    Call item.Recycle()

    Set item = doc.CreateNotesItem("EmptyItem")
    Call item.Remove()
    Call item.Recycle()

    Set view = db.GetView(viewName)
    Set fixtureDoc = view.GetFirstDocument()
    If fixtureDoc Is Nothing Then
        failures = failures + 1
    Else
        Set item = fixtureDoc.GetFirstItem("Body")
        If item Is Nothing Then
            failures = failures + 1
        ElseIf item.Type = 1 Then
            Set rich = item
            Print "RichText=" & rich.Text
            saved = rich.SaveAttachment("missing-runtime-attachment.bin", "missing-runtime-attachment.out")
            Print "RichTextSaveAttachmentMissing=" & CStr(saved)
            Call rich.Recycle()
        Else
            failures = failures + 1
            Call item.Recycle()
        End If
        Call fixtureDoc.Recycle()
    End If

    Call view.Recycle()
    Call other.Recycle()
    Call doc.Recycle()
    TestItemAndRichText = failures
End Function

Function TestAgent(ByVal db As Variant, ByVal agentName As String) As Integer
    Dim failures As Integer
    Dim agent As NotesAgent
    Dim result As NotesAgentResult
    Dim runResult As Variant
    Dim doc As NotesDocument
    failures = 0

    Print "SECTION=NotesAgent/NotesAgentResult"

    Set agent = db.GetAgent(agentName)
    If agent Is Nothing Then
        failures = failures + 1
    Else
        If agent.Name <> agentName Then failures = failures + 1
        If agent.Parent.FilePath <> db.FilePath Then failures = failures + 1
        Print "AgentName=" & agent.Name
        Print "AgentOwner=" & agent.Owner
        Print "AgentComment=" & agent.Comment
        Print "AgentIsEnabled=" & CStr(agent.IsEnabled)
        Print "AgentTrigger=" & CStr(agent.Trigger)
        runResult = agent.Run()
        Print "AgentRun=" & CStr(runResult)
        Call agent.Recycle()
    End If

    Set result = db.RunAgent(agentName)
    If result Is Nothing Then
        failures = failures + 1
    Else
        Print "Success=" & CStr(result.Success)
        Print "Status=" & CStr(result.Status)
        Print "Output=" & result.Output
        Call result.Recycle()
    End If

    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", "XPScriptTest")
    Set result = db.RunAgent(agentName, doc)
    If result Is Nothing Then failures = failures + 1 Else Call result.Recycle()
    Call doc.Recycle()

    TestAgent = failures
End Function

Function TestStream(ByVal session As Variant) As Integer
    Dim failures As Integer
    Dim stream As NotesStream
    Dim text As String
    Dim errCode As Integer
    Dim streamPath As String
    failures = 0
    streamPath = "xpscript-full-runtime-stream-test.txt"

    Print "SECTION=NotesStream"

    If FileExists(streamPath) Then
        On Error Resume Next
        Kill streamPath
        On Error GoTo 0
    End If

    Set stream = session.CreateStream()
    If stream Is Nothing Then
        TestStream = 1
        Exit Function
    End If

    If stream.Bytes <> 0 Then failures = failures + 1
    If stream.Position <> 0 Then failures = failures + 1
    If Not stream.IsEOS Then failures = failures + 1

    stream.Charset = "UTF-8"
    Call stream.WriteText("Alpha" & Chr(10) & "Beta")
    If stream.Bytes = 0 Then failures = failures + 1
    stream.Position = 0
    text = stream.ReadText()
    If text <> "Alpha" & Chr(10) & "Beta" Then failures = failures + 1
    Call stream.Close()

    If Not stream.Open(streamPath) Then
        failures = failures + 1
    Else
        Call stream.WriteText("stream-file")
        Call stream.Close()

        If Not stream.Open(streamPath) Then
            failures = failures + 1
        Else
            stream.Position = 0
            If stream.ReadText() <> "stream-file" Then failures = failures + 1
            Call stream.Close()
        End If
    End If

    Print "StreamBytes=" & CStr(stream.Bytes)
    Print "StreamPosition=" & CStr(stream.Position)
    Print "StreamIsEOS=" & CStr(stream.IsEOS)
    Print "StreamCharset=" & stream.Charset

    Call stream.Recycle()

    errCode = 0
    On Error Resume Next
    If FileExists(streamPath) Then Kill streamPath
    errCode = Err
    On Error GoTo 0
    If errCode <> 0 Then
        Print "INFO NotesStream temp cleanup Err=" & CStr(errCode)
    End If

    TestStream = failures
End Function

Function TestView(ByVal db As Variant, ByVal viewName As String) As Integer
    Dim failures As Integer
    Dim view As NotesView
    Dim doc As NotesDocument
    Dim nextDoc As NotesDocument
    Dim docs As NotesDocumentCollection
    Dim names As Variant
    Dim errCode As Integer
    failures = 0

    Print "SECTION=NotesView"
    Set view = db.GetView(viewName)
    If view Is Nothing Then
        TestView = 1
        Exit Function
    End If

    Print "Name=" & view.Name
    names = view.ColumnNames
    Print "ColumnCount=" & CStr(UBound(names) - LBound(names) + 1)
    view.AutoUpdate = False
    view.AutoUpdate = True

    Set doc = view.GetFirstDocument()
    If doc Is Nothing Then
        failures = failures + 1
    Else
        Set nextDoc = view.GetNextDocument(doc)
        If nextDoc Is Not Nothing Then Call nextDoc.Recycle()
        Call doc.Recycle()
    End If

    Set doc = view.GetDocumentByKey("Alpha", True)
    If doc Is Nothing Then failures = failures + 1 Else Call doc.Recycle()
    Set doc = view.GetDocumentByKey("Al", False)
    If doc Is Nothing Then failures = failures + 1 Else Call doc.Recycle()

    Set docs = view.GetAllDocumentsByKey("Alpha", True)
    If docs.Count < 1 Then failures = failures + 1
    Call docs.Recycle()
    Set docs = view.GetAllDocumentsByKey("Al", False)
    If docs.Count < 1 Then failures = failures + 1
    Call docs.Recycle()

    errCode = 0
    On Error Resume Next
    Set docs = view.FTSearch("Alpha", 10)
    errCode = Err
    On Error GoTo 0
    If errCode = 0 Then
        If docs Is Not Nothing Then Call docs.Recycle()
    Else
        Print "INFO NotesView.FTSearch requires FT index Err=" & CStr(errCode)
    End If

    Call view.Refresh()
    Call view.Recycle()
    TestView = failures
End Function

Function TestViewNavigationV1(ByVal db As Variant, ByVal viewName As String) As Integer
    Dim failures As Integer
    Dim view As NotesView
    Dim nav As Variant
    Dim entries As Variant
    Dim keyEntries As Variant
    Dim entry As Variant
    Dim nextEntry As Variant
    Dim lookupEntry As Variant
    Dim doc As Variant
    Dim values As Variant
    failures = 0

    Print "SECTION=NotesViewEntry/Collection/Navigator V1"
    Set view = db.GetView(viewName)
    entries = view.AllEntries
    If entries.Count < 2 Then failures = failures + 1

    entry = entries.GetFirstEntry()
    If entry Is Nothing Then
        failures = failures + 1
    Else
        If Not entry.IsDocument Then failures = failures + 1
        If entry.IsCategory Then failures = failures + 1
        If entry.IsTotal Then failures = failures + 1
        If Not entry.IsValid Then failures = failures + 1
        If entry.NoteID = "" Then failures = failures + 1
        If entry.UniversalID = "" Then failures = failures + 1
        Print "Position=" & entry.GetPosition()
        Print "PositionSlash=" & entry.GetPosition("/")
        values = entry.ColumnValues
        Set doc = entry.Document
        nextEntry = entries.GetNextEntry(entry)
        If nextEntry Is Not Nothing Then Call nextEntry.Recycle()
        lookupEntry = entries.GetEntry(doc)
        If lookupEntry Is Nothing Then failures = failures + 1 Else Call lookupEntry.Recycle()
        If Not entries.Contains(doc) Then failures = failures + 1
        Call entry.Recycle()
    End If

    nav = view.CreateViewNav()
    If nav.Count < entries.Count Then failures = failures + 1
    entry = nav.GetFirst()
    If entry Is Nothing Then failures = failures + 1 Else Call entry.Recycle()
    entry = nav.GetLast()
    If entry Is Nothing Then failures = failures + 1 Else Call entry.Recycle()
    entry = nav.GetFirstDocument()
    If entry Is Nothing Then
        failures = failures + 1
    Else
        lookupEntry = nav.GetCurrent()
        If lookupEntry Is Nothing Then failures = failures + 1 Else Call lookupEntry.Recycle()
        nextEntry = nav.GetNextDocument()
        If nextEntry Is Not Nothing Then Call nextEntry.Recycle()
        Call entry.Recycle()
    End If

    entry = view.GetEntryByKey("Alpha")
    If entry Is Nothing Then failures = failures + 1 Else Call entry.Recycle()
    keyEntries = view.GetAllEntriesByKey("Alpha")
    If keyEntries.Count < 1 Then failures = failures + 1

    If Not doc Is Nothing Then Call doc.Recycle()
    Call keyEntries.Recycle()
    Call entries.Recycle()
    Call nav.Recycle()
    Call view.Recycle()
    TestViewNavigationV1 = failures
End Function

Function TestViewNavigationV2(ByVal db As Variant, ByVal viewName As String) As Integer
    Dim failures As Integer
    Dim view As NotesView
    Dim nav As Variant
    Dim defaultNav As Variant
    Dim category As Variant
    Dim child As Variant
    Dim sibling As Variant
    Dim parent As Variant
    Dim subset As Variant
    Dim posEntry As Variant
    failures = 0

    Print "SECTION=NotesViewNavigator V2 hierarchy/cache"
    Set view = db.GetView(viewName)
    If view Is Nothing Then
        TestViewNavigationV2 = 1
        Exit Function
    End If

    view.AutoUpdate = False
    defaultNav = view.CreateViewNav()
    If defaultNav.BufferMaxEntries <> 64 Then failures = failures + 1
    If defaultNav.CacheSize <> 64 Then failures = failures + 1
    Call defaultNav.Recycle()

    nav = view.CreateViewNav(2)
    If nav.BufferMaxEntries <> 2 Then failures = failures + 1
    If nav.CacheSize <> 2 Then failures = failures + 1

    category = nav.GetFirst()
    If category Is Nothing Then
        failures = failures + 1
    Else
        If Not category.IsCategory Then failures = failures + 1
        Print "ChildCount=" & CStr(category.ChildCount)
        Print "DescendantCount=" & CStr(category.DescendantCount)
        Print "SiblingCount=" & CStr(category.SiblingCount)
        Print "IndentLevel=" & CStr(category.IndentLevel)
        Print "ColumnIndentLevel=" & CStr(category.ColumnIndentLevel)

        child = nav.GetChild(category)
        If child Is Nothing Then
            failures = failures + 1
        Else
            parent = nav.GetParent(child)
            If parent Is Nothing Then failures = failures + 1 Else Call parent.Recycle()
            sibling = nav.GetNextSibling(child)
            If sibling Is Not Nothing Then Call sibling.Recycle()
            posEntry = nav.GetPos(child.GetPosition(), ".")
            If posEntry Is Nothing Then failures = failures + 1 Else Call posEntry.Recycle()
            Call child.Recycle()
        End If

        subset = view.CreateViewNavFromChildren(category)
        Call subset.Recycle()
        subset = view.CreateViewNavFromDescendants(category)
        Call subset.Recycle()
        subset = view.CreateViewNavFromCategory("Group A")
        Call subset.Recycle()
        Call category.Recycle()
    End If

    nav.BufferMaxEntries = 512
    If nav.BufferMaxEntries <> 512 Then failures = failures + 1
    nav.BufferMaxEntries = 999
    If nav.BufferMaxEntries <> 512 Then failures = failures + 1
    nav.CacheSize = 2
    If nav.BufferMaxEntries <> 2 Then failures = failures + 1
    nav.MaxLevel = 0
    posEntry = nav.GetNth(1)
    If posEntry Is Not Nothing Then
        Call nav.GotoEntry(posEntry)
        Call nav.GotoNext(posEntry)
        Call posEntry.Recycle()
    End If

    Call view.Refresh()
    Call nav.Recycle()
    Call view.Recycle()
    TestViewNavigationV2 = failures
End Function

Function TestViewNavigationV3(ByVal db As Variant, ByVal viewName As String) As Integer
    Dim failures As Integer
    Dim view As NotesView
    Dim entries As Variant
    Dim cloneEntries As Variant
    Dim otherEntries As Variant
    Dim nav As Variant
    Dim entry As Variant
    failures = 0

    Print "SECTION=NotesViewEntryCollection/Navigator V3"
    Set view = db.GetView(viewName)
    entries = view.AllEntries
    cloneEntries = entries.Clone()
    If cloneEntries.Count <> entries.Count Then failures = failures + 1

    otherEntries = view.GetAllEntriesByKey("Alpha")
    cloneEntries.Intersect(otherEntries)
    cloneEntries = entries.Clone()
    cloneEntries.Subtract(otherEntries)
    cloneEntries.Merge(otherEntries)
    cloneEntries = entries.Clone()
    cloneEntries.FTSearch("Alpha", 10)
    If cloneEntries.Query <> "Alpha" Then failures = failures + 1

    entry = entries.GetFirstEntry()
    If entry Is Nothing Then
        failures = failures + 1
    Else
        Print "GetRead=" & CStr(entry.GetRead())
        Print "IsConflict=" & CStr(entry.IsConflict)
        Call entry.Recycle()
    End If

    entries.MarkAllUnread()
    otherEntries = view.GetAllUnreadEntries()
    Call otherEntries.Recycle()
    nav = view.CreateViewNavFromAllUnread()
    nav.MarkAllRead()
    Call nav.Recycle()
    otherEntries = view.GetAllReadEntries()
    Call otherEntries.Recycle()

    If False Then
        Call entries.PutAllInFolder("XPScriptV3", True)
        Call entries.RemoveAllFromFolder("XPScriptV3")
        Call entries.StampAll("XPScriptV3Stamp", "ok")
        Call entries.UpdateAll()
    End If

    Call cloneEntries.Recycle()
    Call entries.Recycle()
    Call view.Recycle()
    TestViewNavigationV3 = failures
End Function

Function TestDXL(ByVal session As Variant, ByVal db As Variant) As Integer
    Dim failures As Integer
    Dim importer As NotesDXLImporter
    Dim exporter As NotesDXLExporter
    Dim docs As NotesDocumentCollection
    Dim notes As NotesNoteCollection
    Dim doc As NotesDocument
    Dim errCode As Integer
    failures = 0

    Print "SECTION=NotesDXLImporter/NotesDXLExporter"

    Set importer = session.CreateDXLImporter()
    If importer Is Nothing Then
        failures = failures + 1
    Else
        importer.ACLImportOption = 1
        importer.DesignImportOption = 6
        importer.DocumentImportOption = 6
        importer.CreateFTIndex = False
        importer.ReplaceDbProperties = False
        importer.InputValidationOption = 2
        importer.ReplicaRequiredForReplaceOrUpdate = False
        importer.ExitOnFirstFatalError = True
        importer.UnknownTokenLogOption = 1
        Print "ImporterImportedNoteCount=" & CStr(importer.ImportedNoteCount)
        Call importer.Recycle()
    End If

    Set exporter = session.CreateDXLExporter()
    If exporter Is Nothing Then
        TestDXL = failures + 1
        Exit Function
    End If

    exporter.RichTextOption = 0
    exporter.ValidationStyle = 1
    exporter.MIMEOption = 0
    exporter.ForceNoteFormat = False
    exporter.ExitOnFirstFatalError = True
    exporter.OutputDOCTYPE = True
    exporter.ConvertNotesBitmapsToGIF = False
    exporter.OmitRichtextAttachments = False
    exporter.OmitOLEObjects = False
    exporter.OmitMiscFileObjects = False
    exporter.OmitRichtextPictures = False

    errCode = 0
    On Error Resume Next
    Call exporter.ExportDatabaseDesign(db, "out/notes-dxl-runtime/database-design.dxl")
    errCode = Err
    On Error GoTo 0
    If errCode <> 0 Then
        failures = failures + 1
        Print "DXL-EXPORT-ERROR DatabaseDesign=" & CStr(errCode)
        Print exporter.Log
    End If

    errCode = 0
    On Error Resume Next
    Call exporter.ExportDesignElement(db, "XPScriptTest", "Form", "out/notes-dxl-runtime/form-XPScriptTest.dxl")
    errCode = Err
    On Error GoTo 0
    If errCode <> 0 Then
        failures = failures + 1
        Print "DXL-EXPORT-ERROR DesignElement=" & CStr(errCode)
        Print exporter.Log
    End If

    Set docs = db.Search("Form=\"XPScriptTest\"", 2)
    If docs Is Nothing Or docs.Count = 0 Then
        failures = failures + 1
    Else
        Set doc = docs.GetFirstDocument()
        If doc Is Nothing Then
            failures = failures + 1
        Else
            errCode = 0
            On Error Resume Next
            Call exporter.ExportDocument(doc, "out/notes-dxl-runtime/document.dxl")
            errCode = Err
            On Error GoTo 0
            If errCode <> 0 Then
                failures = failures + 1
                Print "DXL-EXPORT-ERROR Document=" & CStr(errCode)
                Print exporter.Log
            End If
            Call doc.Recycle()
        End If

        errCode = 0
        On Error Resume Next
        Call exporter.ExportDocumentCollection(docs, "out/notes-dxl-runtime/document-collection.dxl")
        errCode = Err
        On Error GoTo 0
        If errCode <> 0 Then
            failures = failures + 1
            Print "DXL-EXPORT-ERROR DocumentCollection=" & CStr(errCode)
            Print exporter.Log
        End If
    End If

    Set notes = db.CreateNoteCollection(False)
    Call notes.SelectAllDesignElements(True)
    Call notes.BuildCollection()
    errCode = 0
    On Error Resume Next
    Call exporter.Export(notes, "out/notes-dxl-runtime/note-collection.dxl")
    errCode = Err
    On Error GoTo 0
    If errCode <> 0 Then
        failures = failures + 1
        Print "DXL-EXPORT-ERROR NoteCollection=" & CStr(errCode)
        Print exporter.Log
    End If

    Call notes.Recycle()
    If Not docs Is Nothing Then Call docs.Recycle()
    Call exporter.Recycle()
    TestDXL = failures
End Function

Function TestComputeWithForm(ByVal db As Variant, ByVal validForm As String, ByVal errorForm As String) As Integer
    Dim failures As Integer
    Dim doc As NotesDocument
    Dim failedFields As Variant
    Dim ok As Boolean
    Dim errCode As Integer
    Dim i As Integer
    Dim failedFieldCount As Integer
    failures = 0

    Print "SECTION=NotesDocument.ComputeWithForm"

    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", validForm)
    ok = doc.ComputeWithForm(False, False, failedFields)
    If Not ok Then
        failures = failures + 1
        Print "FAIL CWF valid form returned False"
    End If
    If doc.GetString("CWFDefault") <> "DEFAULT-VALUE" Then
        failures = failures + 1
        Print "FAIL CWF valid form default value=" & doc.GetString("CWFDefault")
    End If
    Call doc.Recycle()

    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", errorForm)
    failedFields = "SENTINEL"
    ok = doc.ComputeWithForm(False, False, failedFields)
    If ok Then
        failures = failures + 1
        Print "FAIL CWF error form raiseError=False returned True"
    End If
    If failedFields Is Not Nothing Then
        failures = failures + 1
        Print "FAIL CWF error form raiseError=False did not clear failedFields"
    End If
    Call doc.Recycle()

    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", errorForm)
    failedFields = "SENTINEL"
    errCode = 0
    On Error Resume Next
    Call doc.ComputeWithForm(False, True, failedFields)
    errCode = Err
    On Error GoTo 0
    If errCode = 0 Then
        failures = failures + 1
        Print "FAIL CWF error form raiseError=True did not raise"
    Else
        Print "CWF expected validation Err=" & CStr(errCode)
        If errCode <> 5 Then
            failures = failures + 1
            Print "FAIL CWF error form raiseError=True Err=" & CStr(errCode) & " expected=5"
        End If
    End If
    If failedFields Is Nothing Then
        failures = failures + 1
        Print "FAIL CWF error form raiseError=True did not populate failedFields"
    Else
        failedFieldCount = 0
        For i = LBound(failedFields) To UBound(failedFields)
            Print "CWF failedFields(" & CStr(i) & ")=" & CStr(failedFields(i))
            failedFieldCount = failedFieldCount + 1
            If CStr(failedFields(i)) = "" Then
                failures = failures + 1
                Print "FAIL CWF failedFields contains an empty field name"
            End If
        Next
        If failedFieldCount = 0 Then
            failures = failures + 1
            Print "FAIL CWF failedFields array is empty"
        End If
    End If
    Call doc.Recycle()

    Set doc = db.CreateDocument()
    Call doc.ReplaceItemValue("Form", errorForm)
    errCode = 0
    On Error Resume Next
    Call doc.ComputeWithForm(False, True)
    errCode = Err
    On Error GoTo 0
    If errCode <> 5 Then
        failures = failures + 1
        Print "FAIL CWF ordinary two-argument Err=" & CStr(errCode) & " expected=5"
    End If
    Call doc.Recycle()

    TestComputeWithForm = failures
End Function

Function TestDatabaseLifecycle(ByVal session As Variant) As Integer
    Const TEMP_DATABASE = "xpscript-full-runtime-lifecycle-test.nsf"
    Dim failures As Integer
    Dim db As NotesDatabase
    Dim reopened As NotesDatabase
    failures = 0

    Print "SECTION=NotesDatabase lifecycle"
    Set db = session.OpenDatabase("", TEMP_DATABASE)
    If db.IsOpen Then Call db.Remove()
    Call db.Recycle()

    Set db = session.OpenDatabase("", TEMP_DATABASE)
    If db.IsOpen Then
        failures = failures + 1
    Else
        Call db.Create("", "", True)
        If Not db.IsOpen Then failures = failures + 1
        If db.FilePath <> TEMP_DATABASE Then failures = failures + 1
        Call db.Remove()
    End If
    Call db.Recycle()

    Set reopened = session.OpenDatabase("", TEMP_DATABASE)
    If reopened.IsOpen Then failures = failures + 1
    Call reopened.Recycle()

    TestDatabaseLifecycle = failures
End Function
