' Opens the local testdb database and runs XPScriptFormulaAgent.
Option Declare

Sub Main()
    Const DATABASE_PATH = "testdb.nsf"
    Const AGENT_NAME = "XPScriptFormulaAgent"

    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim agent As NotesAgent

    Set session = Nothing
    Set db = Nothing
    Set agent = Nothing
    On Error GoTo Handler

    Set session = New NotesSession()
    Set db = session.OpenDatabase("", DATABASE_PATH)

    If Not db.IsOpen Then
        Error 53, "Unable to open " & DATABASE_PATH
    End If

    Set agent = db.GetAgent(AGENT_NAME)
    If agent Is Nothing Then
        Print "Agent not found: " & AGENT_NAME
    Else
        Print "Agent: " & agent.Name
        Call agent.Run()
        Print "Output: " & agent.ReturnMessage
        Call agent.Recycle()
    End If

    Call db.Recycle()
    Call session.Recycle()
    Exit Sub

Handler:
    Print "Agent execution failed. Error=" & CStr(Err) & " Description=" & Error$
End Sub
