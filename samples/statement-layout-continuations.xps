Class LayoutHolder
    Private storedValue As Integer

    Property Get Value() _
        As Integer
        Value = storedValue
    End Property

    Property Set Value() _
        As Integer
        storedValue = Value
    End Property
End Class

Sub AddValues( _
    ByVal a As Integer, _
    ByVal b As Integer)
    Print "PROC=" & CStr(a + b)
End Sub

Sub Main()
    Dim i As Integer
    Dim holder As New LayoutHolder

    For i = 1 To _
        2
        Print "FOR=" & CStr(i)
    Next

    i = 0
    Do While _
        i < 1
        Print "DO=OK"
        i = i + 1
    Loop

    While _
        i < 2
        Print "WHILE=OK"
        i = i + 1
    Wend

    Select Case _
        i
    Case 1 To _
        2
        Print "SELECT=OK"
    Case Else
        Print "SELECT=BAD"
    End Select

    Set holder = New LayoutHolder
    holder.Value = 7
    With _
        holder
        Print "WITH=" & CStr(.Value)
    End With

    Call AddValues( _
        1, _
        2)
End Sub
