' NotesView navigation V3 collection, unread and bulk-operation regression.
' Requires samples/xpscript-notes-runtime-fixture.dxl imported into xpscript.nsf.

Option Declare

Sub Main()
    Const NOTES_RUNTIME = "C:\Program Files\HCL\Notes"
    Const DATABASE_PATH = "xpscript.nsf"
    Const VIEW_NAME = "XPScriptTestView"

    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim view As NotesView
    Dim entries As Variant
    Dim cloneEntries As Variant
    Dim otherEntries As Variant
    Dim nav As Variant
    Dim entry As Variant
    Dim failures As Integer

    failures = 0
    Set session = New NotesSession(NOTES_RUNTIME)
    Set db = session.OpenDatabase("", DATABASE_PATH)
    Set view = db.GetView(VIEW_NAME)

    If view Is Nothing Then
        Print "FAIL V3 view missing"
        Exit Sub
    End If

    entries = view.AllEntries
    If entries.Count < 2 Then failures = failures + 1
    If entries.Query <> "" Then failures = failures + 1

    cloneEntries = entries.Clone()
    If cloneEntries.Count <> entries.Count Then failures = failures + 1

    otherEntries = view.GetAllEntriesByKey("Alpha")
    cloneEntries.Intersect(otherEntries)
    If cloneEntries.Count <> 1 Then failures = failures + 1

    cloneEntries = entries.Clone()
    cloneEntries.Subtract(otherEntries)
    If cloneEntries.Count <> entries.Count - 1 Then failures = failures + 1
    cloneEntries.Merge(otherEntries)
    If cloneEntries.Count <> entries.Count Then failures = failures + 1

    cloneEntries = entries.Clone()
    cloneEntries.FTSearch("Alpha", 10)
    If cloneEntries.Query <> "Alpha" Then failures = failures + 1
    If cloneEntries.Count < 1 Then failures = failures + 1

    entry = entries.GetFirstEntry()
    If entry Is Nothing Then
        failures = failures + 1
    Else
        If Not entry.GetRead() Then
            ' The fixture may start unread. V3 only verifies the method is callable here.
        End If
        Call entry.Recycle()
    End If

    entries.MarkAllUnread()
    otherEntries = view.GetAllUnreadEntries()
    If otherEntries.Count < entries.Count Then failures = failures + 1
    Call otherEntries.Recycle()

    nav = view.CreateViewNavFromAllUnread()
    If nav.Count < entries.Count Then failures = failures + 1
    nav.MarkAllRead()
    Call nav.Recycle()

    otherEntries = view.GetAllReadEntries()
    If otherEntries.Count < entries.Count Then failures = failures + 1
    Call otherEntries.Recycle()

    ' Compile the destructive bulk surface without changing the shared fixture.
    If False Then
        Call entries.PutAllInFolder("XPScriptV3", True)
        Call entries.RemoveAllFromFolder("XPScriptV3")
        Call entries.StampAll("XPScriptV3Stamp", "ok")
        Call entries.UpdateAll()
    End If

    Call cloneEntries.Recycle()
    Call otherEntries.Recycle()
    Call entries.Recycle()
    Call view.Recycle()
    Call db.Recycle()
    Call session.Recycle()

    If failures = 0 Then
        Print "NOTES-VIEW-NAVIGATION-V3=PASS"
    Else
        Print "NOTES-VIEW-NAVIGATION-V3=FAIL COUNT=" & CStr(failures)
    End If
End Sub
