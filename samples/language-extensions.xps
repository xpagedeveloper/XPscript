Option Declare

Enum BuildState
    BuildUnknown = 0
    BuildReady = 10
    BuildRunning
    BuildDone = 20
End Enum

Type PersonInfo
    Name As String
    Age As Integer
End Type

Class NameBox
    Private m_name As String

    Property Get Name As String
        Name = m_name
    End Property

    Property Let Name As String
        m_name = Name
    End Property
End Class

Function MakeGreeting(name As String, Optional prefix As String = "Hello") As String
    MakeGreeting = prefix & " " & name
End Function

Sub ShowValue(value As Integer, Optional label As String = "VALUE")
    Print label & "=" & CStr(value)
End Sub

Sub Main()
    Dim state As BuildState
    Dim person As PersonInfo
    Dim box As New NameBox

    state = BuildRunning
    person.Name = "Fredrik"
    person.Age = 40
    box.Name = "PropertyLet"

    Print "ENUM=" & CStr(state)
    Print "ENUMQUAL=" & CStr(BuildState.BuildDone)
    Print "TYPE=" & person.Name & ":" & CStr(person.Age)
    Print "OPTIONAL=" & MakeGreeting("Fredrik")
    Print "OPTIONAL2=" & MakeGreeting("Fredrik", "Hi")
    Print "PROPERTYLET=" & box.Name
    Print "STRCONV=" & StrConv("hello world", 1)
    Print "CTYPE=" & CStr(CType("42", "Integer"))
    Call ShowValue(7)
    Call ShowValue(8, "COUNT")
End Sub
