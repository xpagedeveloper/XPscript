' Requires local xpscript.nsf. Uses an unsaved document only.
Option Declare
Sub Main()
    Dim session As NotesSession
    Dim db As NotesDatabase
    Dim doc As NotesDocument
    Dim item As NotesItem
    Dim firstDate As NotesDateTime
    Dim secondDate As NotesDateTime
    Dim values As Variant
    Dim errorCode As Long
    Dim typedValues(3 To 4) As String
    Set session = New NotesSession()
    Set db = session.OpenDatabase("", "xpscript.nsf")
    Set doc = db.CreateDocument()
    Set item = doc.ReplaceItemValue("ArrayValues", "initial")
    item.Values = Array("one", "two")
    values = item.Values
    If UBound(values) <> 1 Then Error 5, "Text list length"
    If values(0) <> "one" Or values(1) <> "two" Then Error 5, "Text list values"
    item.Values = Array(12, 34)
    values = item.Values
    If UBound(values) <> 1 Then Error 5, "Number list length"
    If values(0) <> 12 Or values(1) <> 34 Then Error 5, "Number list values"
    Set firstDate = session.CreateDateTimeNow()
    Set secondDate = session.CreateDateTimeNow()
    item.Values = Array(firstDate, secondDate)
    values = item.Values
    If UBound(values) <> 1 Then Error 5, "Date list length"
    item.Values = Array("single")
    values = item.Values
    If UBound(values) <> 0 Then Error 5, "Single-element list length"
    If values(0) <> "single" Then Error 5, "Single-element list value"
    typedValues(3) = "lower"
    typedValues(4) = "upper"
    item.Values = typedValues
    values = item.Values
    If values(0) <> "lower" Or values(1) <> "upper" Then Error 5, "Nonzero-bound array values"
    On Error Resume Next
    item.Values = Array("mixed", 12)
    errorCode = Err
    On Error GoTo 0
    If errorCode <> 13 Then Error 5, "Mixed array must fail with error 13"
    values = item.Values
    If values(0) <> "lower" Or values(1) <> "upper" Then Error 5, "Rejected value changed the item"
    item.Values = Array()
    If item.Text <> "" Then Error 5, "Empty array must write empty text"
    Call secondDate.Recycle()
    Call firstDate.Recycle()
    Call item.Recycle()
    Call doc.Recycle()
    Call db.Recycle()
    Call session.Recycle()
    Print "NOTES-ITEM-ARRAY=PASS"
End Sub
