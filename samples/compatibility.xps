Option Declare

Sub Main()
    Dim f As Integer
    Dim lineText As String
    Dim d As Date
    Dim n As Double

    Print UCase("xpscript")
    Print FullTrim("  a   b  ")
    Print Left("abcdef", 2)
    Print Right("abcdef", 2)
    Print Mid("abcdef", 2, 3)
    Print CStr(Instr(1, "abcdef", "cd"))
    Print Replace("abcabc", "b", "X")
    Print Hex(255)
    Print Bin(10)
    Print CStr(Sqr(9))
    Print CStr(Sgn(-4))
    Print CStr(Sin(0))
    Print CStr(Cos(0))
    Print CStr(Tan(0))

    If "A\"B" <> "A""B" Then
        Error 9201, "Escaped quote normalization failed"
    End If
    Print "ESCAPED-QUOTE-OK"

    d = DateNumber(2026, 8, 11)
    Print CStr(Year(d))
    Print CStr(Month(d))
    Print CStr(Day(d))
    Print CStr(DateDiff("d", d, DateAdd("d", 5, d)))

    n = Val("123.5xyz")
    Print CStr(n)

    f = FreeFile()
    Open "xpscript-compat.txt" For Output As #f
    Print #f, "FILE-OK"
    Close #f

    f = FreeFile()
    Open "xpscript-compat.txt" For Input As #f
    Line Input #f, lineText
    Close #f
    Print lineText
    Print CStr(FileLen("xpscript-compat.txt"))
    Kill "xpscript-compat.txt"
End Sub
