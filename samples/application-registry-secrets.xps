' Cross-platform Application.Registry and Application.Secrets surface.
Option Declare

Sub CompileOnlySurface()
    Dim binaryValue(0 To 2) As Byte
    Dim multiValue(0 To 1) As String
    Dim value As Variant

    binaryValue(0) = 1
    binaryValue(1) = 2
    binaryValue(2) = 255
    multiValue(0) = "alpha"
    multiValue(1) = "beta"

    Call Application.Registry.User.Set("Software/XPscript/Surface", "Text", "value")
    Call Application.Registry.User.Set("Software/XPscript/Surface", "Expandable", "%PATH%", "ExpandString")
    Call Application.Registry.User.Set("Software/XPscript/Surface", "Binary", binaryValue, "Binary")
    Call Application.Registry.User.Set("Software/XPscript/Surface", "DWord", 123, "DWord")
    Call Application.Registry.User.Set("Software/XPscript/Surface", "MultiString", multiValue, "MultiString")
    Call Application.Registry.User.Set("Software/XPscript/Surface", "QWord", 123456789, "QWord")
    value = Application.Registry.System.Get("Software/XPscript/Surface", "Text")

    Call Application.Secrets.Set("XPscriptSurface", "test-account", "secret-value")
    value = Application.Secrets.Get("XPscriptSurface", "test-account")
End Sub

Sub Main()
    Dim path As String
    Dim name As String
    Dim value As Variant

    path = "Software/XPscript/ApplicationRegistryTest"
    name = "RoundTrip"
    Call Application.Registry.User.Set(path, name, "XPscript-registry-ok")
    value = Application.Registry.User.Get(path, name)
    Print "REGISTRY=" & CStr(value)
End Sub
