Sub Main()
    Dim form As New UIForm("Android Card Panel API")
    Dim card = form.AddCard("summary", "Summary")
    Dim panel = form.AddPanel("details", "Details")
    Call Application.Debug.Info("ANDROID-CARD-PANEL=" & card.Name & "/" & panel.Name)
    Print "ANDROID-CARD-PANEL-API=ready"
End Sub
